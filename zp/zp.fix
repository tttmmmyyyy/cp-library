// 素数`p`を法とする整数の環の型`ZP p`を与えるモジュール。
//
// 法`p`は静的でなければなりません（コンパイル時に決まる必要があります）。
// 
// 制約：p < 2^31。`inv`、`/`、`fft`、`primitive_root`は、pが素数であることを要します。それ以外は、pが素数でなくても動きます。
// 法が実行時に動的に変わる場合は、`CPLib.Arithmetic`の`add_mod`・`sub_mod`・`mul_mod`・`pow_mod`・`inv_mod`を使ってください。
// 
// 法`p`は型パラメータとして与えます。例として、p = 17 としたい場合は、
// 
// - 空の型（フィールドを持たないunboxedな型）`P17`を作ります：`type P17 = unbox struct {}`
// - `P17 : PrimeProvider`を実装し、`PrimeProvider::value`関数で17を返すようにします：`value = |_| 17_U32;`
//
// すると`ZP P17`が環"Z/(17)"を表す型になります。
//
// いくつかの有名な素数nに対する`PrimeProvider`の型`Pn`は、このモジュールに定義されています。
// 
// 使用例：
// ```fix
// # module DocTest;
// import CPLib.ZP;
//
// type P17 = unbox struct {};
//
// impl P17 : PrimeProvider {
//     create = P17 {};
//     value = |_| 17_U32;
// }
//
// main : IO () = (
//     let x = zp(-5) : ZP P17;
//     let y = x * x;
//     assert_eq(|_|"", y.@value, 8_U32) // (-5)*(-5) = 25 = 8 mod 17
// );
// ```
module CPLib.ZP;

import CPLib.Arithmetic::{calc_primitive_root, power};
import Std::{
    loop, undefined, Add, Array, Div, Eq, I64, Mul, Neg, One, Sub, ToString, U32, U64, Zero, 
    Array::{
        @, @size, fill, push_back, reserve, set, unsafe_get_bounds_unchecked, unsafe_set_bounds_unchecked, 
        unsafe_swap_bounds_unchecked
    }, 
    Functor::map, I64::{bit_and, bit_not, bit_xor, count_trailing_zeros, shift_left, shift_right}, 
    Iterator::{fold, range}, LoopState::{break, continue}, One::one, ToI64::i64, ToString::to_string, 
    ToU32::u32, ToU64::u64, U64::{bit_or, shift_right}
};

// 素数`p`を法とする整数の環
type ZP p = struct {
    // 0 <= _value < p を保つ
    _value : U32,
    _prime : p
};

namespace ZP {
    // `x`を[0, p)の整数として返す
    //
    // # Parameters
    // - `x` : `ZP p`型の整数
    @value : ZP p -> U32;
    @value = |x| x.@_value;

    // `x`の法`p`を与える`PrimeProvider`の値を返す
    //
    // # Parameters
    // - `x` : `ZP p`型の整数
    @prime : ZP p -> p;
    @prime = |x| x.@_prime;
}

trait p : PrimeProvider {
    create : p;
    value : p -> U32;
}

type P1000000007 = unbox struct {};

impl P1000000007 : PrimeProvider {
    create = P1000000007 {};
    value = |p| 1000000007_U32;
}

type P1000000009 = unbox struct {};

impl P1000000009 : PrimeProvider {
    create = P1000000009 {};
    value = |p| 1000000009_U32;
}

// NTT-friendly prime (2^23 | p-1)
type P998244353 = unbox struct {};

impl P998244353 : PrimeProvider {
    create = P998244353 {};
    value = |p| 998244353_U32;
}

// NTT-friendly prime (2^24 | p-1)
type P754974721 = unbox struct {};

impl P754974721 : PrimeProvider {
    create = P754974721 {};
    value = |p| 754974721_U32;
}

// NTT-friendly prime (2^25 | p-1)
type P167772161 = unbox struct {};

impl P167772161 : PrimeProvider {
    create = P167772161 {};
    value = |p| 167772161_U32;
}

// NTT-friendly prime (2^26 | p-1)
type P469762049 = unbox struct {};

impl P469762049 : PrimeProvider {
    create = P469762049 {};
    value = |p| 469762049_U32;
}

// `I64`から`ZP p`の値を作成する
// 
// 計算量：O(1)
//
// # Parameters
// - `x` : `I64`型の整数
zp : [p : PrimeProvider] I64 -> ZP p;
zp = |x| (
    let pp = PrimeProvider::create;
    let p = pp.value;
    let x = x % p.i64;
    let x = if x < 0 { x + p.i64 } else { x };
    ZP { _value : x.u32, _prime : pp }
);

// `zp`の別名（非推奨）
make : [p : PrimeProvider] I64 -> ZP p = zp;
DEPRECATED[make, "Use `CPLib.ZP::zp` instead."];

// `ZP p`の逆元を求める。
// 
// 0を与えた場合はプログラムを終了する。
//
// 計算量：O(log p)
//
// # Parameters
// - `x` : `ZP p`型の整数
inv : [p : PrimeProvider] ZP p -> ZP p;
inv = |x| (
    let p = x.@_prime.value;
    if x.@_value == 0_U32 { undefined("[CPLib.ZP::inv] division by zero") };
    x.power(p.i64 - 2) // フェルマーの小定理
);

// 法pの原始根を一つ得る
//
// 計算量：O(sqrt(p))。pがこのモジュールに定義されている素数ならO(1)
primitive_root : [p : PrimeProvider] ZP p;
primitive_root = (
    let pp = PrimeProvider::create;
    let p = pp.value;
    let r = calc_primitive_root(p.i64);
    ZP { _value : r.u32, _prime : pp }
);

impl [p : PrimeProvider] ZP p : Eq {
    eq = |this, that| (
        let p = this.@_prime.value;
        this.@_value == that.@_value
    );
}

impl [p : PrimeProvider] ZP p : Add {
    add = |this, that| (
        let p = this.@_prime.value;
        let v = this.@_value + that.@_value;
        let v = if v >= p { v - p } else { v };
        ZP { _value : v, _prime : this.@_prime }
    );
}

impl [p : PrimeProvider] ZP p : Neg {
    neg = |this| (
        let p = this.@_prime.value;
        let v = p - this.@_value;
        let v = if v >= p { v - p } else { v };
        ZP { _value : v, _prime : this.@_prime }
    );
}

impl [p : PrimeProvider] ZP p : Sub {
    sub = |this, that| (
        let p = this.@_prime.value;
        let v = this.@_value;
        let v = if v < that.@_value { v + p } else { v };
        let v = v - that.@_value;
        ZP { _value : v, _prime : this.@_prime }
    );
}

impl [p : PrimeProvider] ZP p : Mul {
    mul = |this, that| (
        let p = this.@_prime.value.u64;
        ZP { _value : ((this.@_value.u64 * that.@_value.u64) % p).u32, _prime : this.@_prime }
    );
}

impl [p : PrimeProvider] ZP p : Div {
    div = |this, that| this * that.inv;
}

impl [p : PrimeProvider] ZP p : Zero {
    zero = zp(0);
}

impl [p : PrimeProvider] ZP p : One {
    one = zp(1);
}

impl ZP p : ToString {
    to_string = |this| this.@_value.to_string;
}

// 与えられた64ビット整数と等しいかより大きい最小の2のべき乗を計算する
// 
// # Parameters
// - `x`: 64ビット整数
_calc_next_pot : U64 -> U64;
_calc_next_pot = |n| (
    if n <= 1_U64 { 1_U64 };
    let n = n - 1_U64;
    let n = n.bit_or(n.shift_right(1_U64));
    let n = n.bit_or(n.shift_right(2_U64));
    let n = n.bit_or(n.shift_right(4_U64));
    let n = n.bit_or(n.shift_right(8_U64));
    let n = n.bit_or(n.shift_right(16_U64));
    let n = n.bit_or(n.shift_right(32_U64));
    n + 1_U64
);

// 高速フーリエ変換の方向（順方向か逆方向か）を表す型
type FFTDirection = union {
    forward : (),
    inverse : (),
};

// `ZP p`型の配列に対して高速フーリエ変換を行う
//
// 入力の長さを2のべき乗に切り上げ、末尾を0で埋めてから変換する。返る配列の長さは切り上げた長さである（長さ3なら4）。順変換して逆変換すると、元の配列の末尾に0を足した、切り上げた長さの配列が返る。
//
// 制約：2^c | (p-1) かつ |x| <= 2^c なる c が存在する
//
// 計算量：O(n log n + sqrt(p))、n = |x|。pがこのモジュールに定義されている素数ならO(n log n)
//
// # Parameters
// - `dir` : FFTの方向（順方向か逆方向か）
// - `x` : `ZP p`型の配列
fft : [p : PrimeProvider] FFTDirection -> Array (ZP p) -> Array (ZP p);
fft = |dir, x| (
    // 空配列はそのまま返す
    if x.@size == 0 { x };

    // xの長さを2のべき乗にする
    let n = x.@size;
    let pot = _calc_next_pot(n.u64).i64;
    let x = x.reserve(pot);
    let x = range(n, pot).fold(x, |i, x| x.push_back(zp(0)));
    let n = pot;

    // p - 1 = 2^k * c (c: 奇数) と分解し、2^k >= n であることを確認する
    let pm1 = x.@(0).@_prime.value.i64 - 1;
    if pm1.bit_and(-pm1) < n { undefined("[CPLib.ZP::fft] the size of `x` exceeds the largest power of two dividing p - 1") };

    match dir {
        forward() => x._butterfly._bit_reverse,
        inverse() => (
            let ni = zp(n).inv;
            x._bit_reverse._butterfly_inv.map(|v| v * ni)
        )
    }
);

// 配列の要素を、添字のビットを反転した位置へ並べ替える
//
// 配列の長さは2のべき乗であること。
_bit_reverse : Array a -> Array a;
_bit_reverse = |x| (
    let n = x.@size;
    // 以下で読み書きする添字は、ループの範囲から0以上n未満に収まる
    let (_, x) = range(1, n).fold((0, x), |i, (j, x)|
        // iをビット反転したものをjに設定
        // ループによりiが1増えているので、jには「上位ビット側から1を加える」
        let bit = n.shift_right(1);
        let j = loop((bit, j), |(bit, j)|
            if j.bit_and(bit) == 0 { break $ j.bit_xor(bit) };
            let j = j.bit_xor(bit);
            let bit = bit.shift_right(1);
            continue $ (bit, j)
        );
        let x = if i < j { x.unsafe_swap_bounds_unchecked(i, j) } else { x };
        (j, x)
    );
    x
);

// `_butterfly`と`_butterfly_inv`が使う、1のべき乗根の表
//
// rank2はp - 1を割る最大の2のべき乗の指数、root(i)は1の原始2^i乗根（0 <= i <= rank2）で、root(i + 1)^2 = root(i)を満たす。
type _FFTInfo p = struct {
    // root.@(i) = root(i)
    root : Array (ZP p),
    // iroot.@(i)はroot.@(i)の逆元
    iroot : Array (ZP p),
    // 0 <= i <= rank2 - 2のとき、rate2.@(i) = root(i + 2) * (root(2) * root(3) * ... * root(i + 1))^(-1)
    rate2 : Array (ZP p),
    // irate2.@(i)はrate2.@(i)の逆元
    irate2 : Array (ZP p),
    // 0 <= i <= rank2 - 3のとき、rate3.@(i) = root(i + 3) * (root(3) * root(4) * ... * root(i + 2))^(-1)
    rate3 : Array (ZP p),
    // irate3.@(i)はrate3.@(i)の逆元
    irate3 : Array (ZP p)
};

// 法pの1のべき乗根の表
//
// 計算量：O(log p)。pがこのモジュールに定義されている素数でなければ、原始根を求めるのにO(sqrt(p))。pごとに1度だけ計算される
_fft_info : [p : PrimeProvider] _FFTInfo p;
_fft_info = (
    let g = ZP::primitive_root;
    let pm1 = g.@_prime.value.i64 - 1;
    let rank2 = pm1.count_trailing_zeros;
    let r = g.power(pm1.shift_right(rank2));
    let root = fill(rank2 + 1, r);
    let iroot = fill(rank2 + 1, r.inv);
    let (root, iroot) = range(0, rank2).fold((root, iroot), |k, (root, iroot)|
        let i = rank2 - 1 - k;
        (root.set(i, root.@(i + 1) * root.@(i + 1)), iroot.set(i, iroot.@(i + 1) * iroot.@(i + 1)))
    );
    // d段目の表：rate.@(i) = root(i + d) * (root(d) * ... * root(i + d - 1))^(-1)
    let make_rates = |d| (
        let (rate, irate, _, _) = range(0, rank2 - d + 1).fold(([], [], one, one), |i, (rate, irate, prod, iprod)|
            (
                rate.push_back(root.@(i + d) * prod),
                irate.push_back(iroot.@(i + d) * iprod),
                prod * iroot.@(i + d),
                iprod * root.@(i + d)
            )
        );
        (rate, irate)
    );
    let (rate2, irate2) = make_rates(2);
    let (rate3, irate3) = make_rates(3);
    _FFTInfo { root : root, iroot : iroot, rate2 : rate2, irate2 : irate2, rate3 : rate3, irate3 : irate3 }
);

// 数論変換を行い、結果を添字のビットを反転した順に並べて返す
//
// 配列の長さnは2のべき乗で、p - 1を割ること。
// w = root(log n)として、返る配列の位置rev(k)には、多項式a(0) + a(1) t + ... + a(n - 1) t^(n - 1)にt = w^kを代入した値が入る。
// rev(k)は、kをlog nビットで書いてビットの順を逆にした数である。
// 実装はac-libraryのbutterflyに従う。基数4の段を使い、log nが奇数のときだけ基数2の段を1つ入れる。
_butterfly : [p : PrimeProvider] Array (ZP p) -> Array (ZP p);
_butterfly = |a : Array (ZP p)| (
    let n = a.@size;
    let h = n.count_trailing_zeros;
    let info = _fft_info : _FFTInfo p;
    let (rate2, rate3) = (info.@rate2, info.@rate3);
    let pp = PrimeProvider::create : p;
    let p = pp.value.u64;
    // 以下で配列aを読み書きする添字は、ループの範囲から0以上n未満に収まる
    let load = |i, a| a.unsafe_get_bounds_unchecked(i).@_value.u64;
    let store = |i, v, a| a.unsafe_set_bounds_unchecked(i, ZP { _value : (v % p).u32, _prime : pp });
    // lenは、済ませた段の数
    loop((0, a), |(len, a)|
        if len >= h { break $ a };
        if h - len == 1 {
            // 基数2の段
            let q = 1.shift_left(h - len - 1);
            let blocks = 1.shift_left(len);
            let (a, _) = range(0, blocks).fold((a, one), |s, (a, rot)|
                let offset = s.shift_left(h - len);
                let a = range(offset, offset + q).fold(a, |i, a|
                    let l = a.unsafe_get_bounds_unchecked(i);
                    let r = a.unsafe_get_bounds_unchecked(i + q) * rot;
                    a.unsafe_set_bounds_unchecked(i, l + r).unsafe_set_bounds_unchecked(i + q, l - r)
                );
                let rot = if s + 1 != blocks { rot * rate2.@(s.bit_not.count_trailing_zeros) } else { rot };
                (a, rot)
            );
            continue $ (len + 1, a)
        };
        // 基数4の段。積をpで割らずにp^2未満の値のまま足し引きし、書き込むときにpで割る。
        // 書き込む値はどれも4p^2未満で、p < 2^31なのでU64に収まる。
        // この段はh - len >= 2のときだけ走り、h <= rank2なのでroot.@(2)がある
        let mod2 = p * p;
        let imag = info.@root.@(2).@_value.u64;
        let q = 1.shift_left(h - len - 2);
        let blocks = 1.shift_left(len);
        let (a, _) = range(0, blocks).fold((a, one), |s, (a, rot)|
            let rot2 = rot * rot;
            let rot3 = rot2 * rot;
            let (r1, r2, r3) = (rot.@_value.u64, rot2.@_value.u64, rot3.@_value.u64);
            let offset = s.shift_left(h - len);
            let a = range(offset, offset + q).fold(a, |i, a|
                let a0 = load(i, a);
                let a1 = load(i + q, a) * r1;
                let a2 = load(i + 2 * q, a) * r2;
                let a3 = load(i + 3 * q, a) * r3;
                let a1na3imag = (a1 + mod2 - a3) % p * imag;
                let na2 = mod2 - a2;
                let a = store(i, a0 + a2 + a1 + a3, a);
                let a = store(i + q, a0 + a2 + (2_U64 * mod2 - (a1 + a3)), a);
                let a = store(i + 2 * q, a0 + na2 + a1na3imag, a);
                store(i + 3 * q, a0 + na2 + (mod2 - a1na3imag), a)
            );
            let rot = if s + 1 != blocks { rot * rate3.@(s.bit_not.count_trailing_zeros) } else { rot };
            (a, rot)
        );
        continue $ (len + 2, a)
    )
);

// `_butterfly`の逆変換をn倍したものを行う
//
// 配列の長さnは2のべき乗で、p - 1を割ること。`_butterfly`の結果を与えると、元の配列の各要素をn倍したものが返る。
// 実装はac-libraryのbutterfly_invに従う。
_butterfly_inv : [p : PrimeProvider] Array (ZP p) -> Array (ZP p);
_butterfly_inv = |a : Array (ZP p)| (
    let n = a.@size;
    let h = n.count_trailing_zeros;
    let info = _fft_info : _FFTInfo p;
    let (irate2, irate3) = (info.@irate2, info.@irate3);
    let pp = PrimeProvider::create : p;
    let p = pp.value.u64;
    // 以下で配列aを読み書きする添字は、ループの範囲から0以上n未満に収まる
    let load = |i, a| a.unsafe_get_bounds_unchecked(i).@_value.u64;
    let store = |i, v, a| a.unsafe_set_bounds_unchecked(i, ZP { _value : (v % p).u32, _prime : pp });
    // lenは、まだ戻していない段の数
    loop((h, a), |(len, a)|
        if len == 0 { break $ a };
        if len == 1 {
            // 基数2の段
            let q = 1.shift_left(h - len);
            let blocks = 1.shift_left(len - 1);
            let (a, _) = range(0, blocks).fold((a, one), |s, (a, irot)|
                let offset = s.shift_left(h - len + 1);
                let ir = irot.@_value.u64;
                let a = range(offset, offset + q).fold(a, |i, a|
                    let l = load(i, a);
                    let r = load(i + q, a);
                    let a = store(i, l + r, a);
                    store(i + q, (l + p - r) * ir, a)
                );
                let irot = if s + 1 != blocks { irot * irate2.@(s.bit_not.count_trailing_zeros) } else { irot };
                (a, irot)
            );
            continue $ (len - 1, a)
        };
        // 基数4の段。掛ける前の値はどれも4p未満で、積は4p^2未満なので、p < 2^31ならU64に収まる。
        // この段はlen >= 2のときだけ走り、len <= h <= rank2なのでiroot.@(2)がある
        let iimag = info.@iroot.@(2).@_value.u64;
        let q = 1.shift_left(h - len);
        let blocks = 1.shift_left(len - 2);
        let (a, _) = range(0, blocks).fold((a, one), |s, (a, irot)|
            let irot2 = irot * irot;
            let irot3 = irot2 * irot;
            let (r1, r2, r3) = (irot.@_value.u64, irot2.@_value.u64, irot3.@_value.u64);
            let offset = s.shift_left(h - len + 2);
            let a = range(offset, offset + q).fold(a, |i, a|
                let a0 = load(i, a);
                let a1 = load(i + q, a);
                let a2 = load(i + 2 * q, a);
                let a3 = load(i + 3 * q, a);
                let a2na3iimag = (p + a2 - a3) * iimag % p;
                let a = store(i, a0 + a1 + a2 + a3, a);
                let a = store(i + q, (a0 + (p - a1) + a2na3iimag) * r1, a);
                let a = store(i + 2 * q, (a0 + a1 + (p - a2) + (p - a3)) * r2, a);
                store(i + 3 * q, (a0 + (p - a1) + (p - a2na3iimag)) * r3, a)
            );
            let irot = if s + 1 != blocks { irot * irate3.@(s.bit_not.count_trailing_zeros) } else { irot };
            (a, irot)
        );
        continue $ (len - 2, a)
    )
);
