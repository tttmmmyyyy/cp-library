// グラフの表現と基本的なアルゴリズム
//
// グラフは、`GraphBuilder`に辺を足していき、`build`で`Graph`にしてから使います。
//
// 制約・計算量の n は頂点数、m は辺数を表します。
//
// # Examples
// ```fix
// // 辺のデータをコストとして、ダイクストラ法で最短距離を求める
// let g = GraphBuilder::create(3).add_edge(0, 1, 5).add_edge(1, 2, 2).add_edge(0, 2, 10).build;
// assert_eq(|_|"", g.dijkstra(0), [0, 5, 7])
// ```
module CPLib.Graph;

import BinaryHeap::{BinaryHeap::{get_size, get_top, pop, push}, MinBinaryHeap::empty};
import CPLib.Trait::{Inf, Inf::inf};
import Std::{
    loop, undefined, Additive, Array, Eq, I64, Iterator, LessThan, Iterator::Item, 
    Array::{fill, from_map, mod, pop_back, push_back, reverse, set, to_iter, @, @size}, 
    Iterator::{fold, map, range}, LessThan::min, LoopState::{break, continue}, Option::as_some, Tuple2::@0, 
    Zero::zero
};

// 辺を足していく途中のグラフ
//
// 型パラメータ`c`は辺に付随するデータの型です（例：ダイクストラ法に使うときはコスト）。不要な場合はユニット型`()`を指定するとメモリの節約になります。
type GraphBuilder c = struct {
    // 頂点数
    _n : I64,
    // 辺ごとの始点。足した順に並ぶ
    _from : Array I64,
    // 辺ごとの終点とデータ。足した順に並ぶ
    _edges : Array (Edge c)
};

namespace GraphBuilder {
    // 頂点数が`n`で辺のない`GraphBuilder`を作成する
    // 
    // 計算量：O(1)
    //
    // # Parameters
    // - `n` : 頂点数
    create : I64 -> GraphBuilder c;
    create = |n| GraphBuilder { _n : n, _from : [], _edges : [] };

    // グラフに辺を追加する
    // 
    // 制約：0 <= from, to < n
    //
    // 計算量：ならしO(1)
    //
    // # Parameters
    // - `from` : 始点の頂点番号
    // - `to` : 終点の頂点番号
    // - `data` : 辺のデータ
    // - `builder` : 辺を足していく途中のグラフ
    add_edge : I64 -> I64 -> c -> GraphBuilder c -> GraphBuilder c;
    add_edge = |from, to, data, builder| (
        builder.mod__from(push_back(from)).mod__edges(push_back(Edge::make(to, data)))
    );

    // 辺を足し終えたグラフを作る
    //
    // 計算量：O(n + m)
    //
    // # Parameters
    // - `builder` : 辺を足していく途中のグラフ
    build : GraphBuilder c -> Graph c;
    build = |builder| (
        let n = builder.@_n;
        let from = builder.@_from;
        let m = from.@size;
        // 始点ごとに辺の数を数え、累積和を取る
        let start = from.to_iter.fold(fill(n + 1, 0), |v, start|
            if !(0 <= v && v < n) { undefined("CPLib.Graph::GraphBuilder::build found an edge whose vertex is out of range") };
            start.mod(v + 1, |d| d + 1)
        );
        let start = range(0, n).fold(start, |v, start| start.set(v + 1, start.@(v) + start.@(v + 1)));
        // 辺を足した順に見て、始点の区間に並べる。perm.@(p)は位置pに置く辺の、足した順の番号。nextは各頂点の区間で次に置く位置
        let (perm, _) = range(0, m).fold((fill(m, 0), start), |i, (perm, next)|
            let v = from.@(i);
            let p = next.@(v);
            (perm.set(p, i), next.set(v, p + 1))
        );
        let edges = builder.@_edges;
        Graph { _start : start, _edges : from_map(m, |p|
            let e = edges.@(perm.@(p));
            if !(0 <= e.@to && e.@to < n) { undefined("CPLib.Graph::GraphBuilder::build found an edge whose vertex is out of range") };
            e
        ) }
    );
}

// 辺を足し終えたグラフ
//
// `GraphBuilder::build`で作ります。型パラメータ`c`は辺に付随するデータの型です。
type Graph c = struct {
    // 長さが頂点数 + 1の配列。頂点vから出る辺の位置は[_start.@(v), _start.@(v + 1))
    _start : Array I64,
    // 辺を始点の順に並べた配列。同じ始点の辺は足した順に並ぶ
    _edges : Array (Edge c)
};

// グラフの辺を表す型（始点番号はなし）
type Edge c = struct {
    // 終点の頂点番号
    to : I64,
    // 辺のデータ
    data : c
};

namespace Edge {
    // 辺を作成する
    make : I64 -> c -> Edge c;
    make = |to, data| Edge { to : to, data : data };
}

// グラフの頂点数を取得する
//
// 計算量：O(1)
//
// # Parameters
// - `graph` : グラフ
@size : Graph c -> I64;
@size = |g| g.@_start.@size - 1;

// `@size`の別名（非推奨）
get_size : Graph c -> I64 = @size;
DEPRECATED[get_size, "Use `CPLib.Graph::@size` instead."];

// 頂点`v`から出る辺の本数を取得する
//
// 制約：0 <= v < n
//
// 計算量：O(1)
//
// # Parameters
// - `v` : 始点の頂点番号
// - `graph` : グラフ
get_out_degree : I64 -> Graph c -> I64;
get_out_degree = |v, graph| graph.@_start.@(v + 1) - graph.@_start.@(v);

// 頂点`v`から出る辺を、足した順に返すイテレータを作る
//
// 制約：0 <= v < n
//
// 計算量：O(1)
//
// # Parameters
// - `v` : 始点の頂点番号
// - `graph` : グラフ
to_iter_edges : [?it : Iterator, Item ?it = Edge c] I64 -> Graph c -> ?it;
to_iter_edges = |v, graph| (
    let edges = graph.@_edges;
    range(graph.@_start.@(v), graph.@_start.@(v + 1)).map(|p| edges.@(p))
);

// ノードとその距離を表す型（ダイクストラ法などで使用）
type _NodeDistance c = struct {
    node : I64,
    dist : c
};

namespace _NodeDistance {
    make : I64 -> c -> _NodeDistance c;
    make = |node, dist| _NodeDistance { node: node, dist: dist };
}

impl [c : LessThan] _NodeDistance c : LessThan {
    less_than = |x, y| x.@dist < y.@dist;
}

// ダイクストラ法：グラフと開始ノードが与えられたとき、開始ノードから各ノードに到達するまでの最小コストの配列を返す。
// 
// 到達できないノードまでの距離には`Inf::inf`が設定されます。
// 
// 制約：0 <= start < n, 辺のコスト >= 0
//
// 計算量：O((n + m) log m)
//
// # Parameters
// - `start` : 開始ノードの番号
// - `graph` : グラフ
dijkstra : [c : Additive, c : LessThan, c : Inf] I64 -> Graph c -> Array c;
dijkstra = |start, graph| (
    // The number of nodes in the graph.
    let nn = graph.@size;

    // The array of distances to reach each node from the starting node.
    let dists = fill(nn, inf);
    let dists = dists.set(start, zero);

    // The binary heap to store the nodes to visit.
    let visit_list = MinBinaryHeap::empty.push(_NodeDistance::make(start, zero));

    // The main loop.
    loop((dists, visit_list), |(dists, visit_list)| (
        // If there is no node to visit, break the loop.
        if visit_list.get_size == 0 { break $ dists };

        // Get the node with the smallest distance.
        let _NodeDistance { node : node, dist : dist } = visit_list.get_top.as_some;
        let visit_list = visit_list.pop;
        if dists.@(node) < dist {
            // The node is already visited.
            continue $ (dists, visit_list)
        };
        // `dists.@(node) == dist` holds.

        // See all the neighbors of the node.
        continue $ graph.to_iter_edges(node).fold((dists, visit_list), |Edge { to : to, data : cost }, (dists, visit_list)|
            // If the path using the current edge is not better than the previous one, skip.
            let new_dist = dist + cost;
            if !(new_dist < dists.@(to)) { (dists, visit_list) };

            // Update the distance to the node.
            let dists = dists.set(to, new_dist);
            let visit_list = visit_list.push(_NodeDistance::make(to, new_dist));

            (dists, visit_list)
        )
    ))
);

// ベルマンフォード法：グラフと開始ノードが与えられたとき、開始ノードから各ノードに到達するまでの最小コストの配列を返す。
// 
// 到達できないノードまでの距離には`Inf::inf`が設定されます。
// 
// 制約：0 <= start < n, 開始ノードから到達できる負の閉路がない
//
// 計算量：O(n (n + m))
//
// # Parameters
// - `start` : 開始ノードの番号
// - `graph` : グラフ
bellman_ford : [c : Additive, c : LessThan, c : Inf, c : Eq] I64 -> Graph c -> Array c;
bellman_ford = |start, graph| (
    let n = graph.@size;
    let d = fill(n, inf);
    let d = d.set(start, zero);
    loop(d, |d|
        let (d, update) = range(0, n).fold((d, false), |i, (d, update)|
            let dist = d.@(i);
            if dist == inf { (d, update) }; // 到達できないノード
            graph.to_iter_edges(i).fold((d, update), |Edge { to : to, data : cost }, (d, update)|
                let new_dist = dist + cost;
                if !(new_dist < d.@(to)) { (d, update) };
                (d.set(to, new_dist), true)
            )
        );
        if !update { break $ d };
        continue $ d
    )
);

// グラフの強連結成分分解を求める
//
// 戻り値は、各強連結成分を構成する頂点のリストの配列です。
// また、戻り値はトポロジカルソートされています：uとvが異なる強連結成分cu, cvに属するとき、uからvに到達できるなら、cuはcvの前に現れます。
//
// 計算量：O(n + m)
//
// # Parameters
// - `g` : グラフ
calc_sccs : Graph c -> Array (Array I64);
calc_sccs = |g| (
    // Tarjanの方法。強連結成分は、トポロジカル順の逆に確定する
    let n = g.@size;
    let (_, _, _, _, _, sccs) = range(0, n).fold((0, [], fill(n, -1), fill(n, 0), [], []), |root, (cnt, stack, ord, low, path, sccs)|
        if ord.@(root) != -1 { (cnt, stack, ord, low, path, sccs) };
        _scc_dfs(g, root, cnt, stack, ord, low, path, sccs)
    );
    sccs.reverse
);

// `root`から深さ優先探索をし、確定した強連結成分を`sccs`の末尾に加える
//
// 再帰の代わりに、(頂点, 次に調べる辺の`_edges`での位置)を積む配列`stack`をスタックとして使う。`stack`は空で渡し、空で返る。
// 呼び出しごとに確保し直さないよう、呼び出し側が使い回す。
//
// # Parameters
// - `g` : グラフ
// - `root` : 探索を始める頂点
// - `cnt` : これまでに訪れた頂点の数
// - `stack` : 探索に使う空の配列
// - `ord` : 頂点を訪れた順番。訪れていない頂点は-1、強連結成分が確定した頂点は頂点数n
// - `low` : 頂点から、探索木の辺を下り、そのあと他の辺を1本たどって行ける、成分が確定していない頂点の`ord`の最小値
// - `path` : 訪れたが強連結成分が確定していない頂点を、訪れた順に並べた配列
// - `sccs` : 確定した強連結成分の配列
_scc_dfs : Graph c -> I64 -> I64 -> Array (I64, I64) -> Array I64 -> Array I64 -> Array I64 -> Array (Array I64)
    -> (I64, Array (I64, I64), Array I64, Array I64, Array I64, Array (Array I64));
_scc_dfs = |g, root, cnt, stack, ord, low, path, sccs| (
    let n = g.@size;
    let start = g.@_start;
    let edges = g.@_edges;
    let init = (cnt + 1, stack.push_back((root, start.@(root))), ord.set(root, cnt), low.set(root, cnt), path.push_back(root), sccs);
    loop(init, |(cnt, stack, ord, low, path, sccs)|
        if stack.@size == 0 { break $ (cnt, stack, ord, low, path, sccs) };
        let top = stack.@size - 1;
        let (v, k) = stack.@(top);
        if k < start.@(v + 1) {
            let stack = stack.set(top, (v, k + 1));
            let to = edges.@(k).@to;
            let o = ord.@(to);
            if o == -1 {
                continue $ (cnt + 1, stack.push_back((to, start.@(to))), ord.set(to, cnt), low.set(to, cnt), path.push_back(to), sccs)
            };
            // 成分が確定した頂点の`ord`は頂点数nで、まだ確定していない頂点の`ord`より大きいので、`low`は変わらない
            continue $ (cnt, stack, ord, low.set(v, min(low.@(v), o)), path, sccs)
        };
        // vから出る辺をすべて調べた。親の`low`に反映する
        let stack = stack.pop_back;
        let low_v = low.@(v);
        let low = if stack.@size == 0 { low } else {
            let parent = stack.@(stack.@size - 1).@0;
            low.set(parent, min(low.@(parent), low_v))
        };
        if low_v != ord.@(v) { continue $ (cnt, stack, ord, low, path, sccs) };
        // vから先に訪れた、成分が確定していない頂点が、vを含む強連結成分になる
        let (ord, path, scc) = loop((ord, path, []), |(ord, path, scc)|
            let u = path.@(path.@size - 1);
            let ord = ord.set(u, n);
            let path = path.pop_back;
            let scc = scc.push_back(u);
            if u == v { break $ (ord, path, scc) };
            continue $ (ord, path, scc)
        );
        continue $ (cnt, stack, ord, low, path, sccs.push_back(scc))
    )
);
