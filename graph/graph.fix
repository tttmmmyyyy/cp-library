// グラフの表現と基本的なアルゴリズム
//
// グラフは、`GraphBuilder`に辺を足していき、`build`で`Graph`にしてから使います。
//
// 制約・計算量の n は頂点数、m は辺数を表します。
//
// # Examples
// ```fix
// // 辺のデータをコストとして、ダイクストラ法で最短距離を求める
// let g = GraphBuilder::create(3).add_edge(0, 1, 5).add_edge(1, 2, 2).add_edge(0, 2, 10).build;
// assert_eq(|_|"", g.dijkstra(0), [0, 5, 7])
// ```
module CPLib.Graph;

import BinaryHeap::{BinaryHeap::{get_size, get_top, pop, push}, MinBinaryHeap::empty};
import CPLib.Trait::{Inf, Inf::inf};
import Std::{
    loop, undefined, Additive, Array, Eq, I32, I64, Iterator, LessThan, U64, Iterator::Item, 
    Array::{empty, fill, from_map, mod, pop_back, push_back, set, to_iter, @, @size}, 
    Functor::map, I32::maximum, Iterator::{fold, map, range}, LessThan::{max, min}, LoopState::{break, continue}, Option::as_some, 
    ToI32::i32, ToI64::i64, ToU64::u64, Tuple2::{@0, @1}, Zero::zero
};

// 辺を足していく途中のグラフ
//
// 型パラメータ`c`は辺に付随するデータの型です（例：ダイクストラ法に使うときはコスト）。不要な場合はユニット型`()`を指定するとメモリの節約になります。
type GraphBuilder c = struct {
    // 頂点数
    _n : I64,
    // 辺ごとの(始点, 終点)。足した順に並ぶ
    //
    // 始点と終点を1本の配列にまとめるのは、`add_edge`が更新するフィールドを減らし、`add_edge`を呼び出し元にインライン展開される大きさに収めるため
    _ends : Array (I32, I32),
    // 辺ごとのデータ。足した順に並ぶ
    _data : Array c,
    // これまでに足した辺の始点と終点の最大値。`U64`として比べるので、負の頂点番号はどの範囲内の番号より大きい
    //
    // `build`がこれで範囲外の頂点番号を見つける。`add_edge`が範囲を確かめて止めると、`add_edge`が呼び出し元にインライン展開されなくなる
    _max_vertex : U64
};

namespace GraphBuilder {
    // 頂点数が`n`で辺のない`GraphBuilder`を作成する
    // 
    // 制約：0 <= n < 2^31
    //
    // 計算量：O(1)
    //
    // # Parameters
    // - `n` : 頂点数
    create : I64 -> GraphBuilder c;
    create = |n| (
        if n > I32::maximum.i64 { undefined("[CPLib.Graph::GraphBuilder::create] got 2^31 or more vertices") };
        GraphBuilder { _n : n, _ends : [], _data : [], _max_vertex : 0_U64 }
    );

    // グラフに辺を追加する
    // 
    // 制約：0 <= from, to < n
    //
    // 計算量：ならしO(1)
    //
    // # Parameters
    // - `from` : 始点の頂点番号
    // - `to` : 終点の頂点番号
    // - `data` : 辺のデータ
    // - `builder` : 辺を足していく途中のグラフ
    add_edge : I64 -> I64 -> c -> GraphBuilder c -> GraphBuilder c;
    add_edge = |from, to, data, builder| (
        builder.mod__ends(push_back((from.i32, to.i32))).mod__data(push_back(data))
            .mod__max_vertex(|x| max(x, max(from.u64, to.u64)))
    );

    // 辺を足し終えたグラフを作る
    //
    // 制約：m < 2^31
    //
    // 計算量：O(n + m)
    //
    // # Parameters
    // - `builder` : 辺を足していく途中のグラフ
    build : GraphBuilder c -> Graph c;
    build = |builder| (
        let n = builder.@_n;
        let ends = builder.@_ends;
        let m = ends.@size;
        if m > 0 && builder.@_max_vertex >= n.u64 { undefined("[CPLib.Graph::GraphBuilder::build] found an edge whose vertex is out of range") };
        if m > I32::maximum.i64 { undefined("[CPLib.Graph::GraphBuilder::build] got 2^31 or more edges") };
        // 始点ごとに辺の数を数え、累積和を取る
        let start = ends.to_iter.fold(fill(n + 1, 0_I32), |(v, _), start| start.mod(v.i64 + 1, |d| d + 1_I32));
        let start = range(0, n).fold(start, |v, start| start.set(v + 1, start.@(v) + start.@(v + 1)));
        // 辺を足した順に見て、始点の区間に並べる。perm.@(p)は位置pに置く辺の、足した順の番号。nextは各頂点の区間で次に置く位置
        let (perm, _) = range(0, m).fold((fill(m, 0_I32), start), |i, (perm, next)|
            let v = ends.@(i).@0.i64;
            let p = next.@(v);
            (perm.set(p.i64, i.i32), next.set(v, p + 1_I32))
        );
        let data = builder.@_data;
        Graph {
            _start : start,
            _to : from_map(m, |p| ends.@(perm.@(p).i64).@1),
            _data : from_map(m, |p| data.@(perm.@(p).i64))
        }
    );
}

// 辺を足し終えたグラフ
//
// `GraphBuilder::build`で作ります。型パラメータ`c`は辺に付随するデータの型です。
type Graph c = struct {
    // 長さが頂点数 + 1の配列。頂点vから出る辺の位置は[_start.@(v), _start.@(v + 1))
    //
    // 頂点番号と辺の位置は、配列をキャッシュに収めやすいよう4バイトで持つ
    _start : Array I32,
    // 辺の終点を始点の順に並べた配列。同じ始点の辺は足した順に並ぶ
    _to : Array I32,
    // 辺のデータを、`_to`と同じ順に並べた配列
    _data : Array c
};

// グラフの辺を表す型（始点番号はなし）
type Edge c = struct {
    // 終点の頂点番号
    to : I64,
    // 辺のデータ
    data : c
};

namespace Edge {
    // 辺を作成する
    make : I64 -> c -> Edge c;
    make = |to, data| Edge { to : to, data : data };
}

// グラフの頂点数を取得する
//
// 計算量：O(1)
//
// # Parameters
// - `graph` : グラフ
@size : Graph c -> I64;
@size = |g| g.@_start.@size - 1;

// `@size`の別名（非推奨）
get_size : Graph c -> I64 = @size;
DEPRECATED[get_size, "Use `CPLib.Graph::@size` instead."];

// 頂点`v`から出る辺の本数を取得する
//
// 制約：0 <= v < n
//
// 計算量：O(1)
//
// # Parameters
// - `v` : 始点の頂点番号
// - `graph` : グラフ
get_out_degree : I64 -> Graph c -> I64;
get_out_degree = |v, graph| (graph.@_start.@(v + 1) - graph.@_start.@(v)).i64;

// 頂点`v`から出る辺を、足した順に返すイテレータを作る
//
// 制約：0 <= v < n
//
// 計算量：O(1)
//
// # Parameters
// - `v` : 始点の頂点番号
// - `graph` : グラフ
to_iter_edges : [?it : Iterator, Item ?it = Edge c] I64 -> Graph c -> ?it;
to_iter_edges = |v, graph| (
    let to = graph.@_to;
    let data = graph.@_data;
    range(graph.@_start.@(v).i64, graph.@_start.@(v + 1).i64).map(|p| Edge::make(to.@(p).i64, data.@(p)))
);

// ノードとその距離を表す型（ダイクストラ法などで使用）
type _NodeDistance c = struct {
    node : I64,
    dist : c
};

namespace _NodeDistance {
    make : I64 -> c -> _NodeDistance c;
    make = |node, dist| _NodeDistance { node: node, dist: dist };
}

impl [c : LessThan] _NodeDistance c : LessThan {
    less_than = |x, y| x.@dist < y.@dist;
}

// ダイクストラ法：グラフと開始ノードが与えられたとき、開始ノードから各ノードに到達するまでの最小コストの配列を返す。
// 
// 到達できないノードまでの距離には`Inf::inf`が設定されます。
// 
// 制約：0 <= start < n, 辺のコスト >= 0
//
// 計算量：O((n + m) log m)
//
// # Parameters
// - `start` : 開始ノードの番号
// - `graph` : グラフ
dijkstra : [c : Additive, c : LessThan, c : Inf] I64 -> Graph c -> Array c;
dijkstra = |start, graph| (
    // The number of nodes in the graph.
    let nn = graph.@size;

    // The array of distances to reach each node from the starting node.
    let dists = fill(nn, inf);
    let dists = dists.set(start, zero);

    // The binary heap to store the nodes to visit.
    let visit_list = MinBinaryHeap::empty.push(_NodeDistance::make(start, zero));

    // The main loop.
    loop((dists, visit_list), |(dists, visit_list)| (
        // If there is no node to visit, break the loop.
        if visit_list.get_size == 0 { break $ dists };

        // Get the node with the smallest distance.
        let _NodeDistance { node : node, dist : dist } = visit_list.get_top.as_some;
        let visit_list = visit_list.pop;
        if dists.@(node) < dist {
            // The node is already visited.
            continue $ (dists, visit_list)
        };
        // `dists.@(node) == dist` holds.

        // See all the neighbors of the node.
        continue $ graph.to_iter_edges(node).fold((dists, visit_list), |Edge { to : to, data : cost }, (dists, visit_list)|
            // If the path using the current edge is not better than the previous one, skip.
            let new_dist = dist + cost;
            if !(new_dist < dists.@(to)) { (dists, visit_list) };

            // Update the distance to the node.
            let dists = dists.set(to, new_dist);
            let visit_list = visit_list.push(_NodeDistance::make(to, new_dist));

            (dists, visit_list)
        )
    ))
);

// ベルマンフォード法：グラフと開始ノードが与えられたとき、開始ノードから各ノードに到達するまでの最小コストの配列を返す。
// 
// 到達できないノードまでの距離には`Inf::inf`が設定されます。
// 
// 制約：0 <= start < n, 開始ノードから到達できる負の閉路がない
//
// 計算量：O(n (n + m))
//
// # Parameters
// - `start` : 開始ノードの番号
// - `graph` : グラフ
bellman_ford : [c : Additive, c : LessThan, c : Inf, c : Eq] I64 -> Graph c -> Array c;
bellman_ford = |start, graph| (
    let n = graph.@size;
    let d = fill(n, inf);
    let d = d.set(start, zero);
    // 負の閉路がなければ、最短路は高々n - 1本の辺からなるので、n巡目の緩和では距離が変わらない。
    loop((d, 1), |(d, round)|
        let (d, update) = range(0, n).fold((d, false), |i, (d, update)|
            let dist = d.@(i);
            if dist == inf { (d, update) }; // 到達できないノード
            graph.to_iter_edges(i).fold((d, update), |Edge { to : to, data : cost }, (d, update)|
                let new_dist = dist + cost;
                if !(new_dist < d.@(to)) { (d, update) };
                (d.set(to, new_dist), true)
            )
        );
        if !update { break $ d };
        if round >= n { undefined("[CPLib.Graph::bellman_ford] a negative cycle is reachable from `start`") };
        continue $ (d, round + 1)
    )
);

// グラフの強連結成分分解を求める
//
// 戻り値は、各強連結成分を構成する頂点のリストの配列です。
// また、戻り値はトポロジカルソートされています：uとvが異なる強連結成分cu, cvに属するとき、uからvに到達できるなら、cuはcvの前に現れます。
//
// 計算量：O(n + m)
//
// # Parameters
// - `g` : グラフ
calc_sccs : Graph c -> Array (Array I64);
calc_sccs = |g| (
    let (num, ids) = g._calc_scc_ids;
    let sizes = ids.to_iter.fold(fill(num, 0), |id, sizes| sizes.mod(id.i64, |c| c + 1));
    let sccs = sizes.map(|size| empty(size));
    range(0, g.@size).fold(sccs, |v, sccs| sccs.mod(ids.@(v).i64, push_back(v)))
);

// 頂点ごとに、その頂点を含む強連結成分の番号を求める
//
// 戻り値は、強連結成分の数`num`と、長さが頂点数の配列`ids`の組。
// 番号は0以上`num`未満で、トポロジカル順に振られる：uとvが異なる強連結成分に属するとき、uからvに到達できるなら、`ids.@(u) < ids.@(v)`。
// 番号`c`の強連結成分は、`calc_sccs`の戻り値の`c`番目の要素である。
//
// 計算量：O(n + m)
//
// # Parameters
// - `g` : グラフ
//
// # Examples
// ```fix
// // 0 -> 1 -> 2 -> 1、2 -> 3。{1, 2}が1つの強連結成分になる
// let g = GraphBuilder::create(4).add_edge(0, 1, ()).add_edge(1, 2, ()).add_edge(2, 1, ()).add_edge(2, 3, ()).build;
// assert_eq(|_|"", g.calc_scc_ids, (3, [0, 1, 1, 2]))
// ```
calc_scc_ids : Graph c -> (I64, Array I64);
calc_scc_ids = |g| (
    let (num, ids) = g._calc_scc_ids;
    (num, ids.map(i64))
);

// `calc_scc_ids`と同じ番号を、要素が4バイトの配列で返す
//
// 頂点の数が多いとき、配列がL3キャッシュに収まりやすい。`calc_sccs`と`CPLib.TwoSat`が使う。
_calc_scc_ids : Graph c -> (I64, Array I32);
_calc_scc_ids = |g| (
    // Tarjanの方法。強連結成分は、トポロジカル順の逆に確定する
    let n = g.@size;
    let (_, num, _, _, _, _, ids) = range(0, n).fold((0, 0, [], fill(n, -1_I32), fill(n, 0_I32), [], fill(n, 0_I32)), |root, (cnt, num, stack, ord, low, path, ids)|
        if ord.@(root) != -1_I32 { (cnt, num, stack, ord, low, path, ids) };
        _scc_dfs(g, root, cnt, num, stack, ord, low, path, ids)
    );
    // 確定した順の番号を、トポロジカル順の番号に直す
    (num, ids.map(|id| (num - 1).i32 - id))
);

// `root`から深さ優先探索をし、確定した強連結成分に、確定した順の番号を振る
//
// 再帰の代わりに、(頂点, 次に調べる辺の`_to`での位置)を積む配列`stack`をスタックとして使う。`stack`は空で渡し、空で返る。
// 呼び出しごとに確保し直さないよう、呼び出し側が使い回す。
//
// # Parameters
// - `g` : グラフ
// - `root` : 探索を始める頂点
// - `cnt` : これまでに訪れた頂点の数
// - `num` : これまでに確定した強連結成分の数
// - `stack` : 探索に使う空の配列
// - `ord` : 頂点を訪れた順番。訪れていない頂点は-1、強連結成分が確定した頂点は頂点数n
// - `low` : 頂点から、探索木の辺を下り、そのあと他の辺を1本たどって行ける、成分が確定していない頂点の`ord`の最小値
// - `path` : 訪れたが強連結成分が確定していない頂点を、訪れた順に並べた配列
// - `ids` : 強連結成分が確定した頂点の、確定した順の成分の番号
_scc_dfs : Graph c -> I64 -> I64 -> I64 -> Array (I32, I32) -> Array I32 -> Array I32 -> Array I32 -> Array I32
    -> (I64, I64, Array (I32, I32), Array I32, Array I32, Array I32, Array I32);
_scc_dfs = |g, root, cnt, num, stack, ord, low, path, ids| (
    let n = g.@size;
    let start = g.@_start;
    let to_of = g.@_to;
    let init = (cnt + 1, num, stack.push_back((root.i32, start.@(root))), ord.set(root, cnt.i32), low.set(root, cnt.i32), path.push_back(root.i32), ids);
    loop(init, |(cnt, num, stack, ord, low, path, ids)|
        if stack.@size == 0 { break $ (cnt, num, stack, ord, low, path, ids) };
        let top = stack.@size - 1;
        let (v, k) = stack.@(top);
        let v = v.i64;
        if k < start.@(v + 1) {
            let stack = stack.set(top, (v.i32, k + 1_I32));
            let to = to_of.@(k.i64).i64;
            let o = ord.@(to);
            if o == -1_I32 {
                continue $ (cnt + 1, num, stack.push_back((to.i32, start.@(to))), ord.set(to, cnt.i32), low.set(to, cnt.i32), path.push_back(to.i32), ids)
            };
            // 成分が確定した頂点の`ord`は頂点数nで、まだ確定していない頂点の`ord`より大きいので、`low`は変わらない
            continue $ (cnt, num, stack, ord, low.set(v, min(low.@(v), o)), path, ids)
        };
        // vから出る辺をすべて調べた。親の`low`に反映する
        let stack = stack.pop_back;
        let low_v = low.@(v);
        let low = if stack.@size == 0 { low } else {
            let parent = stack.@(stack.@size - 1).@0.i64;
            low.set(parent, min(low.@(parent), low_v))
        };
        if low_v != ord.@(v) { continue $ (cnt, num, stack, ord, low, path, ids) };
        // vから先に訪れた、成分が確定していない頂点が、vを含む強連結成分になる
        let (ord, path, ids) = loop((ord, path, ids), |(ord, path, ids)|
            let u = path.@(path.@size - 1).i64;
            let ord = ord.set(u, n.i32);
            let path = path.pop_back;
            let ids = ids.set(u, num.i32);
            if u == v { break $ (ord, path, ids) };
            continue $ (ord, path, ids)
        );
        continue $ (cnt, num + 1, stack, ord, low, path, ids)
    )
);
