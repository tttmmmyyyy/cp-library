// グラフの表現と基本的なアルゴリズム
//
// 制約・計算量の n は頂点数、m は辺数を表します。
//
// # Examples
// ```fix
// // 辺のデータをコストとして、ダイクストラ法で最短距離を求める
// let g = create(3).add_edge(0, 1, 5).add_edge(1, 2, 2).add_edge(0, 2, 10);
// assert_eq(|_|"", g.dijkstra(0), [0, 5, 7])
// ```
module CPLib.Graph;

import BinaryHeap::{BinaryHeap::{get_size, get_top, pop, push}, MinBinaryHeap::empty};
import CPLib.Trait::{Inf, Inf::inf};
import Std::{
    loop, Additive, Array, Bool, Eq, I64, LessThan, 
    Array::{empty, fill, mod, pop_back, push_back, set, to_iter, @, @size}, 
    Iterator::{fold, loop_iter, range, range_step}, LoopState::{break, continue}, Option::as_some, 
    Zero::zero
};

// グラフの隣接リストによる表現
// 
// 型パラメータ`c`は辺に付随するデータの型です（例：ダイクストラ法に使うときはコスト）。不要な場合はユニット型`()`や自分で作ったempty typeなどを指定するとメモリの節約になります。
type Graph c = struct {
    // `edges.@(s)` は頂点`s`から出る辺のリストです。
    edges : Array (Array (Edge c))
};

// グラフの辺を表す型（始点番号はなし）
type Edge c = struct {
    // 終点の頂点番号
    to : I64,
    // 辺のデータ
    data : c
};

// 辺の識別子の型
type EdgeId = unbox struct { 
    // 始点インデックス
    from : I64, 
    // 辺インデックス
    idx : I64
};

namespace Edge {
    // 辺を作成する
    make : I64 -> c -> Edge c;
    make = |to, data| Edge { to : to, data : data };
}

// 辺のないグラフを作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `n` : 頂点数
create : I64 -> Graph c;
create = |n| (
    Graph { edges : fill(n, []) }
);

// グラフの頂点数を取得する
//
// 計算量：O(1)
//
// # Parameters
// - `g` : グラフ
get_size : Graph c -> I64;
get_size = |g| g.@edges.@size;

// グラフに辺を追加する
// 
// 制約：0 <= from, to < n
//
// 計算量：ならしO(1)
//
// # Parameters
// - `from` : 始点の頂点番号
// - `to` : 終点の頂点番号
// - `data` : 辺のデータ
// - `graph` : グラフ
add_edge : I64 -> I64 -> c -> Graph c -> Graph c;
add_edge = |from, to, data, graph| (
    graph.mod_edges(mod(from, push_back(Edge::make(to, data))))
);

// グラフに辺を追加する（辺IDを返す）
// 
// 制約：0 <= from, to < n
//
// 計算量：ならしO(1)
//
// # Parameters
// - `from` : 始点の頂点番号
// - `to` : 終点の頂点番号
// - `data` : 辺のデータ
// - `graph` : グラフ
add_edge_id : I64 -> I64 -> c -> Graph c -> (Graph c, EdgeId);
add_edge_id = |from, to, data, graph| (
    let graph = graph.add_edge(from, to, data);
    (graph, EdgeId { from: from, idx: graph.@edges.@(from).@size - 1 })
);

// 辺を取得する
// 
// 計算量：O(1)
//
// # Parameters
// - `edge_id` : 辺の識別子
// - `graph` : グラフ
get_edge : EdgeId -> Graph c -> Edge c;
get_edge = |eid, graph| graph.@edges.@(eid.@from).@(eid.@idx);

// ノードとその距離を表す型（ダイクストラ法などで使用）
type NodeDistance c = struct {
    node : I64,
    dist : c
};

namespace NodeDistance {
    make : I64 -> c -> NodeDistance c;
    make = |node, dist| NodeDistance { node: node, dist: dist };
}

impl [c : LessThan] NodeDistance c : LessThan {
    less_than = |x, y| x.@dist < y.@dist;
}

// ダイクストラ法：グラフと開始ノードが与えられたとき、開始ノードから各ノードに到達するまでの最小コストの配列を返す。
// 
// 到達できないノードまでの距離には`Inf::inf`が設定されます。
// 
// 制約：0 <= start < n, 辺のコスト >= 0
//
// 計算量：O((n + m) log m)
//
// # Parameters
// - `start` : 開始ノードの番号
// - `graph` : グラフ
dijkstra : [c : Additive, c : LessThan, c : Inf] I64 -> Graph c -> Array c;
dijkstra = |start, graph| (
    // The number of nodes in the graph.
    let nn = graph.get_size;

    // The array of distances to reach each node from the starting node.
    let dists = fill(nn, inf);
    let dists = dists.set(start, zero);

    // The binary heap to store the nodes to visit.
    let visit_list = MinBinaryHeap::empty.push(NodeDistance::make(start, zero));

    // The main loop.
    loop((dists, visit_list), |(dists, visit_list)| (
        // If there is no node to visit, break the loop.
        if visit_list.get_size == 0 { break $ dists };

        // Get the node with the smallest distance.
        let NodeDistance { node : node, dist : dist } = visit_list.get_top.as_some;
        let visit_list = visit_list.pop;
        if dists.@(node) < dist {
            // The node is already visited.
            continue $ (dists, visit_list)
        };
        // `dists.@(node) == dist` holds.

        // See all the neighbors of the node.
        let edges = graph.@edges.@(node);
        continue $ edges.to_iter.fold((dists, visit_list), |Edge { to : to, data : cost}, (dists, visit_list)|
            // If the path using the current edge is not better than the previous one, skip.
            let new_dist = dist + cost;
            if !(new_dist < dists.@(to)) { (dists, visit_list) };

            // Update the distance to the node.
            let dists = dists.set(to, new_dist);
            let visit_list = visit_list.push(NodeDistance::make(to, new_dist));

            (dists, visit_list)
        )
    ))
);

// ベルマンフォード法：グラフと開始ノードが与えられたとき、開始ノードから各ノードに到達するまでの最小コストの配列を返す。
// 
// 到達できないノードまでの距離には`Inf::inf`が設定されます。
// 
// 制約：0 <= start < n, 開始ノードから到達できる負の閉路がない
//
// 計算量：O(n (n + m))
//
// # Parameters
// - `start` : 開始ノードの番号
// - `graph` : グラフ
bellman_ford : [c : Additive, c : LessThan, c : Inf, c : Eq] I64 -> Graph c -> Array c;
bellman_ford = |start, graph| (
    let n = graph.get_size;
    let d = fill(n, inf);
    let d = d.set(start, zero);
    loop(d, |d|
        let (d, update) = range(0, n).fold((d, false), |i, (d, update)|
            let edges = graph.@edges.@(i);
            edges.to_iter.fold((d, update), |Edge { to : to, data : cost}, (d, update)|
                let dist = d.@(i);
                if dist == inf { (d, update) }; // 到達できないノード
                let new_dist = d.@(i) + cost;
                if !(new_dist < d.@(to)) { (d, update) };
                let d = d.set(to, new_dist);
                (d, true)
            )
        );
        if !update { break $ d };
        continue $ d
    )
);

// グラフの強連結成分分解を求める
//
// 戻り値は、各強連結成分を構成する頂点のリストの配列です。
// また、戻り値はトポロジカルソートされています：uとvが異なる強連結成分cu, cvに属するとき、uからvに到達できるなら、cuはcvの前に現れます。
//
// 計算量：O(n + m)
//
// # Parameters
// - `g` : グラフ
calc_sccs : Graph c -> Array (Array I64);
calc_sccs = |g| (
    let n = g.get_size;

    // 深さ優先探索をして、探索を終えた順に頂点を並べる
    let visited = fill(n, false);
    let (_, visited, finished) = range(0, n).fold(([], visited, Array::empty(n)), |root, (stack, visited, finished)|
        if visited.@(root) { (stack, visited, finished) };
        _scc_dfs_postorder(g, root, stack, visited, finished)
    );

    // 辺の向きを逆にしたグラフをCSR形式の2つの配列で作る。
    // - rlist：頂点0に入る辺の始点、頂点1に入る辺の始点、…を、この順に詰めて並べた配列（長さは辺の数）
    // - rstart：長さn + 1の配列。頂点vに入る辺の始点は、rlistの[rstart.@(v), rstart.@(v + 1))にある
    // rstartは、各頂点に入る辺の数を数えて累積和を取って作る
    let rstart = range(0, n).fold(fill(n + 1, 0), |from, rstart|
        g.@edges.@(from).to_iter.fold(rstart, |Edge { to : to, data : _ }, rstart| rstart.mod(to + 1, |x| x + 1))
    );
    let rstart = range(0, n).fold(rstart, |v, rstart| let x = rstart.@(v); rstart.mod(v + 1, |y| y + x));
    // 元のグラフの辺を順に見て、行き先の頂点の区間に始点を書く。posは各頂点の区間で次に書く位置
    let (rlist, _) = range(0, n).fold((fill(rstart.@(n), 0), rstart), |from, (rlist, pos)|
        g.@edges.@(from).to_iter.fold((rlist, pos), |Edge { to : to, data : _ }, (rlist, pos)|
            let p = pos.@(to);
            (rlist.set(p, from), pos.set(to, p + 1))
        )
    );

    // 逆向きのグラフを、探索を終えた順の逆に深さ優先探索する。1回の探索で訪れる頂点が1つの強連結成分になる
    let visited = fill(n, false);
    let (_, _, sccs) = range_step(n - 1, -1, -1).fold(([], visited, []), |i, (stack, visited, sccs)|
        let root = finished.@(i);
        if visited.@(root) { (stack, visited, sccs) };
        let (stack, visited, scc) = _scc_dfs_preorder(rstart, rlist, root, stack, visited);
        (stack, visited, sccs.push_back(scc))
    );
    sccs
);

// `root`から深さ優先探索をし、探索を終えた順に頂点を`finished`の末尾に加える
//
// 再帰の代わりに、(頂点, 次に調べる辺の添字)を積む配列`stack`をスタックとして使う。`stack`は空で渡し、空で返る。
// 呼び出しごとに確保し直さないよう、呼び出し側が使い回す。
//
// # Parameters
// - `graph` : グラフ
// - `root` : 探索を始める頂点
// - `stack` : 探索に使う空の配列
// - `visited` : 訪れた頂点の印
// - `finished` : 探索を終えた頂点の列
_scc_dfs_postorder : Graph c -> I64 -> Array (I64, I64) -> Array Bool -> Array I64 -> (Array (I64, I64), Array Bool, Array I64);
_scc_dfs_postorder = |g, root, stack, visited, finished| (
    let visited = visited.set(root, true);
    loop((stack.push_back((root, 0)), visited, finished), |(stack, visited, finished)|
        if stack.@size == 0 { break $ (stack, visited, finished) };
        let top = stack.@size - 1;
        let (v, k) = stack.@(top);
        let edges = g.@edges.@(v);
        if k == edges.@size {
            continue $ (stack.pop_back, visited, finished.push_back(v))
        };
        let stack = stack.set(top, (v, k + 1));
        let to = edges.@(k).@to;
        if visited.@(to) { continue $ (stack, visited, finished) };
        continue $ (stack.push_back((to, 0)), visited.set(to, true), finished)
    )
);

// CSR形式のグラフを`root`から深さ優先探索し、訪れた頂点を訪れた順に並べて返す
//
// 再帰の代わりに、(頂点, 次に調べる辺の添字)を積む配列`stack`をスタックとして使う。`stack`は空で渡し、空で返る。
// 呼び出しごとに確保し直さないよう、呼び出し側が使い回す。
//
// # Parameters
// - `start` : 長さが頂点数 + 1の配列。頂点vから出る辺の行き先は、`list`の[start.@(v), start.@(v + 1))にある
// - `list` : 頂点0から出る辺の行き先、頂点1から出る辺の行き先、…を、この順に詰めて並べた配列
// - `root` : 探索を始める頂点
// - `stack` : 探索に使う空の配列
// - `visited` : 訪れた頂点の印
_scc_dfs_preorder : Array I64 -> Array I64 -> I64 -> Array (I64, I64) -> Array Bool -> (Array (I64, I64), Array Bool, Array I64);
_scc_dfs_preorder = |start, list, root, stack, visited| (
    let visited = visited.set(root, true);
    loop((stack.push_back((root, start.@(root))), visited, [root]), |(stack, visited, order)|
        if stack.@size == 0 { break $ (stack, visited, order) };
        let top = stack.@size - 1;
        let (v, k) = stack.@(top);
        if k == start.@(v + 1) { continue $ (stack.pop_back, visited, order) };
        let stack = stack.set(top, (v, k + 1));
        let to = list.@(k);
        if visited.@(to) { continue $ (stack, visited, order) };
        continue $ (stack.push_back((to, start.@(to))), visited.set(to, true), order.push_back(to))
    )
);
