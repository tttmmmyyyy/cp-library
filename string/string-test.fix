module CPLib.String.Test;

import CPLib.String::{calc_lcp_array, calc_suffix_array, calc_suffix_array_i64, calc_z_array, calc_z_array_any, _sa_doubling};
import Random::{generate_U64, init_by_seed};
import Std::{
    loop, IO, Array::{empty, fill, pop_back, push_back, @, @size}, Debug::{assert_eq, consumed_time_while_lazy}, 
    FromBytes::from_bytes, Functor::{forget, map}, IO::println, Iterator::{fold, fold_m, map, range, to_array}, LoopState::{break, continue}, 
    Monad::pure, Result::as_ok, String::{get_bytes, populate}, ToI64::i64, ToString::to_string, ToU8::u8
};

// https://atcoder.jp/contests/language-test-202505/submissions/68577484

test : IO ();
test = test_sa;; test_lcp;; test_z;; test_z_random;; test_z_speed;

test_sa : IO ();
test_sa = (
    let s = "abracadabra";
    let sa = s.calc_suffix_array;
    assert_eq(|_|"test_sa", sa, [10, 7, 0, 3, 5, 8, 1, 4, 6, 9, 2]);;

    let sa = s.get_bytes.map(i64).pop_back.calc_suffix_array_i64;
    assert_eq(|_|"test_sa", sa, [10, 7, 0, 3, 5, 8, 1, 4, 6, 9, 2]);;

    let rng = Random::init_by_seed(0_U64);
    range(0, 3).fold_m(rng, |_, rng|
        let n = 5e5;
        let (s, _) = range(0, n).fold((empty(n), rng), |_, (s, rng)|
            let (rng, v) = rng.generate_U64;
            let v = (v % 26_U64).u8 + 'a';
            (s.push_back(v), rng)
        );
        let s = s.push_back('\0');
        let s = s.from_bytes.as_ok;
        let sa0 = s.calc_suffix_array;
        let sa1 = s.get_bytes.map(i64).pop_back._sa_doubling;
        assert_eq(|_|"test_sa", sa0, sa1);;
        rng.pure
    );;

    pure()
);

test_lcp : IO ();
test_lcp = (
    let s = "abracadabra";
    let sa = s.calc_suffix_array;
    let lcp = s.calc_lcp_array(sa);
    assert_eq(|_|"test_lcp", lcp, [1, 4, 1, 1, 0, 3, 0, 0, 0, 2]);;
    pure()
);

test_z : IO ();
test_z = (
    let s = "abracadabra";
    let z = s.calc_z_array;
    assert_eq(|_|"test_z", z, [11, 0, 0, 1, 0, 1, 0, 4, 0, 0, 1]);;
    pure()
);
// ランダムな短い配列で、Z-arrayを素朴な計算と比べる
test_z_random : IO ();
test_z_random = (
    let rng = Random::init_by_seed(0_U64);
    range(0, 300).fold_m(rng, |_, rng|
        let (rng, n) = rng.generate_U64;
        let n = (n % 20_U64).i64;
        let (s, rng) = range(0, n).fold(([], rng), |_, (s, rng)|
            let (rng, c) = rng.generate_U64;
            (s.push_back((c % 2_U64).i64), rng)
        );
        let naive = range(0, n).map(|i|
            loop(0, |k| if i + k < n && s.@(i + k) == s.@(k) { continue $ k + 1 } else { break $ k })
        ).to_array;
        assert_eq(|_|"test_z_random", s.calc_z_array_any, naive);;
        pure $ rng
    ).forget
);

// 全要素が等しい配列のZ-array。素朴な延長をするとO(n^2)かかる入力
test_z_speed : IO ();
test_z_speed = (
    let n = 1e5;
    let s = fill(n, 0);
    let (z, time) = consumed_time_while_lazy(|_| s.calc_z_array_any);
    assert_eq(|_|"test_z_speed", z.@(n - 1), 1);;
    println("[CPLib.String.Test] calc_z_array_any({}): {}".populate([n.to_string, time.to_string]))
);
