// 文字列と配列の接尾辞・接頭辞を扱うアルゴリズム（suffix array、LCP array、Z-array）
//
// 文字列を受ける関数は、文字列をバイトの列として扱います。各関数には、任意の要素型の配列を受ける関数（名前の末尾が`_any`）があります。
//
// `s[i..j)`は`s`の`i`番目から`j - 1`番目までの部分列を表し、`j`を省いた`s[i..)`は`i`番目以降からなる接尾辞を表します。
//
// # Examples
// ```fix
// let s = "abab";
// let sa = calc_suffix_array(s); // 接尾辞を辞書順に並べると "ab", "abab", "b", "bab"
// assert_eq(|_|"", sa, [2, 0, 3, 1]);;
// assert_eq(|_|"", calc_lcp_array(sa, s), [2, 0, 1]);;
// assert_eq(|_|"", calc_z_array(s), [4, 0, 2, 0])
// ```
module CPLib.String;

import Std::{
    loop, undefined, Array, Eq, I32, I64, LessThan, String, Add::add, 
    Array::{empty, fill, mod, pop_back, push_back, set, sort_by, to_iter, @, @size}, Functor::map, I32::maximum, 
    Iterator::{fold, range, range_step, to_array}, LessThan::min, LoopState::{break, continue}, 
    String::get_bytes, ToI32::i32, ToI64::i64, Tuple2::@0
};

// 文字列のsuffix arrayを計算する
// 
// AtCoder Libraryの`suffix_array`の移植です。
// 
// 制約：文字列のバイト数 < 2^31
//
// 計算量：O(n)、n = 文字列のバイト数
//
// # Returns
// `[0, 1, ..., n)` の順列`sa`で、0 <= i < n - 1を満たすすべての`i`について`s[sa.@(i)..) < s[sa.@(i+1)..)` が成り立つもの。n = 文字列のバイト数
// 
// # Parameters
// - `s` : 対象の文字列
calc_suffix_array : String -> Array I64;
calc_suffix_array = |s| (
    let bytes = s.get_bytes.pop_back;
    if bytes.@size > I32::maximum.i64 { _too_long("calc_suffix_array") };
    bytes.map(i32)._sa_is(255).map(i64)
);

// `I64`の配列のsuffix arrayを計算する
//
// `calc_suffix_array_any`と同じ結果を返す。
//
// 制約：|s| < 2^31
//
// 計算量：O(n log n)、n = |s|
//
// # Parameters
// - `s` : 対象の配列
calc_suffix_array_i64 : Array I64 -> Array I64;
calc_suffix_array_i64 = |s| s.calc_suffix_array_any;

// 比較できる要素の配列のsuffix arrayを計算する
//
// AtCoder Libraryの`suffix_array`の移植です。要素を座標圧縮し（大小の順に0から番号を振り）、その番号の列のsuffix arrayを求めます。
//
// 制約：|s| < 2^31、`<`と`==`が全順序を与える
//
// 計算量：O(n log n)、n = |s|。要素の比較をO(1)とする
//
// # Returns
// `[0, 1, ..., n)` の順列`sa`で、0 <= i < n - 1を満たすすべての`i`について`s[sa.@(i)..) < s[sa.@(i+1)..)` が成り立つもの
//
// # Parameters
// - `s` : 対象の配列
//
// # Examples
// ```fix
// // 接尾辞を辞書順に並べると "ab", "abab", "b", "bab"
// assert_eq(|_|"", calc_suffix_array_any(["a", "b", "a", "b"]), [2, 0, 3, 1])
// ```
calc_suffix_array_any : [a : LessThan, a : Eq] Array a -> Array I64;
calc_suffix_array_any = |s| (
    let n = s.@size;
    if n > I32::maximum.i64 { _too_long("calc_suffix_array_any") };
    let idx = range(0, n).to_array;
    let idx = idx.sort_by(|(l, r)| s.@(l) < s.@(r));
    let s2 = fill(n, 0_I32);
    let (s2, now) = range(0, n).fold((s2, 0), |i, (s2, now)|
        let now = if i > 0 && s.@(idx.@(i - 1)) != s.@(idx.@(i)) { now + 1 } else { now };
        let s2 = s2.set(idx.@(i), now.i32);
        (s2, now)
    );
    s2._sa_is(now).map(i64)
);

// 配列のsuffix arrayを計算する
//
// AtCoder Libraryの`suffix_array`の移植です。
// 
// 制約：0 <= s.@(i) <= upper < 2^31、|s| < 2^31
//
// 計算量：O(n + upper)、n = |s|
//
// # Returns
// `[0, 1, ..., n)` の順列`sa`で、0 <= i < n - 1を満たすすべての`i`について`s[sa.@(i)..) < s[sa.@(i+1)..)` が成り立つもの
// 
// # Parameters
// - `upper` : `s`の要素の上限
// - `s` : 対象の配列
calc_suffix_array_i64_upper : I64 -> Array I64 -> Array I64;
calc_suffix_array_i64_upper = |upper, s| (
    if s.@size > I32::maximum.i64 { _too_long("calc_suffix_array_i64_upper") };
    if upper > I32::maximum.i64 { undefined("[CPLib.String::calc_suffix_array_i64_upper] got an upper bound of 2^31 or more") };
    s.map(i32)._sa_is(upper).map(i64)
);

// 文字列のLCP arrayを計算する
// 
// 制約：saはsのsuffix array, 文字列のバイト数 < 2^31
//
// 計算量：O(n)、n = 文字列のバイト数
//
// # Returns
// 長さ`max(n - 1, 0)`の配列`lcp`で、`lcp.@(i)`は`s[sa.@(i)..)`と`s[sa.@(i+1)..)`の最長共通接頭辞の長さを表す。
//
// # Parameters
// - `sa` : 対象の文字列のsuffix array
// - `s` : 対象の文字列
//
// # Examples
// ```fix
// let s = "abab";
// let sa = calc_suffix_array(s); // 接尾辞を辞書順に並べると "ab", "abab", "b", "bab"
// assert_eq(|_|"", sa, [2, 0, 3, 1]);;
// assert_eq(|_|"", calc_lcp_array(sa, s), [2, 0, 1])
// ```
calc_lcp_array : Array I64 -> String -> Array I64;
calc_lcp_array = |sa, s| s.get_bytes.pop_back.calc_lcp_array_any(sa);

// 配列のLCP arrayを計算する
//
// 制約：saはsのsuffix array, |s| < 2^31
//
// 計算量：O(n)、n = |s|
//
// # Returns
// 長さ`max(n - 1, 0)`の配列`lcp`で、`lcp.@(i)`は`s[sa.@(i)..)`と`s[sa.@(i+1)..)`の最長共通接頭辞の長さを表す。
//
// # Parameters
// - `sa` : 対象の配列のsuffix array
// - `s` : 対象の配列
calc_lcp_array_any : [a : Eq] Array I64 -> Array a -> Array I64;
calc_lcp_array_any = |sa, s| (
    let n = s.@size;
    if n > I32::maximum.i64 { _too_long("calc_lcp_array_any") };
    if n == 0 { [] };
    let sa = sa.map(i32);
    let rnk = fill(n, 0_I32);
    let rnk = range(0, n).fold(rnk, |i, rnk| rnk.set(sa.@(i).i64, i.i32));
    let lcp = fill(n - 1, 0_I32);
    range(0, n).fold((lcp, 0), |i, (lcp, h)|
        let h = if h > 0 { h - 1 } else { 0 };
        let r = rnk.@(i).i64;
        if r == 0 { (lcp, h) };
        let j = sa.@(r - 1).i64;
        let h = loop(h, |h|
            if i + h >= n || j + h >= n { break $ h };
            if s.@(i + h) != s.@(j + h) { break $ h };
            continue $ h + 1
        );
        let lcp = lcp.set(r - 1, h.i32);
        (lcp, h)
    ).@0.map(i64)
);

// 長さが2^31以上の配列を受けたことを、関数名`name`を書いて伝え、止める
//
// suffix arrayとLCP arrayは、作業用の配列の要素を4バイトで持つので、長さが2^31未満でなければならない。`I64`で持つより作業用の配列がL3キャッシュに収まりやすく、長さ10^6の文字列で1.5倍ほど速い。
//
// # Parameters
// - `name` : 呼び出し元の関数名
_too_long : String -> a;
_too_long = |name| undefined("[CPLib.String::" + name + "] got an array of length 2^31 or more");

// 文字列のZ-arrayを計算する
// 
// 計算量：O(n)、n = 文字列のバイト数
//
// # Returns
// 長さnの配列`z`で、`z.@(i)`は`s[i..)`と`s`の最長共通接頭辞の長さを表す。n = 文字列のバイト数
// 
// # Parameters
// - `s` : 対象の文字列
calc_z_array : String -> Array I64;
calc_z_array = |s| s.get_bytes.pop_back.calc_z_array_any;

// 配列のZ-arrayを計算する
// 
// 計算量：O(n)、n = |s|
//
// # Returns
// 長さnの配列`z`で、`z.@(i)`は`s[i..)`と`s`の最長共通接頭辞の長さを表す。
// 
// # Parameters
// - `s` : 対象の配列
calc_z_array_any : [a : Eq] Array a -> Array I64;
calc_z_array_any = |s| (
    let n = s.@size;
    if n == 0 { [] };
    let z = fill(n, 0);
    let z = z.set(0, 0);
    let (_, z) = range(1, n).fold((0, z), |i, (j, z)|
        let k = if j + z.@(j) <= i { 0 } else { min(j + z.@(j) - i, z.@(i-j)) };
        let z = z.set(i, k);
        let z = loop(z, |z|
            let k = z.@(i);
            if i + k >= n || s.@(i + k) != s.@(k) { break $ z };
            continue $ z.set(i, k + 1)
        );
        let j = if j + z.@(j) < i + z.@(i) { i } else { j };
        (j, z)
    );
    let z = z.set(0, n);
    z
);

// SA-IS法
//
// 配列の要素も、返すsuffix arrayの要素も4バイトで持つ。
//
// # Parameters
// - `upper` : `s`の要素の上限
// - `s` : 対象の配列
_sa_is : I64 -> Array I32 -> Array I32;
_sa_is = |upper, s| (
    let n = s.@size;
    if n == 0 { [] };
    if n == 1 { [0_I32] };
    if n == 2 {
        if s.@(0) < s.@(1) {
            [0_I32, 1_I32]
        } else {
            [1_I32, 0_I32]
        }
    };
    if n < 40 {
        s._sa_doubling
    };
    let sa = fill(n, 0_I32);
    let ls = fill(n, false);
    let ls = range_step(n-2, -1, -1).fold(ls, |i, ls|
        let l = if s.@(i) == s.@(i+1) { ls.@(i+1) } else { s.@(i) < s.@(i+1) };
        ls.set(i, l)
    );
    let sum_l = fill(upper+1, 0_I32);
    let sum_s = fill(upper+1, 0_I32);
    let (sum_l, sum_s) = range(0, n).fold((sum_l, sum_s), |i, (sum_l, sum_s)|
        if !ls.@(i) {
            (sum_l, sum_s.mod(s.@(i).i64, add(1_I32)))
        } else {
            (sum_l.mod(s.@(i).i64 + 1, add(1_I32)), sum_s)
        }
    );
    let (sum_l, sum_s) = range(0, upper+1).fold((sum_l, sum_s), |i, (sum_l, sum_s)|
        let sum_s = sum_s.mod(i, add $ sum_l.@(i));
        let sum_l = if i < upper { sum_l.mod(i+1, add $ sum_s.@(i)) } else { sum_l };
        (sum_l, sum_s)
    );
    let induce : Array I32 -> Array I32 -> Array I32 = |lms, sa| (
        let sa = range(0, n).fold(sa, |i, sa| sa.set(i, -1_I32) );
        let buf = sum_s;
        let (sa, _) = lms.to_iter.fold((sa, buf), |d, (sa, buf)|
            if d.i64 == n { (sa, buf) };
            let i = s.@(d.i64).i64;
            let sa = sa.set(buf.@(i).i64, d);
            let buf = buf.mod(i, add(1_I32));
            (sa, buf)
        );
        let buf = sum_l;
        let i = s.@(n-1).i64;
        let sa = sa.set(buf.@(i).i64, (n-1).i32);
        let buf = buf.mod(i, add(1_I32));
        let (sa, _) = range(0, n).fold((sa, buf), |i, (sa, buf)|
            let v = sa.@(i).i64;
            if v >= 1 && !ls.@(v-1) {
                let i = s.@(v-1).i64;
                let sa = sa.set(buf.@(i).i64, (v-1).i32);
                let buf = buf.mod(i, add(1_I32));
                (sa, buf)
            };
            (sa, buf)
        );
        let buf = sum_l;
        let (sa, _) = range_step(n-1, -1, -1).fold((sa, buf), |i, (sa, buf)|
            let v = sa.@(i).i64;
            if v >= 1 && ls.@(v-1) {
                let i = s.@(v-1).i64 + 1;
                let buf = buf.mod(i, add(-1_I32));
                let sa = sa.set(buf.@(i).i64, (v-1).i32);
                (sa, buf)
            };
            (sa, buf)
        );
        sa
    );
    let lms_map = fill(n+1, -1_I32);
    let (lms_map, m) = range(1, n).fold((lms_map, 0), |i, (lms_map, m)|
        if !ls.@(i-1) && ls.@(i) {
            let lms_map = lms_map.set(i, m.i32);
            let m = m + 1;
            (lms_map, m)
        };
        (lms_map, m)
    );
    let lms = empty(m);
    let lms = range(1, n).fold(lms, |i, lms|
        if !ls.@(i-1) && ls.@(i) {
            lms.push_back(i.i32)
        };
        lms
    );
    let sa = sa.induce(lms);

    if m > 0 {
        let sorted_lms = empty(m);
        let sorted_lms = sa.to_iter.fold(sorted_lms, |v, sorted_lms|
            if lms_map.@(v.i64) != -1_I32 { sorted_lms.push_back(v) };
            sorted_lms
        );
        let rec_s = fill(m, 0_I32);
        let rec_s = rec_s.set(lms_map.@(sorted_lms.@(0).i64).i64, 0_I32);
        let (rec_s, rec_upper) = range(1, m).fold((rec_s, 0), |i, (rec_s, rec_upper)|
            let l = sorted_lms.@(i-1).i64;
            let r = sorted_lms.@(i).i64;
            let end_l = if lms_map.@(l).i64 + 1 < m { lms.@(lms_map.@(l).i64 + 1).i64 } else { n };
            let end_r = if lms_map.@(r).i64 + 1 < m { lms.@(lms_map.@(r).i64 + 1).i64 } else { n };
            let same = if end_l - l != end_r - r {
                false
            } else {
                let (l, r) = loop((l, r), |(l, r)|
                    if l >= end_l { break $ (l, r) };
                    if s.@(l) != s.@(r) { break $ (l, r) };
                    continue $ (l + 1, r + 1)
                );
                if l == n || s.@(l) != s.@(r) { false } else { true }
            };
            let rec_upper = if !same { rec_upper + 1 } else { rec_upper };
            let rec_s = rec_s.set(lms_map.@(r).i64, rec_upper.i32);
            (rec_s, rec_upper)
        );
        
        let rec_sa = rec_s._sa_is(rec_upper);

        let sorted_lms = range(0, m).fold(sorted_lms, |i, sorted_lms|
            sorted_lms.set(i, lms.@(rec_sa.@(i).i64))
        );
        sa.induce(sorted_lms)
    };
    sa
);

// 接頭辞を倍々に比べてsuffix arrayを求める。要素数の少ない配列向け
//
// # Parameters
// - `s` : 対象の配列
_sa_doubling : Array I32 -> Array I32;
_sa_doubling = |s| (
    let n = s.@size;
    let sa = range(0, n).fold(fill(n, 0_I32), |i, sa| sa.set(i, i.i32) );
    let rnk = s;
    let tmp = fill(n, 0_I32);
    loop((1, sa, rnk, tmp), |(k, sa, rnk, tmp)|
        if k >= n { break $ sa };
        let cmp = |(x, y)| (
            let x = x.i64;
            let y = y.i64;
            if (rnk.@(x) != rnk.@(y)) { rnk.@(x) < rnk.@(y) };
            let rx = if x + k < n { rnk.@(x + k) } else { -1_I32 };
            let ry = if y + k < n { rnk.@(y + k) } else { -1_I32 };
            rx < ry
        );
        let sa = sa.sort_by(cmp);
        let tmp = tmp.set(sa.@(0).i64, 0_I32);
        let tmp = range(1, n).fold(tmp, |i, tmp|
            let v = tmp.@(sa.@(i-1).i64) + if cmp((sa.@(i-1), sa.@(i))) { 1_I32 } else { 0_I32 };
            tmp.set(sa.@(i).i64, v)
        );
        let (rnk, tmp) = (tmp, rnk); // Swap `tmp` and `rnk`
        continue $ (k * 2, sa, rnk, tmp)
    )
);
