// モノイド構造が動的に決まる際に使えるセグメント木。
// 
// コンストラクタでモノイド（unitおよびop）を指定する点以外は、`CPLib.Segtree`と同じです。
// モノイド構造が静的に決まる場合は`CPLib.Segtree`の方が高速です。
//
// 制約・計算量の n は要素数です。計算量は`op`がO(1)で動くとしたものです。
//
// # Examples
// ```fix
// // 区間の最小値を求めるセグメント木
// let tree = build([5, 3, 8], maximum, |(x, y)| min(x, y));
// let tree = tree.set(1, 9); // [5, 9, 8]
// assert_eq(|_|"", tree.fold(1, 3), 8)
// ```
module CPLib.DSegtree;

import Std::{
    loop, Array, Bool, I64, Array::{fill, set, @, @size}, I64::{shift_left, shift_right}, 
    Iterator::{fold, range, range_step}, LoopState::{break, continue}
};

// この実装にあたっては、[maspyさんの記事](https://maspypy.com/segment-tree-%E3%81%AE%E3%81%8A%E5%8B%89%E5%BC%B71) を参考にしました。良質な解説をありがとうございます。

// セグメント木
type DSegtree m = struct {
    // 要素数
    n : I64,
    // ユニット
    unit : m,
    // 演算子
    op : (m, m) -> m,
    // 内部配列
    // 
    // 1-indexedで運用する：長さは`2n`、第0インデックスは使用しない。
    elems : Array m,
};

// すべての要素が単位元であるようなセグメント木を作成する
//
// 計算量：O(n)
//
// # Parameters
// - `n` : セグメント木の要素数
// - `unit` : モノイドの単位元
// - `op` : モノイドの演算子
init : I64 -> m -> ((m, m) -> m) -> DSegtree m;
init = |n, unit, op| (
    let elems = fill(n * 2, unit);
    DSegtree { elems : elems, n : n, unit : unit, op : op }
);

// 要素の配列からセグメント木を作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `elems` : セグメント木の要素を格納する配列
// - `unit` : モノイドの単位元
// - `op` : モノイドの演算子
build : Array m -> m -> ((m, m) -> m) -> DSegtree m;
build = |elems, unit, op| (
    let n = elems.@size;
    let tree = fill(n * 2, unit);
    // [n, 2n)に要素をセット
    let tree = range(0, n).fold(tree, |i, tree| tree.set(n + i, elems.@(i)) );
    // [1, n)の範囲を計算
    let tree = range_step(n-1, 0, -1).fold(tree, |i, tree|
        let left = tree.@(i * 2);
        let right = tree.@(i * 2 + 1);
        tree.set(i, op((left, right)))
    );
    DSegtree { elems : tree, n : n, unit : unit, op : op }
);

// セグメント木の要素を取得する
//
// 制約：0 <= i < n
//
// 計算量：O(1)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `tree` : セグメント木
@ : I64 -> DSegtree m -> m;
@ = |i, tree| (
    let n = tree.@n;
    tree.@elems.@(n + i)
);

// 要素を設定する
// 
// 制約：0 <= i < n
//
// 計算量：O(log n)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `value` : 設定する値
// - `tree` : セグメント木
set : I64 -> m -> DSegtree m -> DSegtree m;
set = |i, value, tree| (
    let n = tree.@n;
    let i = i + n;
    let tree = tree.mod_elems(set(i, value));
    // `i`の祖先ノードを下から順にすべて更新
    loop((i / 2, tree), |(p, tree)|
        if p == 0 { break $ tree }; // 根（添字1）を更新したら終了
        let left = tree.@elems.@(p * 2);
        let right = tree.@elems.@(p * 2 + 1);
        let value = tree.@op $ (left, right);
        let tree = tree.mod_elems(set(p, value));
        continue $ (p / 2, tree)
    )
);

// 半開区間[l, r)にある要素の畳み込みを計算する
//
// 制約：0 <= l <= r <= n
//
// 計算量：O(log n)
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `tree` : セグメント木
fold : I64 -> I64 -> DSegtree m -> m;
fold = |l, r, tree| (
    let n = tree.@n;
    let l = l + n;
    let r = r + n;
    let (acc_l, acc_r) = loop((l, r, tree.@unit, tree.@unit), |(l, r, acc_l, acc_r)|
        if l >= r {
            break $ (acc_l, acc_r)
        };
        let (l, acc_l) = if l % 2 == 0 { (l, acc_l) } else {
            let acc_l = tree.@op $ (acc_l, tree.@elems.@(l));
            let l = l + 1;
            (l, acc_l)
        };
        let (r, acc_r) = if r % 2 == 0 { (r, acc_r) } else {
            let r = r - 1;
            let acc_r = tree.@op $ (tree.@elems.@(r), acc_r);
            (r, acc_r)
        };
        let l = l / 2;
        let r = r / 2;
        continue $ (l, r, acc_l, acc_r)
    );
    tree.@op $ (acc_l, acc_r)
);

// すべての要素の畳み込みを計算する
//
// 計算量：O(log n)
//
// # Parameters
// - `tree` : セグメント木
fold_all : DSegtree m -> m;
fold_all = |tree| tree.fold(0, tree.@n);

// 左端を`l`に固定して、区間の畳み込みが`f`を満たす右端を、木の上の二分探索で求める
//
// 次の2つを満たす`r`を返す。
// - `r == l`であるか、`f(fold(l, r))`が真
// - `r == n`であるか、`f(fold(l, r + 1))`が偽
//
// `f`が単調なら（区間を右に伸ばして偽になったら、さらに伸ばしても真にならないなら）、これは`f(fold(l, r))`が真になる最大の`r`である。
//
// 制約：0 <= l <= n、`f(unit)`が真
//
// 計算量：O(log n)。`f`の呼び出しもO(log n)回。
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `f` : 区間の畳み込みについての条件
// - `tree` : セグメント木
calc_max_right : I64 -> (m -> Bool) -> DSegtree m -> I64;
calc_max_right = |l, f, tree| (
    let n = tree.@n;
    let elems = tree.@elems;
    let op = tree.@op;
    // `fold(l, n)`が畳み込むノードを左から順に試し、`f`が偽になる最初のノードkと、kより左のノードの畳み込みaccを求める。
    // 段hで`fold`が畳み込むノードは、lh = ceil((l + n) / 2^h)、rh = floor(2n / 2^h)として、lh < rhの段のうち、
    // 左端の側ではlh（lhが奇数のとき）、右端の側ではrh - 1（rhが奇数のとき）である。
    // これらを左から順に並べると、左端の側のノードが低い段から、続いて右端の側のノードが高い段から並ぶ。
    // 見つからなければkは0とする。
    let (k, height, acc) = loop((l + n, n * 2, 0, tree.@unit), |(lh, rh, h, acc)|
        if lh >= rh { break $ (0, h, acc) };
        if lh % 2 == 1 {
            let next = op((acc, elems.@(lh)));
            if !f(next) { break $ (lh, h, acc) };
            continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, next)
        };
        continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, acc)
    );
    let (k, acc) = if k != 0 { (k, acc) } else {
        loop((height - 1, acc), |(h, acc)|
            if h < 0 { break $ (0, acc) };
            let rh = (n * 2).shift_right(h);
            if rh % 2 == 0 { continue $ (h - 1, acc) };
            let next = op((acc, elems.@(rh - 1)));
            if !f(next) { break $ (rh - 1, acc) };
            continue $ (h - 1, next)
        )
    };
    if k == 0 { n };
    // kから葉へ降りる。左の子までの畳み込みがfを満たせば右の子へ、満たさなければ左の子へ進む。
    loop((k, acc), |(k, acc)|
        if k >= n { break $ k - n };
        let next = op((acc, elems.@(k * 2)));
        if f(next) { continue $ (k * 2 + 1, next) } else { continue $ (k * 2, acc) }
    )
);

// 右端を`r`に固定して、区間の畳み込みが`f`を満たす左端を、木の上の二分探索で求める
//
// 次の2つを満たす`l`を返す。
// - `l == r`であるか、`f(fold(l, r))`が真
// - `l == 0`であるか、`f(fold(l - 1, r))`が偽
//
// `f`が単調なら（区間を左に伸ばして偽になったら、さらに伸ばしても真にならないなら）、これは`f(fold(l, r))`が真になる最小の`l`である。
//
// 制約：0 <= r <= n、`f(unit)`が真
//
// 計算量：O(log n)。`f`の呼び出しもO(log n)回。
//
// # Parameters
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `f` : 区間の畳み込みについての条件
// - `tree` : セグメント木
calc_min_left : I64 -> (m -> Bool) -> DSegtree m -> I64;
calc_min_left = |r, f, tree| (
    let n = tree.@n;
    let elems = tree.@elems;
    let op = tree.@op;
    // `fold(0, r)`が畳み込むノードを右から順に試し、`f`が偽になる最初のノードkと、kより右のノードの畳み込みaccを求める。
    // 段hで`fold`が畳み込むノードは、lh = ceil(n / 2^h)、rh = floor((r + n) / 2^h)として、lh < rhの段のうち、
    // 左端の側ではlh（lhが奇数のとき）、右端の側ではrh - 1（rhが奇数のとき）である。
    // これらを右から順に並べると、右端の側のノードが低い段から、続いて左端の側のノードが高い段から並ぶ。
    // 見つからなければkは0とする。
    let (k, height, acc) = loop((n, r + n, 0, tree.@unit), |(lh, rh, h, acc)|
        if lh >= rh { break $ (0, h, acc) };
        if rh % 2 == 1 {
            let next = op((elems.@(rh - 1), acc));
            if !f(next) { break $ (rh - 1, h, acc) };
            continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, next)
        };
        continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, acc)
    );
    let (k, acc) = if k != 0 { (k, acc) } else {
        loop((height - 1, acc), |(h, acc)|
            if h < 0 { break $ (0, acc) };
            let lh = (n + 1.shift_left(h) - 1).shift_right(h);
            if lh % 2 == 0 { continue $ (h - 1, acc) };
            let next = op((elems.@(lh), acc));
            if !f(next) { break $ (lh, acc) };
            continue $ (h - 1, next)
        )
    };
    if k == 0 { 0 };
    // kから葉へ降りる。右の子からの畳み込みがfを満たせば左の子へ、満たさなければ右の子へ進む。
    loop((k, acc), |(k, acc)|
        if k >= n { break $ k + 1 - n };
        let next = op((elems.@(k * 2 + 1), acc));
        if f(next) { continue $ (k * 2, next) } else { continue $ (k * 2 + 1, acc) }
    )
);
