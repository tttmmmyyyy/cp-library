// セグメント木の実装
//
// 使用方法：
// 要素は`CPLib.Trait.Monoid`を実装している必要があります。
// 和・積・最小値・最大値のモノイドは`CPLib.Monoid`にあります。
// それ以外のモノイドは、自分で型を作成し、`Monoid`を実装してください。
// あとは、`create`や`build`を使ってセグメント木を作成し、
// `@`で要素を取得、`set`で要素を更新、`fold`で区間の畳み込みを計算できます。
// `fold_all`は全体の畳み込みを、`calc_max_right`と`calc_min_left`は区間の畳み込みが条件を満たす端を計算します。
// ```fix
// # module DocTest;
// import CPLib.Segtree;
// import CPLib.Trait;
//
// // 文字列の結合に関するモノイド
// type StrConcat = struct { v : String };
// namespace StrConcat {
//     make : String -> StrConcat = |v| StrConcat { v };
// }
// impl StrConcat : Monoid {
//     unit = make("");
//     op = |lhs, rhs| make $ lhs.@v + rhs.@v;
// }
//
// main : IO () = (
//     let tree = build(["a", "x", "c"].map(make));
//     let tree = tree.set(1, make("b"));
//     assert_eq(|_|"", tree.@(1).@v, "b");;
//     assert_eq(|_|"", tree.fold(0, 3).@v, "abc")
// );
// ```
// 
// 制約・計算量の n は要素数です。計算量は`op`がO(1)で動くとしたものです。
//
// モノイド構造が動的に決まる場合は、モジュール`CPLib.DSegtree`を使用してください。
module CPLib.Segtree;

import CPLib.Trait::{Monoid, Monoid::{op, unit}};
import Std::{
    loop, undefined, Array, Bool, I64, Array::{fill, set, @, @size}, I64::{shift_left, shift_right}, 
    Iterator::{fold, range, range_step}, LoopState::{break, continue}
};

// この実装にあたっては、[maspyさんの記事](https://maspypy.com/segment-tree-%E3%81%AE%E3%81%8A%E5%8B%89%E5%BC%B71) を参考にしました。良質な解説をありがとうございます。

// セグメント木
type Segtree m = struct {
    // 要素数
    _n : I64,
    // 内部配列
    // 
    // 1-indexedで運用する：長さは`2n`、第0インデックスは使用しない。
    _elems : Array m,
};

// すべての要素が単位元であるようなセグメント木を作成する
//
// 計算量：O(n)
//
// # Parameters
// - `n` : セグメント木の要素数
create : [m : Monoid] I64 -> Segtree m;
create = |n| (
    let elems = fill(n * 2, Monoid::unit);
    Segtree { _elems : elems, _n : n }
);

// `create`の別名（非推奨）
init : [m : Monoid] I64 -> Segtree m = create;
DEPRECATED[init, "Use `CPLib.Segtree::create` instead."];

// 要素の配列からセグメント木を作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `elems` : セグメント木の要素を格納する配列
build : [m : Monoid] Array m -> Segtree m;
build = |elems| (
    let n = elems.@size;
    let tree = fill(n * 2, Monoid::unit);
    // [n, 2n)に要素をセット
    let tree = range(0, n).fold(tree, |i, tree| tree.set(n + i, elems.@(i)) );
    // [1, n)の範囲を計算
    let tree = range_step(n-1, 0, -1).fold(tree, |i, tree|
        let left = tree.@(i * 2);
        let right = tree.@(i * 2 + 1);
        tree.set(i, Monoid::op(left, right))
    );
    Segtree { _elems : tree, _n : n }
);

// セグメント木の要素数を取得する
//
// 計算量：O(1)
//
// # Parameters
// - `tree` : セグメント木
@size : Segtree m -> I64;
@size = |tree| tree.@_n;

// セグメント木の要素を取得する
// 
// 制約：0 <= i < n
//
// 計算量：O(1)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `tree` : セグメント木
@ : I64 -> Segtree m -> m;
@ = |i, tree| (
    if !(0 <= i && i < tree.@_n) { undefined("[CPLib.Segtree::@] `i` is out of [0, n)") };
    let n = tree.@_n;
    tree.@_elems.@(n + i)
);

// 要素を設定する
// 
// 制約：0 <= i < n
//
// 計算量：O(log n)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `value` : 設定する値
// - `tree` : セグメント木
set : [m : Monoid] I64 -> m -> Segtree m -> Segtree m;
set = |i, value, tree| (
    if !(0 <= i && i < tree.@_n) { undefined("[CPLib.Segtree::set] `i` is out of [0, n)") };
    let n = tree.@_n;
    let i = i + n;
    let tree = tree.mod__elems(set(i, value));
    // `i`の祖先ノードを下から順にすべて更新
    loop((i / 2, tree), |(p, tree)|
        if p == 0 { break $ tree }; // 根（添字1）を更新したら終了
        let left = tree.@_elems.@(p * 2);
        let right = tree.@_elems.@(p * 2 + 1);
        let value = Monoid::op(left, right);
        let tree = tree.mod__elems(set(p, value));
        continue $ (p / 2, tree)
    )
);

// 半開区間[l, r)にある要素の畳み込みを計算する
//
// 制約：0 <= l <= r <= n
//
// 計算量：O(log n)
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `tree` : セグメント木
fold : [m : Monoid] I64 -> I64 -> Segtree m -> m;
fold = |l, r, tree| (
    if !(0 <= l && l <= r && r <= tree.@_n) { undefined("[CPLib.Segtree::fold] `l` and `r` do not satisfy 0 <= l <= r <= n") };
    let n = tree.@_n;
    let l = l + n;
    let r = r + n;
    let (acc_l, acc_r) = loop((l, r, Monoid::unit, Monoid::unit), |(l, r, acc_l, acc_r)|
        if l >= r {
            break $ (acc_l, acc_r)
        };
        let (l, acc_l) = if l % 2 == 0 { (l, acc_l) } else {
            let acc_l = Monoid::op(acc_l, tree.@_elems.@(l));
            let l = l + 1;
            (l, acc_l)
        };
        let (r, acc_r) = if r % 2 == 0 { (r, acc_r) } else {
            let r = r - 1;
            let acc_r = Monoid::op(tree.@_elems.@(r), acc_r);
            (r, acc_r)
        };
        let l = l / 2;
        let r = r / 2;
        continue $ (l, r, acc_l, acc_r)
    );
    Monoid::op(acc_l, acc_r)
);

// すべての要素の畳み込みを計算する
//
// 計算量：O(log n)
//
// # Parameters
// - `tree` : セグメント木
fold_all : [m : Monoid] Segtree m -> m;
fold_all = |tree| tree.fold(0, tree.@_n);

// `f(fold(l, r))`が真になる最大の`r`を、木の上の二分探索で求める
//
// 制約：0 <= l <= n、`f(unit)`が真、`f`は単調（区間を右に伸ばして偽になったら、さらに伸ばしても真にならない）
//
// 計算量：O(log n)。`f`の呼び出しもO(log n)回。
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `f` : 区間の畳み込みについての条件
// - `tree` : セグメント木
//
// # Examples
// ```fix
// # module DocTest;
// import CPLib.Segtree;
// import CPLib.Trait;
//
// // 加法モノイド
// type Sum = struct { v : I64 };
// impl Sum : Monoid {
//     unit = Sum { v : 0 };
//     op = |lhs, rhs| Sum { v : lhs.@v + rhs.@v };
// }
//
// main : IO () = (
//     let tree = build([1, 2, 3, 4].map(|v| Sum { v }));
//     // 区間[0, 3)の和は6、区間[0, 4)の和は10
//     assert_eq(|_|"", tree.calc_max_right(0, |s| s.@v <= 6), 3)
// );
// ```
calc_max_right : [m : Monoid] I64 -> (m -> Bool) -> Segtree m -> I64;
calc_max_right = |l, f, tree| (
    if !(0 <= l && l <= tree.@_n) { undefined("[CPLib.Segtree::calc_max_right] `l` is out of [0, n]") };
    let n = tree.@_n;
    let elems = tree.@_elems;
    // `fold(l, n)`が畳み込むノードを左から順に試し、`f`が偽になる最初のノードkと、kより左のノードの畳み込みaccを求める。
    // 段hで`fold`が畳み込むノードは、lh = ceil((l + n) / 2^h)、rh = floor(2n / 2^h)として、lh < rhの段のうち、
    // 左端の側ではlh（lhが奇数のとき）、右端の側ではrh - 1（rhが奇数のとき）である。
    // これらを左から順に並べると、左端の側のノードが低い段から、続いて右端の側のノードが高い段から並ぶ。
    // 見つからなければkは0とする。
    let (k, height, acc) = loop((l + n, n * 2, 0, Monoid::unit), |(lh, rh, h, acc)|
        if lh >= rh { break $ (0, h, acc) };
        if lh % 2 == 1 {
            let next = Monoid::op(acc, elems.@(lh));
            if !f(next) { break $ (lh, h, acc) };
            continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, next)
        };
        continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, acc)
    );
    let (k, acc) = if k != 0 { (k, acc) } else {
        loop((height - 1, acc), |(h, acc)|
            if h < 0 { break $ (0, acc) };
            let rh = (n * 2).shift_right(h);
            if rh % 2 == 0 { continue $ (h - 1, acc) };
            let next = Monoid::op(acc, elems.@(rh - 1));
            if !f(next) { break $ (rh - 1, acc) };
            continue $ (h - 1, next)
        )
    };
    if k == 0 { n };
    // kから葉へ降りる。左の子までの畳み込みがfを満たせば右の子へ、満たさなければ左の子へ進む。
    loop((k, acc), |(k, acc)|
        if k >= n { break $ k - n };
        let next = Monoid::op(acc, elems.@(k * 2));
        if f(next) { continue $ (k * 2 + 1, next) } else { continue $ (k * 2, acc) }
    )
);

// `f(fold(l, r))`が真になる最小の`l`を、木の上の二分探索で求める
//
// 制約：0 <= r <= n、`f(unit)`が真、`f`は単調（区間を左に伸ばして偽になったら、さらに伸ばしても真にならない）
//
// 計算量：O(log n)。`f`の呼び出しもO(log n)回。
//
// # Parameters
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `f` : 区間の畳み込みについての条件
// - `tree` : セグメント木
//
// # Examples
// ```fix
// # module DocTest;
// import CPLib.Segtree;
// import CPLib.Trait;
//
// // 加法モノイド
// type Sum = struct { v : I64 };
// impl Sum : Monoid {
//     unit = Sum { v : 0 };
//     op = |lhs, rhs| Sum { v : lhs.@v + rhs.@v };
// }
//
// main : IO () = (
//     let tree = build([1, 2, 3, 4].map(|v| Sum { v }));
//     // 区間[2, 4)の和は7、区間[1, 4)の和は9
//     assert_eq(|_|"", tree.calc_min_left(4, |s| s.@v <= 7), 2)
// );
// ```
calc_min_left : [m : Monoid] I64 -> (m -> Bool) -> Segtree m -> I64;
calc_min_left = |r, f, tree| (
    if !(0 <= r && r <= tree.@_n) { undefined("[CPLib.Segtree::calc_min_left] `r` is out of [0, n]") };
    let n = tree.@_n;
    let elems = tree.@_elems;
    // `fold(0, r)`が畳み込むノードを右から順に試し、`f`が偽になる最初のノードkと、kより右のノードの畳み込みaccを求める。
    // 段hで`fold`が畳み込むノードは、lh = ceil(n / 2^h)、rh = floor((r + n) / 2^h)として、lh < rhの段のうち、
    // 左端の側ではlh（lhが奇数のとき）、右端の側ではrh - 1（rhが奇数のとき）である。
    // これらを右から順に並べると、右端の側のノードが低い段から、続いて左端の側のノードが高い段から並ぶ。
    // 見つからなければkは0とする。
    let (k, height, acc) = loop((n, r + n, 0, Monoid::unit), |(lh, rh, h, acc)|
        if lh >= rh { break $ (0, h, acc) };
        if rh % 2 == 1 {
            let next = Monoid::op(elems.@(rh - 1), acc);
            if !f(next) { break $ (rh - 1, h, acc) };
            continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, next)
        };
        continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, acc)
    );
    let (k, acc) = if k != 0 { (k, acc) } else {
        loop((height - 1, acc), |(h, acc)|
            if h < 0 { break $ (0, acc) };
            let lh = (n + 1.shift_left(h) - 1).shift_right(h);
            if lh % 2 == 0 { continue $ (h - 1, acc) };
            let next = Monoid::op(elems.@(lh), acc);
            if !f(next) { break $ (lh, acc) };
            continue $ (h - 1, next)
        )
    };
    if k == 0 { 0 };
    // kから葉へ降りる。右の子からの畳み込みがfを満たせば左の子へ、満たさなければ右の子へ進む。
    loop((k, acc), |(k, acc)|
        if k >= n { break $ k + 1 - n };
        let next = Monoid::op(elems.@(k * 2 + 1), acc);
        if f(next) { continue $ (k * 2, next) } else { continue $ (k * 2 + 1, acc) }
    )
);
