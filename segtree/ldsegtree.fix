// モノイド構造および作用が動的に決められる遅延伝搬セグメント木
//
// コンストラクタでモノイドおよび作用を指定する点以外は、`CPLib.LSegtree`と同じです。
// モノイド構造・作用が静的に決まる場合は`CPLib.LSegtree`の方が高速です。
//
// 制約・計算量の n は要素数です。計算量は`op`, `act_op`, `act`がO(1)で動くとしたものです。
//
// 制約：作用は次を満たす（`a`, `b`は作用、`x`, `y`は値）
// - act(act_unit, x) = x
// - act(a, op(x, y)) = op(act(a, x), act(a, y))
// - act(act_op(a, b), x) = act(b, act(a, x))
//
// # Examples
// ```fix
// // 区間への加算と、区間の最大値の取得ができるセグメント木
// let tree = build(
//     [1, 2, 3],
//     minimum, |(x, y)| max(x, y), // 値モノイド：最大値
//     0, |(a, b)| a + b,                // 作用モノイド：加法
//     |(a, x)| x + a                    // 作用：加算
// );
// let tree = tree.act_range(0, 2, 10); // [11, 12, 3]
// assert_eq(|_|"", tree.fold(1, 3), 12)
// ```
module CPLib.LDSegtree;

import Std::{
    loop, undefined, Array, Bool, I64, Array::{@, @size, fill, set}, 
    I64::{count_leading_zeros, count_trailing_zeros, shift_left, shift_right}, 
    Iterator::{fold, range, range_step}, LoopState::{break, continue}
};

// この実装にあたっては、[maspyさんの記事](https://maspypy.com/segment-tree-%e3%81%ae%e3%81%8a%e5%8b%89%e5%bc%b72) を参考にしました。良質な解説をありがとうございます。

// 遅延伝搬セグメント木の型。
// 
// パラメータ`m`は「値」となるモノイドの型、`a`は「右作用」するモノイドの型。
type LDSegtree m a = struct {
    // 要素数
    _n : I64,
    // 値モノイドの単位元
    _unit : m,
    // 値モノイドの演算子
    _op : (m, m) -> m,
    // 作用モノイドの単位元
    _act_unit : a,
    // 作用モノイドの演算子
    _act_op : (a, a) -> a,
    // 右作用
    _act : (a, m) -> m,
    // ノードの値の配列
    // 
    // 1-indexedで運用する：長さは`2n`、第0インデックスは使用しない。ノード`k`の子は`2k`と`2k+1`、要素`i`は葉`n+i`。
    // 葉の値は要素の値である。内部ノード`k`の値は`_act(_lazy[k], _op(_elems[2k], _elems[2k+1]))`に等しい。
    _elems : Array m,
    // 内部ノードの、子にまだ伝搬していない作用の配列
    // 
    // 1-indexedで運用する：長さは`n`、第0インデックスは使用しない。
    _lazy : Array a,
};

// すべての要素が単位元であるような遅延伝搬セグメント木を作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `n` : セグメント木の要素数
// - `unit` : 値モノイドの単位元
// - `op` : 値モノイドの演算子
// - `act_unit` : 作用モノイドの単位元
// - `act_op` : 作用モノイドの演算子
// - `act` : 右作用
create : I64 -> m -> ((m, m) -> m) -> a -> ((a, a) -> a) -> ((a, m) -> m) -> LDSegtree m a;
create = |n, unit, op, act_unit, act_op, act| (
    let elems = fill(n * 2, unit);
    let lazy = fill(n, act_unit);
    LDSegtree { _elems : elems, _lazy : lazy, _n : n, _unit : unit, _op : op, _act_unit : act_unit, _act_op : act_op, _act : act }
);

// `create`の別名（非推奨）。ただし作用`act`は、値を先に取る`(m, a) -> m`で受け取る
init : I64 -> m -> ((m, m) -> m) -> a -> ((a, a) -> a) -> ((m, a) -> m) -> LDSegtree m a;
init = |n, unit, op, act_unit, act_op, act| create(n, unit, op, act_unit, act_op, |(a, x)| act((x, a)));
DEPRECATED[init, "Use `CPLib.LDSegtree::create` instead, and swap the two arguments of the action function: `init` takes it as `(m, a) -> m`, with the value first, while `create` takes it as `(a, m) -> m`, with the action first."];

// 要素の配列からセグメント木を作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `elems` : セグメント木の要素を格納する配列
// - `unit` : 値モノイドの単位元
// - `op` : 値モノイドの演算子
// - `act_unit` : 作用モノイドの単位元
// - `act_op` : 作用モノイドの演算子
// - `act` : 右作用
build : Array m -> m -> ((m, m) -> m) -> a -> ((a, a) -> a) -> ((a, m) -> m) -> LDSegtree m a;
build = |elems, unit, op, act_unit, act_op, act| (
    let n = elems.@size;
    let lazy = fill(n, act_unit) : Array a;
    let tree = fill(n * 2, unit) : Array m;
    // [n, 2n)に要素をセット
    let tree = range(0, n).fold(tree, |i, tree| tree.set(n + i, elems.@(i)) );
    // [1, n)の範囲を計算
    let tree = range_step(n-1, 0, -1).fold(tree, |i, tree|
        let left = tree.@(i * 2);
        let right = tree.@(i * 2 + 1);
        tree.set(i, op((left, right)))
    );
    LDSegtree { _elems : tree, _lazy : lazy, _n : n, _unit : unit, _op : op, _act_unit : act_unit, _act_op : act_op, _act : act }
);

// ノード`k`に作用`a`を適用する
//
// ノードの値に作用を適用し、内部ノードなら子に伝搬する作用に`a`を合成する。
_apply_at : I64 -> a -> LDSegtree m a -> LDSegtree m a;
_apply_at = |k, a, tree| (
    let act = tree.@_act;
    let tree = tree.mod__elems(|elems| elems.set(k, act((a, elems.@(k)))));
    if k >= tree.@_n { tree };
    let act_op = tree.@_act_op;
    tree.mod__lazy(|lazy| lazy.set(k, act_op((lazy.@(k), a)))) // 右作用
);

// 内部ノード`k`の作用を子に伝搬する
_propagate_at : I64 -> LDSegtree m a -> LDSegtree m a;
_propagate_at = |k, tree| (
    let a = tree.@_lazy.@(k);
    let tree = tree._apply_at(k * 2, a)._apply_at(k * 2 + 1, a);
    tree.mod__lazy(set(k, tree.@_act_unit))
);

// ノード`k`の祖先すべてで、根から順に作用を子に伝搬する
_propagate_above : I64 -> LDSegtree m a -> LDSegtree m a;
_propagate_above = |k, tree| (
    let height = 63 - k.count_leading_zeros; // kの根からの深さ
    range_step(height, 0, -1).fold(tree, |h, tree|
        let j = k.shift_right(h); // kからh個親のノード
        tree._propagate_at(j)
    )
);

// ノード`k`の祖先すべての値を、下から順に子の値から計算し直す
// 
// 祖先が子に伝搬していない作用を持たないときに呼ぶ。
_recalc_above : I64 -> LDSegtree m a -> LDSegtree m a;
_recalc_above = |k, tree| (
    loop((k.shift_right(1), tree), |(p, tree)|
        if p == 0 { break $ tree }; // 根（添字1）を更新したら終了
        let elem = tree.@_op $ (tree.@_elems.@(p * 2), tree.@_elems.@(p * 2 + 1));
        let tree = tree.mod__elems(set(p, elem));
        continue $ (p.shift_right(1), tree)
    )
);

// 葉`l`から葉`r`の手前までの畳み込みを、ノードの値から計算する
//
// 値を読むノードの祖先が、子に伝搬していない作用を持たないときに呼ぶ。
_fold_nodes : I64 -> I64 -> LDSegtree m a -> m;
_fold_nodes = |l, r, tree| (
    let elems = tree.@_elems;
    let (acc_l, acc_r) = loop((l, r, tree.@_unit, tree.@_unit), |(l, r, acc_l, acc_r)|
        if l >= r {
            break $ (acc_l, acc_r)
        };
        let (l, acc_l) = if l % 2 == 0 { (l, acc_l) } else {
            (l + 1, tree.@_op $ (acc_l, elems.@(l)))
        };
        let (r, acc_r) = if r % 2 == 0 { (r, acc_r) } else {
            let r = r - 1;
            (r, tree.@_op $ (elems.@(r), acc_r))
        };
        continue $ (l.shift_right(1), r.shift_right(1), acc_l, acc_r)
    );
    tree.@_op $ (acc_l, acc_r)
);

// 葉`j`の祖先がまだ伝搬していない作用を、段ごとに合成した配列を作る
//
// 第`h`要素は、`j`の祖先のうち`j`から`h`段より上にあるものの作用を、深いノードから順に合成したものである。
// 浅いノードの作用ほど後から加わったものなので、`j`の`h`段上の祖先とその兄弟は、値にこの作用を適用すると最新の値になる。
_pending_above : I64 -> LDSegtree m a -> Array a;
_pending_above = |j, tree| (
    let lazy = tree.@_lazy;
    let height = 63 - j.count_leading_zeros; // jの根からの深さ
    range_step(height - 1, -1, -1).fold(fill(height + 1, tree.@_act_unit), |h, pending|
        pending.set(h, tree.@_act_op $ (lazy.@(j.shift_right(h + 1)), pending.@(h + 1)))
    )
);

// セグメント木の要素数を取得する
//
// 計算量：O(1)
//
// # Parameters
// - `tree` : セグメント木
@size : LDSegtree m a -> I64;
@size = |tree| tree.@_n;

// セグメント木の要素を取得する
//
// 制約：0 <= i < n
//
// 計算量：O(log n)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `tree` : セグメント木
@ : I64 -> LDSegtree m a -> m;
@ = |i, tree| (
    if !(0 <= i && i < tree.@_n) { undefined("[CPLib.LDSegtree::@] `i` is out of [0, n)") };
    let j = i + tree.@_n;
    // 葉jの祖先がまだ伝搬していない作用を、深いノードから順に合成する。浅いノードの作用ほど後から加わったものである。
    let lazy = tree.@_lazy;
    let a = loop((j.shift_right(1), tree.@_act_unit), |(k, a)|
        if k == 0 { break $ a };
        continue $ (k.shift_right(1), tree.@_act_op $ (a, lazy.@(k)))
    );
    tree.@_act $ (a, tree.@_elems.@(j))
);

// セグメント木の要素を設定する
//
// 制約：0 <= i < n
//
// 計算量：O(log n)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `value` : 設定する値
// - `tree` : セグメント木
set : I64 -> m -> LDSegtree m a -> LDSegtree m a;
set = |i, value, tree| (
    if !(0 <= i && i < tree.@_n) { undefined("[CPLib.LDSegtree::set] `i` is out of [0, n)") };
    let i = i + tree.@_n;
    let tree = tree._propagate_above(i);
    let tree = tree.mod__elems(set(i, value));
    tree._recalc_above(i)
);

// 1つの要素に作用を適用する
//
// `act_range(i, i + 1, a)`と同じ結果になる。
//
// 制約：0 <= i < n
//
// 計算量：O(log n)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `a` : 作用
// - `tree` : セグメント木
act_at : I64 -> a -> LDSegtree m a -> LDSegtree m a;
act_at = |i, a, tree| (
    if !(0 <= i && i < tree.@_n) { undefined("[CPLib.LDSegtree::act_at] `i` is out of [0, n)") };
    let i = i + tree.@_n;
    let tree = tree._propagate_above(i);
    // 葉は遅延作用を持たないので、値に直接作用を適用する
    let act = tree.@_act;
    let tree = tree.mod__elems(|elems| elems.set(i, act((a, elems.@(i)))));
    tree._recalc_above(i)
);

// 半開区間[l, r)にある要素の畳み込みを計算する
//
// 制約：0 <= l <= r <= n
//
// 計算量：O(log n)
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `tree` : セグメント木
fold : I64 -> I64 -> LDSegtree m a -> m;
fold = |l, r, tree| (
    if !(0 <= l && l <= r && r <= tree.@_n) { undefined("[CPLib.LDSegtree::fold] `l` and `r` do not satisfy 0 <= l <= r <= n") };
    if l == r { tree.@_unit };
    let n = tree.@_n;
    let l = l + n;
    let r = r + n;
    let elems = tree.@_elems;
    // 木を書き換えずに、読むノードの値に、祖先がまだ伝搬していない作用を適用して読む。
    // 段hで左端の側に読むノードは、葉lのh段上の祖先か、その兄弟である。どちらの祖先も、葉lの祖先のうちh段より上のものである。
    // 右端の側に読むノードも同じく、葉r - 1のh段上の祖先か、その兄弟である。
    let pending_l = tree._pending_above(l);
    let pending_r = tree._pending_above(r - 1);
    let (acc_l, acc_r) = loop((l, r, 0, tree.@_unit, tree.@_unit), |(l, r, h, acc_l, acc_r)|
        if l >= r { break $ (acc_l, acc_r) };
        let (l, acc_l) = if l % 2 == 0 { (l, acc_l) } else {
            (l + 1, tree.@_op $ (acc_l, tree.@_act $ (pending_l.@(h), elems.@(l))))
        };
        let (r, acc_r) = if r % 2 == 0 { (r, acc_r) } else {
            let r = r - 1;
            (r, tree.@_op $ (tree.@_act $ (pending_r.@(h), elems.@(r)), acc_r))
        };
        continue $ (l.shift_right(1), r.shift_right(1), h + 1, acc_l, acc_r)
    );
    tree.@_op $ (acc_l, acc_r)
);

// 半開区間[l, r)に右から作用を適用する
// 
// 制約：0 <= l <= r <= n
//
// 計算量：O(log n)
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `a` : 適用する作用
// - `tree` : セグメント木
act_range : I64 -> I64 -> a -> LDSegtree m a -> LDSegtree m a;
act_range = |l, r, a, tree| (
    if !(0 <= l && l <= r && r <= tree.@_n) { undefined("[CPLib.LDSegtree::act_range] `l` and `r` do not satisfy 0 <= l <= r <= n") };
    if l == r { tree };
    let l = l + tree.@_n;
    let r = r + tree.@_n;
    let l0 = l.shift_right(l.count_trailing_zeros);
    let r0 = r.shift_right(r.count_trailing_zeros) - 1;
    let tree = tree._propagate_above(l0);
    let tree = tree._propagate_above(r0);

    let tree = loop((l, r, tree), |(l, r, tree)|
        if l >= r { break $ tree };
        let (l, tree) = if l % 2 == 0 { (l, tree) } else {
            (l + 1, tree._apply_at(l, a))
        };
        let (r, tree) = if r % 2 == 0 { (r, tree) } else {
            let r = r - 1;
            (r, tree._apply_at(r, a))
        };
        continue $ (l.shift_right(1), r.shift_right(1), tree)
    );

    // 作用を適用したノードの祖先は、l0とr0の祖先に含まれる。
    tree._recalc_above(l0)._recalc_above(r0)
);


// すべての要素の畳み込みを計算する
//
// 計算量：O(log n)
//
// # Parameters
// - `tree` : セグメント木
fold_all : LDSegtree m a -> m;
fold_all = |tree| (
    // 値を読むノードの祖先は、要素の区間に対応しないノードなので、作用を持たない。
    let n = tree.@_n;
    tree._fold_nodes(n, n * 2)
);

// `f(fold(l, r))`が真になる最大の`r`を、木の上の二分探索で求める
//
// 制約：0 <= l <= n、`f(unit)`が真、`f`は単調（区間を右に伸ばして偽になったら、さらに伸ばしても真にならない）
//
// 計算量：O(log n)。`f`の呼び出しもO(log n)回。
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `f` : 区間の畳み込みについての条件
// - `tree` : セグメント木
//
// # Examples
// ```fix
// // 区間への加算と、区間の最大値の取得ができるセグメント木
// let tree = build([1, 2, 5, 4], minimum, |(x, y)| max(x, y), 0, |(a, b)| a + b, |(a, x)| x + a);
// let tree = tree.act_range(0, 2, 2); // [3, 4, 5, 4]
// // 区間[0, 2)の最大値は4、区間[0, 3)の最大値は5
// assert_eq(|_|"", tree.calc_max_right(0, |x| x <= 4), 2)
// ```
calc_max_right : I64 -> (m -> Bool) -> LDSegtree m a -> I64;
calc_max_right = |l, f, tree| (
    if !(0 <= l && l <= tree.@_n) { undefined("[CPLib.LDSegtree::calc_max_right] `l` is out of [0, n]") };
    let n = tree.@_n;
    if l == n { n };
    let l = l + n;
    let r = n * 2;
    let elems = tree.@_elems;
    let lazy = tree.@_lazy;
    let pending = tree._pending_above(l);

    // `fold(l, n)`が畳み込むノードを左から順に試し、`f`が偽になる最初のノードkと、kより左のノードの畳み込みacc、
    // kの祖先がまだ伝搬していない作用の合成aを求める。
    // 段hで`fold`が畳み込むノードは、lh = ceil(l / 2^h)、rh = floor(r / 2^h)として、lh < rhの段のうち、
    // 左端の側ではlh（lhが奇数のとき）、右端の側ではrh - 1（rhが奇数のとき）である。
    // これらを左から順に並べると、左端の側のノードが低い段から、続いて右端の側のノードが高い段から並ぶ。
    // 左端の側のノードlhは、葉lのh段上の祖先か、その兄弟である。どちらの祖先も、葉lの祖先のうちh段より上のものである。
    // 右端の側のノードの祖先は、要素の区間に対応しないノードなので、作用を持たない。
    // 見つからなければkは0とする。
    let (k, height, acc, a) = loop((l, r, 0, tree.@_unit), |(lh, rh, h, acc)|
        if lh >= rh { break $ (0, h, acc, tree.@_act_unit) };
        if lh % 2 == 1 {
            let a = pending.@(h);
            let next = tree.@_op $ (acc, tree.@_act $ (a, elems.@(lh)));
            if !f(next) { break $ (lh, h, acc, a) };
            continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, next)
        };
        continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, acc)
    );
    let (k, acc) = if k != 0 { (k, acc) } else {
        loop((height - 1, acc), |(h, acc)|
            if h < 0 { break $ (0, acc) };
            let rh = r.shift_right(h);
            if rh % 2 == 0 { continue $ (h - 1, acc) };
            let next = tree.@_op $ (acc, elems.@(rh - 1));
            if !f(next) { break $ (rh - 1, acc) };
            continue $ (h - 1, next)
        )
    };
    if k == 0 { n };
    // kから葉へ降りる。左の子までの畳み込みがfを満たせば右の子へ、満たさなければ左の子へ進む。
    // aは、降りた先のノードの祖先がまだ伝搬していない作用の合成である。
    loop((k, acc, a), |(k, acc, a)|
        if k >= n { break $ k - n };
        let a = tree.@_act_op $ (lazy.@(k), a);
        let next = tree.@_op $ (acc, tree.@_act $ (a, elems.@(k * 2)));
        if f(next) { continue $ (k * 2 + 1, next, a) } else { continue $ (k * 2, acc, a) }
    )
);

// `f(fold(l, r))`が真になる最小の`l`を、木の上の二分探索で求める
//
// 制約：0 <= r <= n、`f(unit)`が真、`f`は単調（区間を左に伸ばして偽になったら、さらに伸ばしても真にならない）
//
// 計算量：O(log n)。`f`の呼び出しもO(log n)回。
//
// # Parameters
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `f` : 区間の畳み込みについての条件
// - `tree` : セグメント木
//
// # Examples
// ```fix
// // 区間への加算と、区間の最大値の取得ができるセグメント木
// let tree = build([1, 2, 5, 4], minimum, |(x, y)| max(x, y), 0, |(a, b)| a + b, |(a, x)| x + a);
// let tree = tree.act_range(0, 2, 2); // [3, 4, 5, 4]
// // 区間[3, 4)の最大値は4、区間[2, 4)の最大値は5
// assert_eq(|_|"", tree.calc_min_left(4, |x| x <= 4), 3)
// ```
calc_min_left : I64 -> (m -> Bool) -> LDSegtree m a -> I64;
calc_min_left = |r, f, tree| (
    if !(0 <= r && r <= tree.@_n) { undefined("[CPLib.LDSegtree::calc_min_left] `r` is out of [0, n]") };
    let n = tree.@_n;
    if r == 0 { 0 };
    let l = n;
    let r = r + n;
    let elems = tree.@_elems;
    let lazy = tree.@_lazy;
    let pending = tree._pending_above(r - 1);

    // `fold(0, r)`が畳み込むノードを右から順に試し、`f`が偽になる最初のノードkと、kより右のノードの畳み込みacc、
    // kの祖先がまだ伝搬していない作用の合成aを求める。
    // 段hで`fold`が畳み込むノードは、lh = ceil(l / 2^h)、rh = floor(r / 2^h)として、lh < rhの段のうち、
    // 左端の側ではlh（lhが奇数のとき）、右端の側ではrh - 1（rhが奇数のとき）である。
    // これらを右から順に並べると、右端の側のノードが低い段から、続いて左端の側のノードが高い段から並ぶ。
    // 右端の側のノードrh - 1は、葉r - 1のh段上の祖先か、その兄弟である。どちらの祖先も、葉r - 1の祖先のうちh段より上のものである。
    // 左端の側のノードの祖先は、要素の区間に対応しないノードなので、作用を持たない。
    // 見つからなければkは0とする。
    let (k, height, acc, a) = loop((l, r, 0, tree.@_unit), |(lh, rh, h, acc)|
        if lh >= rh { break $ (0, h, acc, tree.@_act_unit) };
        if rh % 2 == 1 {
            let a = pending.@(h);
            let next = tree.@_op $ (tree.@_act $ (a, elems.@(rh - 1)), acc);
            if !f(next) { break $ (rh - 1, h, acc, a) };
            continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, next)
        };
        continue $ ((lh + 1).shift_right(1), rh.shift_right(1), h + 1, acc)
    );
    let (k, acc) = if k != 0 { (k, acc) } else {
        loop((height - 1, acc), |(h, acc)|
            if h < 0 { break $ (0, acc) };
            let lh = (l + 1.shift_left(h) - 1).shift_right(h);
            if lh % 2 == 0 { continue $ (h - 1, acc) };
            let next = tree.@_op $ (elems.@(lh), acc);
            if !f(next) { break $ (lh, acc) };
            continue $ (h - 1, next)
        )
    };
    if k == 0 { 0 };
    // kから葉へ降りる。右の子からの畳み込みがfを満たせば左の子へ、満たさなければ右の子へ進む。
    // aは、降りた先のノードの祖先がまだ伝搬していない作用の合成である。
    loop((k, acc, a), |(k, acc, a)|
        if k >= n { break $ k + 1 - n };
        let a = tree.@_act_op $ (lazy.@(k), a);
        let next = tree.@_op $ (tree.@_act $ (a, elems.@(k * 2 + 1)), acc);
        if f(next) { continue $ (k * 2, next, a) } else { continue $ (k * 2 + 1, acc, a) }
    )
);
