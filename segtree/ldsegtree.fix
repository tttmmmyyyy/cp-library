// モノイド構造および作用が動的に決められる遅延伝搬セグメント木
//
// コンストラクタでモノイドおよび作用を指定する点以外は、`CPLib.LSegtree`と同じです。
// モノイド構造・作用が静的に決まる場合は`CPLib.LSegtree`の方が高速です。
//
// 制約・計算量の n は要素数です。計算量は`op`, `act_op`, `act`がO(1)で動くとしたものです。
//
// 制約：作用は次を満たす（`x`, `y`は値、`a`, `b`は作用）
// - act(x, act_unit) = x
// - act(op(x, y), a) = op(act(x, a), act(y, a))
// - act(x, act_op(a, b)) = act(act(x, a), b)
//
// # Examples
// ```fix
// // 区間への加算と、区間の最大値の取得ができるセグメント木
// let tree = build(
//     [1, 2, 3],
//     minimum, |(x, y)| max(x, y), // 値モノイド：最大値
//     0, |(a, b)| a + b,                // 作用モノイド：加法
//     |(x, a)| x + a                    // 作用：加算
// );
// let tree = tree.act_range(0, 2, 10); // [11, 12, 3]
// let (_, res) = tree.fold(1, 3);
// assert_eq(|_|"", res, 12)
// ```
module CPLib.LDSegtree;

import Std::{
    loop, Array, I64, Array::{fill, set, @, @size}, I64::{bit_and, shift_right}, 
    Iterator::{fold, range, range_step}, LoopState::{break, continue}
};

// 遅延伝搬セグメント木の型。
// 
// パラメータ`m`は「値」となるモノイドの型、`a`は「右作用」するモノイドの型。
type LDSegtree m a = struct {
    // 要素数
    n : I64,
    // 値モノイドの単位元
    unit : m,
    // 値モノイドの演算子
    op : (m, m) -> m,
    // 作用モノイドの単位元
    act_unit : a,
    // 作用モノイドの演算子
    act_op : (a, a) -> a,
    // 右作用
    act : (m, a) -> m,
    // 値の配列
    // 
    // 1-indexedで運用する：長さは`2n`、第0インデックスは使用しない。
    elems : Array m,
    // 遅延されている作用の配列
    // 
    // 1-indexedで運用する：長さは`2n`、第0インデックスは使用しない。
    lazy : Array a,
};

// すべての要素が単位元であるような遅延伝搬セグメント木を作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `n` : セグメント木の要素数
// - `unit` : 値モノイドの単位元
// - `op` : 値モノイドの演算子
// - `act_unit` : 作用モノイドの単位元
// - `act_op` : 作用モノイドの演算子
// - `act` : 右作用
init : I64 -> m -> ((m, m) -> m) -> a -> ((a, a) -> a) -> ((m, a) -> m) -> LDSegtree m a;
init = |n, unit, op, act_unit, act_op, act| (
    let elems = Array::fill(n * 2, unit);
    let lazy = Array::fill(n * 2, act_unit);
    LDSegtree { elems : elems, lazy : lazy, n : n, unit : unit, op : op, act_unit : act_unit, act_op : act_op, act : act }
);

// 要素の配列からセグメント木を作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `elems` : セグメント木の要素を格納する配列
// - `unit` : 値モノイドの単位元
// - `op` : 値モノイドの演算子
// - `act_unit` : 作用モノイドの単位元
// - `act_op` : 作用モノイドの演算子
// - `act` : 右作用
build : Array m -> m -> ((m, m) -> m) -> a -> ((a, a) -> a) -> ((m, a) -> m) -> LDSegtree m a;
build = |elems, unit, op, act_unit, act_op, act| (
    let n = elems.@size;
    let lazy = Array::fill(n * 2, act_unit) : Array a;
    let tree = Array::fill(n * 2, unit) : Array m;
    // [n, 2n)に要素をセット
    let tree = range(0, n).fold(tree, |i, tree| tree.set(n + i, elems.@(i)) );
    // [1, n)の範囲を計算
    let tree = range_step(n-1, 0, -1).fold(tree, |i, tree|
        let left = tree.@(i * 2);
        let right = tree.@(i * 2 + 1);
        tree.set(i, op $ (left, right))
    );
    LDSegtree { elems : tree, lazy : lazy, n : n, unit : unit, op : op, act_unit : act_unit, act_op : act_op, act : act }
);

// 内部配列のノードiより上において作用を伝搬させる。
// 
// ルートから指定されたノードiの一つ上までの各ノードについて、そのノードの値に遅延されている作用を適用し、
// その作用を子ノードに渡して、ノードの作用を単位元に戻す。
_propagate_above : I64 -> LDSegtree m a -> LDSegtree m a;
_propagate_above = |i, tree| (
    let bit_length = loop((i, 0), |(i, n)| if i == 0 { break $ n } else { continue $ (i / 2, n + 1) });
    let height = bit_length - 1;
    let act = tree.@act;
    let act_op = tree.@act_op;
    let act_unit = tree.@act_unit;
    // 書き換える配列は木から抜き出し、木には空の配列を置く。抜き出した配列は木と共有されないので、書き換えても複製されない
    let (elems, tree) = tree.act_elems(|x| (x, []));
    let (lazy, tree) = tree.act_lazy(|x| (x, []));
    let (elems, lazy) = range_step(height, 0, -1).fold((elems, lazy), |h, (elems, lazy)|
        let j = i.shift_right(h); // iからh個親のノード
        let a = lazy.@(j);
        let elems = elems.set(j, act((elems.@(j), a)));
        let lazy = lazy.set(j * 2, act_op((lazy.@(j * 2), a)));
        let lazy = lazy.set(j * 2 + 1, act_op((lazy.@(j * 2 + 1), a)));
        let lazy = lazy.set(j, act_unit);
        (elems, lazy)
    );
    tree.set_elems(elems).set_lazy(lazy)
);

// 内部配列のノードiより上の部分の値を再計算する
// 
// 作用の単位元へのリセットは行わないので、非自明な作用がついているノードあるいはその子ノードに対して呼び出してはならない。
_recalc_above : I64 -> LDSegtree m a -> LDSegtree m a;
_recalc_above = |i, tree| (
    let act = tree.@act;
    let op = tree.@op;
    let (elems, tree) = tree.act_elems(|x| (x, []));
    let lazy = tree.@lazy;
    let elems = loop((i, elems), |(i, elems)|
        if i <= 1 { break $ elems }; // ルートノードに到達したら終了
        let i = i / 2; // 親ノードに移動
        let l = act((elems.@(i * 2), lazy.@(i * 2)));
        let r = act((elems.@(i * 2 + 1), lazy.@(i * 2 + 1)));
        continue $ (i, elems.set(i, op((l, r))))
    );
    tree.set_elems(elems)
);

// セグメント木の要素を設定する
//
// 制約：0 <= i < n
//
// 計算量：O(log n)
//
// # Parameters
// - `i` : インデックス（0-indexed）
// - `value` : 設定する値
// - `tree` : セグメント木
set : I64 -> m -> LDSegtree m a -> LDSegtree m a;
set = |i, value, tree| (
    let act_unit = tree.@act_unit;

    let i = i + tree.@n;
    // iの祖先ノードで作用伝搬を実行しておく（iの直上の「周辺」に遅延作用を散らすのが目的）
    let tree = tree._propagate_above(i);
    // ノードiの値を設定し、作用を単位元に戻す
    let tree = tree.mod_elems(set(i, value));
    let tree = tree.mod_lazy(set(i, act_unit));
    // iの親ノードをすべて再計算
    tree._recalc_above(i)
);

// 半開区間[l, r)にある要素の畳み込みを計算する
// 
// 遅延作用の伝搬が行われるので、ツリー自体も更新される。
//
// 制約：0 <= l <= r <= n
//
// 計算量：O(log n)
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `tree` : セグメント木
fold : I64 -> I64 -> LDSegtree m a -> (LDSegtree m a, m);
fold = |l, r, tree| (
    if l == r { (tree, tree.@unit) };
    let l = l + tree.@n;
    let r = r + tree.@n;
    // l0 = lが奇数になるまで2で割ったもの。
    // これは下の「区間積を計算」のセクションで初めて値を読むインデックスである。
    let l0 = l / (l.bit_and(-l));
    // r0も「区間積を計算」のセクションで初めて値を読むインデックス。
    let r0 = r / (r.bit_and(-r)) - 1;
    // これらより親の部分で作用伝搬させておけばよい。
    let tree = tree._propagate_above(l0);
    let tree = tree._propagate_above(r0);

    // 区間積を計算
    let op = tree.@op;
    let act = tree.@act;
    let elems = tree.@elems;
    let lazy = tree.@lazy;
    let (acc_l, acc_r) = loop((l, r, tree.@unit, tree.@unit), |(l, r, acc_l, acc_r)|
        if l >= r {
            break $ (acc_l, acc_r)
        };
        let (l, acc_l) = if l % 2 == 0 { (l, acc_l) } else {
            let acc_l = op((acc_l, act((elems.@(l), lazy.@(l)))));
            (l + 1, acc_l)
        };
        let (r, acc_r) = if r % 2 == 0 { (r, acc_r) } else {
            let r = r - 1;
            let acc_r = op((act((elems.@(r), lazy.@(r))), acc_r));
            (r, acc_r)
        };
        continue $ (l / 2, r / 2, acc_l, acc_r)
    );

    (tree, tree.@op $ (acc_l, acc_r))
);

// 半開区間[l, r)に右から作用を適用する
// 
// 制約：0 <= l <= r <= n
//
// 計算量：O(log n)
//
// # Parameters
// - `l` : 区間の左端 (0-indexed)
// - `r` : 区間の右端 (0-indexed, exclusive)
// - `a` : 適用する作用
// - `tree` : セグメント木
act_range : I64 -> I64 -> a -> LDSegtree m a -> LDSegtree m a;
act_range = |l, r, a, tree| (
    if l == r { tree };
    let l = l + tree.@n;
    let r = r + tree.@n;
    let l0 = l / (l.bit_and(-l));
    let r0 = r / (r.bit_and(-r)) - 1;
    let tree = tree._propagate_above(l0);
    let tree = tree._propagate_above(r0);

    let act_op = tree.@act_op;
    let (lazy, tree) = tree.act_lazy(|x| (x, []));
    let lazy = loop((l, r, lazy), |(l, r, lazy)|
        if l >= r { break $ lazy };
        let (l, lazy) = if l % 2 == 0 { (l, lazy) } else {
            (l + 1, lazy.set(l, act_op((lazy.@(l), a)))) // 右作用
        };
        let (r, lazy) = if r % 2 == 0 { (r, lazy) } else {
            let r = r - 1;
            (r, lazy.set(r, act_op((lazy.@(r), a)))) // 右作用
        };
        continue $ (l / 2, r / 2, lazy)
    );
    let tree = tree.set_lazy(lazy);

    tree._recalc_above(l0)._recalc_above(r0)
);