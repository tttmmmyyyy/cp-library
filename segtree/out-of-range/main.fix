// 標準入力で選んだ木に、範囲外の添字か不正な区間を渡す。
// 1つ目の数で木を選ぶ。0：Segtree、1：DSegtree、2：LSegtree、3：LDSegtree
// 2つ目の数で操作を選ぶ。0：@(-1)、1：set(-1)、2：fold(2, 1)、3：calc_max_right(4)、4：calc_min_left(-1)、5：act_range(-1, 2)（遅延木のみ）、6：act_at(-1)（遅延木のみ）、7：fold(0, 3)（範囲内）
module Main;

import CPLib.DSegtree::{@, build, calc_max_right, calc_min_left, fold, fold_all, set};
import CPLib.IO::read_i;
import CPLib.LDSegtree::{@, act_at, act_range, build, calc_max_right, calc_min_left, fold, fold_all, set};
import CPLib.LSegtree::{@, act_at, act_range, build, calc_max_right, calc_min_left, fold, fold_all, set, LSegtree};
import CPLib.Monoid::{Max, RangeAdd, Sum, Max::@v, Sum::@v};
import CPLib.Segtree::{@, build, calc_max_right, calc_min_left, fold, fold_all, set, Segtree};
import Std::{I64, IO, Functor::map, I64::minimum, IO::println, LessThan::max, ToString::to_string, Tuple2::@1};

main : IO ();
main = (
    let tree_kind = *read_i;
    let op = *read_i;
    let elems = [1, 2, 3];
    let res = if tree_kind == 0 {
        let tree = Segtree::build(elems.map(|v| Sum { v })) : Segtree (Sum I64);
        if op == 0 { tree.@(-1).@v };
        if op == 1 { tree.set(-1, Sum { v : 0 }).fold_all.@v };
        if op == 2 { tree.fold(2, 1).@v };
        if op == 3 { tree.calc_max_right(4, |_| true) };
        if op == 4 { tree.calc_min_left(-1, |_| true) };
        tree.fold(0, 3).@v
    } else if tree_kind == 1 {
        let tree = DSegtree::build(elems, 0, |(x, y)| x + y);
        if op == 0 { tree.@(-1) };
        if op == 1 { tree.set(-1, 0).fold_all };
        if op == 2 { tree.fold(2, 1) };
        if op == 3 { tree.calc_max_right(4, |_| true) };
        if op == 4 { tree.calc_min_left(-1, |_| true) };
        tree.fold(0, 3)
    } else if tree_kind == 2 {
        let tree = LSegtree::build(elems.map(|v| Max { v })) : LSegtree (Max I64) (RangeAdd Max I64);
        if op == 0 { tree.@(-1).@v };
        if op == 1 { tree.set(-1, Max { v : 0 }).fold_all.@v };
        if op == 2 { tree.fold(2, 1).@v };
        if op == 3 { tree.calc_max_right(4, |_| true) };
        if op == 4 { tree.calc_min_left(-1, |_| true) };
        if op == 5 { tree.act_range(-1, 2, RangeAdd { a : 10 }).fold_all.@v };
        if op == 6 { tree.act_at(-1, RangeAdd { a : 10 }).fold_all.@v };
        tree.fold(0, 3).@v
    } else {
        let tree = LDSegtree::build(elems, I64::minimum, |(x, y)| max(x, y), 0, |(a, b)| a + b, |(a, x)| a + x);
        if op == 0 { tree.@(-1) };
        if op == 1 { tree.set(-1, 0).fold_all };
        if op == 2 { tree.fold(2, 1) };
        if op == 3 { tree.calc_max_right(4, |_| true) };
        if op == 4 { tree.calc_min_left(-1, |_| true) };
        if op == 5 { tree.act_range(-1, 2, 10).fold_all };
        if op == 6 { tree.act_at(-1, 10).fold_all };
        tree.fold(0, 3)
    };
    println(res.to_string)
);
