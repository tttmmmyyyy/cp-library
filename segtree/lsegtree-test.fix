module CPLib.LSegtree.Test;

import CPLib.Arithmetic::pmod;
import CPLib.LSegtree::{act_range, build, calc_max_right, calc_min_left, fold, fold_all, init, set, @, LSegtree};
import CPLib.Trait::{Action, Monoid, Action::act, Monoid::{op, unit}};
import Random::{generate_I64_nonneg, init_by_seed, Random};
import Std::{
    Bool, Eq, I64, IO, String, ToString, Array::{fill, push_back, set, @}, 
    Debug::{assert_eq, consumed_time_while_lazy}, FromBytes::from_bytes, Functor::map, I64::minimum, IO::println, 
    Iterator::{fold, fold_m, map, range, to_array}, Array::{to_iter, @size}, LessThan::{max, min}, Monad::pure, Result::as_ok, 
    String::{from_U8, get_bytes, get_sub, populate, @size}, ToI64::i64, ToString::to_string, 
    ToU8::u8
};

// https://atcoder.jp/contests/language-test-202505/submissions/68392811
// https://atcoder.jp/contests/language-test-202505/submissions/68392957

test : IO ();
test = (
    let rng = Random::init_by_seed(0_U64);
    let rng = *test_random(false, 100, 1000, rng);
    let rng = *test_random(true, 100, 1000, rng);
    let rng = *range(1, 18).fold_m(rng, |n, rng|
        let rng = *test_random(false, n, 200, rng);
        test_random(true, n, 200, rng)
    );
    test_empty;;
    let rng = *test_search(rng);
    let _ = *test_search_large(rng);

    test_speed;;

    pure()
);

// 文字列の結合に関するモノイド
type StrConcat = struct { v : String };
namespace StrConcat {
    make : String -> StrConcat = |v| StrConcat { v };
}
impl StrConcat : Monoid {
    unit = make("");
    op = |lhs, rhs| make $ lhs.@v + rhs.@v;
}
impl StrConcat : Eq {
    eq = |lhs, rhs| lhs.@v == rhs.@v;
}
impl StrConcat : ToString {
    to_string = |a| a.@v;
}

// 文字ごとにアフィン変換（mod 26）を行うモノイド
type ShiftAlphabet = struct { a : I64, b : I64 };
namespace ShiftAlphabet {
    make : I64 -> I64 -> ShiftAlphabet;
    make = |a, b| ShiftAlphabet { a : a.pmod(26), b : b.pmod(26) };
}
impl ShiftAlphabet : Monoid {
    unit = make(1, 0);
    op = |lhs, rhs| (
        let a = lhs.@a;
        let b = lhs.@b;
        let c = rhs.@a;
        let d = rhs.@b;
        // lhs(x) = ax + b, rhs(x) = cx + d,
        // x・lhs・rhs = rhs(lhs(x)) = c(ax + b) + d = cax + cb + d
        let e = (c * a).pmod(26);
        let f = (c * b + d).pmod(26);
        make(e, f)
    );
}
impl ShiftAlphabet : ToString {
    to_string = |a| "({}, {})".populate([a.@a.to_string, a.@b.to_string]);
}

// 作用の定義
impl ShiftAlphabet : Action {
    type Set ShiftAlphabet = StrConcat;
    act = |a, s| (
        let bytes = s.@v.get_bytes;
        let bytes = bytes.map(|x| 
            if x == '\0' { x }; // ヌル文字は変換しない
            let x = (x - 'a').i64;
            let x = (a.@a * x + a.@b).pmod(26);
            let x = x.u8 + 'a';
            x
        );
        let s = bytes.from_bytes.as_ok;
        StrConcat::make(s)
    );
}

// 最大値モノイド
type I64Max = struct { v : I64 };
namespace I64Max {
    make : I64 -> I64Max = |v| I64Max { v };
}
impl I64Max : Monoid {
    unit = make(I64::minimum);
    op = |lhs, rhs| make $ lhs.@v.max(rhs.@v);
}

// 加法モノイド
type I64Add = struct { v : I64 };
namespace I64Add {
    make : I64 -> I64Add = |v| I64Add { v };
}
impl I64Add : Monoid {
    unit = make(0);
    op = |lhs, rhs| make $ lhs.@v + rhs.@v;
}

// 加法モノイドの最大値モノイドに対する作用
impl I64Add : Action {
    type Set I64Add = I64Max; // 作用を受ける集合の型
    act = |a, x| I64Max::make(x.@v + a.@v);
}

// ランダムな数文字のアルファベット文字列を生成する
gen_random_alphabetical_string : Random -> (Random, String);
gen_random_alphabetical_string = |rng| (
    let (rng, len) = rng.generate_I64_nonneg;
    let len = len % 6; // 0～5文字
    let (bytes, rng) = range(0, len).fold(([], rng), |_, (bytes, rng)|
        let (rng, c) = rng.generate_I64_nonneg;
        let c = (c % 26).u8 + 'a';
        let bytes = bytes.push_back(c);
        (bytes, rng)
    );
    let bytes = bytes.push_back('\0');
    let s = bytes.from_bytes.as_ok;
    (rng, s)
);

// 要素数0の木で、空区間への作用と畳み込みができる
test_empty : IO ();
test_empty = (
    let tree = LSegtree::init(0) : LSegtree StrConcat ShiftAlphabet;
    let tree = tree.act_range(0, 0, ShiftAlphabet::make(3, 1));
    let (_, v) = tree.fold(0, 0);
    assert_eq(|_|"lsegtree empty", v, StrConcat::make(""))
);

// n要素のセグメント木に対してランダムな操作をops回行い、foldの結果を愚直な計算と比べる
//
// # Parameters
// - `is_build` : セグメント木をbuildで構築するかどうか。そうでないときはinitで構築する
// - `n` : 要素数
// - `ops` : 操作の回数
// - `rng` : 乱数生成器
test_random : Bool -> I64 -> I64 -> Random -> IO Random;
test_random = |is_build, n, ops, rng| (

    let (tree, arr) = if !is_build {
        let arr = fill(n, StrConcat::make(""));
        (LSegtree::init(n), arr)
    } else {
        let arr = range(0, n).map(|i| 
            let v = String::from_U8('a' + (i % 26).u8);
            StrConcat::make(v)
        ).to_array;
        (LSegtree::build(arr), arr)
    };

    let (_1, _2, rng) = *range(0, ops).fold_m((tree, arr, rng), |_, (tree, arr, rng)|
        let (rng, dice) = rng.generate_I64_nonneg;
        let dice = dice % 2;
        let (tree, arr, rng) = *if dice == 0 {
            // setによる更新
            let (rng, i) = rng.generate_I64_nonneg;
            let i = i % n;
            let (rng, v) = rng.gen_random_alphabetical_string;
            let v = StrConcat::make(v);
            let tree = tree.set(i, v);
            let arr = arr.set(i, v);
            pure $ (tree, arr, rng)
        } else {
            // 範囲作用による更新
            let (rng, l) = rng.generate_I64_nonneg;
            let (rng, r) = rng.generate_I64_nonneg;
            let l = l % n;
            let r = l + r % (n - l + 1);
            let (rng, a) = rng.generate_I64_nonneg;
            let (rng, b) = rng.generate_I64_nonneg;
            let a = ShiftAlphabet::make(a, b);
            let tree = tree.act_range(l, r, a);
            let arr = range(l, r).fold(arr, |i, arr| arr.set(i, act(a, arr.@(i))));
            pure $ (tree, arr, rng)
        };

        // すべての要素を@で読む
        range(0, n).fold_m((), |i, _| assert_eq(|_|"lsegtree at", tree.@(i), arr.@(i)));;

        // foldを実行
        let (rng, l) = rng.generate_I64_nonneg;
        let (rng, r) = rng.generate_I64_nonneg;
        let l = l % n;
        let r = l + r % (n - l + 1);
        let (tree, v) = tree.fold(l, r);
        let w = range(l, r).fold(Monoid::unit, |i, acc| Monoid::op(acc, arr.@(i)));
        assert_eq(|_|"lsegtree random", v, w);;

        pure $ (tree, arr, rng)
    );

    pure $ rng
);

test_speed : IO ();
test_speed = (
    // n=10^5個の要素を持つSegtreeを生成し、n回程度ランダムにクエリを投げる。
    // もしn^2実装になっていたらこのテストは終わらない。
    let n = 1e5;
    let rng = Random::init_by_seed(0_U64);
    let tree = LSegtree::init(n) : LSegtree I64Max I64Add;
    let ((tree, rng, fold_sum, search_ok), time) = consumed_time_while_lazy(|_| range(0, n).fold((tree, rng, 0, true), |_, (tree, rng, fold_sum, search_ok)| (
        // set
        let (rng, i) = rng.generate_I64_nonneg;
        let (rng, v) = rng.generate_I64_nonneg;
        let i = i % n; // 0 <= i < n
        let v = v % 1e9; // 0 <= v < 10^9。作用を足し合わせても I64 に収まる
        let tree = tree.set(i, I64Max::make(v));

        // act_range
        let (rng, l) = rng.generate_I64_nonneg;
        let (rng, r) = rng.generate_I64_nonneg;
        let l = l % n; // 0 <= l < n
        let r = l + r % (n - l + 1);
        let (rng, a) = rng.generate_I64_nonneg;
        let a = a % 1e9; // 0 <= a < 10^9
        let tree = tree.act_range(l, r, I64Add::make(a));

        // fold
        let (rng, k) = rng.generate_I64_nonneg;
        let (rng, l) = rng.generate_I64_nonneg;
        let k = k % n; // 0 <= k < n
        let l = l % n; // 0 <= l < n
        let (k, l) = if k <= l { (k, l) } else { (l, k) };
        let (tree, v) = tree.fold(k, l);

        let fold_sum = fold_sum.max(v.@v);

        // calc_max_right, calc_min_left（区間[k, l)の最大値を超える要素を探す。あるとしても区間の外側である）
        let search_ok = search_ok && tree.calc_max_right(k, |x| x.@v <= v.@v) >= l && tree.calc_min_left(l, |x| x.@v <= v.@v) <= k;

        (tree, rng, fold_sum, search_ok)
    )));
    assert_eq(|_|"test_speed", fold_sum, 18331863592552);;
    assert_eq(|_|"test_speed search", search_ok, true);;
    println $ "[CPLib.LSegtree.Test] LSegtree({}): {}".populate([n.to_string, time.to_string]);;

    pure $ ()
);

// fold_all、calc_max_right、calc_min_leftが、文書の条件を満たす値を返すことのテスト
//
// 要素数0から20の木にランダムな区間への作用を重ねていき、作用のたびに、すべての端について調べる。
// 条件には、文字が昇順に並んでいることと、長さが3以下であることを使う。
test_search : Random -> IO Random;
test_search = |rng| (
    range(0, 21).fold_m(rng, |n, rng|
        let (rng, arr) = range(0, n).fold((rng, []), |_, (rng, arr)|
            let (rng, c) = rng.generate_I64_nonneg;
            (rng, arr.push_back(String::from_U8('a' + (c % 4).u8)))
        );
        let tree = LSegtree::build(arr.map(StrConcat::make)) : LSegtree StrConcat ShiftAlphabet;
        let (_1, _2, rng) = *range(0, 10).fold_m((tree, arr, rng), |_, (tree, arr, rng)|
            let (rng, l) = rng.generate_I64_nonneg;
            let (rng, r) = rng.generate_I64_nonneg;
            let l = l % (n + 1);
            let r = l + r % (n - l + 1);
            let (rng, a) = rng.generate_I64_nonneg;
            let (rng, b) = rng.generate_I64_nonneg;
            let a = ShiftAlphabet::make(a % 2 * 2 + 1, b % 3);
            let tree = tree.act_range(l, r, a);
            let arr = range(l, r).fold(arr, |i, arr| arr.set(i, act(a, StrConcat::make(arr.@(i))).@v));

            let naive = |(l, r)| range(l, r).fold("", |i, acc| acc + arr.@(i));
            assert_eq(|_|"lsegtree fold_all", tree.fold_all.@v, naive((0, n)));;
            let conds = [|x| is_sorted(x), |x| x.@size <= 3];
            conds.to_iter.fold_m((), |f, _|
                range(0, n + 1).fold_m((), |e, _|
                    let r = tree.calc_max_right(e, |x| f(x.@v));
                    assert_eq(|_|"lsegtree calc_max_right range", e <= r && r <= n, true);;
                    assert_eq(|_|"lsegtree calc_max_right true", r == e || f(naive((e, r))), true);;
                    assert_eq(|_|"lsegtree calc_max_right false", r == n || !f(naive((e, r + 1))), true);;
                    let l = tree.calc_min_left(e, |x| f(x.@v));
                    assert_eq(|_|"lsegtree calc_min_left range", 0 <= l && l <= e, true);;
                    assert_eq(|_|"lsegtree calc_min_left true", l == e || f(naive((l, e))), true);;
                    assert_eq(|_|"lsegtree calc_min_left false", l == 0 || !f(naive((l - 1, e))), true)
                )
            );;
            pure $ (tree, arr, rng)
        );
        pure $ rng
    )
);

// 大きい木で、calc_max_rightとcalc_min_leftが返す端を、条件から決まる端と比べるテスト
//
// 条件は「畳み込みの長さがt以下で、端から先の全要素を連結した文字列の先頭（calc_min_leftでは、端より前の末尾）に一致する」とする。
// 高い段のノードの値と、その祖先に残る作用が正しく使われることを確かめるためである。
test_search_large : Random -> IO Random;
test_search_large = |rng| (
    [300, 513].to_iter.fold_m(rng, |n, rng|
        let arr = range(0, n).map(|i| String::from_U8('a' + (i * 7 % 26).u8)).to_array;
        let tree = LSegtree::build(arr.map(StrConcat::make)) : LSegtree StrConcat ShiftAlphabet;
        let (_1, _2, rng) = *range(0, 30).fold_m((tree, arr, rng), |_, (tree, arr, rng)|
            let (rng, l) = rng.generate_I64_nonneg;
            let (rng, r) = rng.generate_I64_nonneg;
            let l = l % (n + 1);
            let r = l + r % (n - l + 1);
            let (rng, a) = rng.generate_I64_nonneg;
            let (rng, b) = rng.generate_I64_nonneg;
            let a = ShiftAlphabet::make(a, b);
            let tree = tree.act_range(l, r, a);
            let arr = range(l, r).fold(arr, |i, arr| arr.set(i, act(a, StrConcat::make(arr.@(i))).@v));

            let whole = range(0, n).fold("", |i, acc| acc + arr.@(i));
            let rng = *range(0, 20).fold_m(rng, |_, rng|
                let (rng, e) = rng.generate_I64_nonneg;
                let (rng, t) = rng.generate_I64_nonneg;
                let e = e % (n + 1);
                let t = t % (n + 1);
                let after = whole.get_sub(e, n);
                let r = tree.calc_max_right(e, |x| x.@v.@size <= t && after.get_sub(0, x.@v.@size) == x.@v);
                assert_eq(|_|"lsegtree calc_max_right large", r, min(n, e + t));;
                let before = whole.get_sub(0, e);
                let l = tree.calc_min_left(e, |x| x.@v.@size <= t && before.get_sub(e - x.@v.@size, e) == x.@v);
                assert_eq(|_|"lsegtree calc_min_left large", l, max(0, e - t));;
                pure $ rng
            );
            pure $ (tree, arr, rng)
        );
        pure $ rng
    )
);

// 文字列の文字が昇順に並んでいるか
is_sorted : String -> Bool;
is_sorted = |s| (
    let bytes = s.get_bytes;
    range(1, s.@size).fold(true, |i, sorted| sorted && bytes.@(i - 1) <= bytes.@(i))
);
