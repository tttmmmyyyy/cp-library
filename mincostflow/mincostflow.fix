// 最小費用流問題
//
// 制約・計算量の n は頂点数、m は辺数を表します。
//
// # Examples
// ```fix
// // 容量とコストを指定した辺を張る
// let g = create(3);
// let g = g.add_edge(0, 1, 2, 1).add_edge(1, 2, 1, 1);
// let (g, e02) = g.add_edge_id(0, 2, 1, 5);
// // 頂点0から頂点2へ流すと、流量2（0->1->2と0->2に1ずつ）、コスト2 + 5 = 7
// let (g, flow, cost) = g.maximize_flow_min_cost(0, 2);
// assert_eq(|_|"", (flow, cost), (2, 7));;
// assert_eq(|_|"", g.get_flow(e02), 1)
// ```
module CPLib.MinCostFlow;

import BinaryHeap::{BinaryHeap::{get_size, get_top, pop, push}, MinBinaryHeap::empty};
import CPLib.Graph::{_NodeDistance, _NodeDistance::make};
import Std::{
    loop, undefined, Array, I64, Array::{@, @size, fill, mod, pop_back, push_back, set, to_iter}, 
    I64::{abs, bit_xor, maximum, minimum}, Indexable::ixchg, Iterator::{fold, map, range, to_array}, 
    LessThan::{max, min}, LoopState::{break, continue}, Option::as_some, Tuple2::{@0, @1}
};

// 最小費用流問題のグラフの型
//
// 容量とコストは`I64`で表す。
//
// `maximize_flow_min_cost`、`maximize_flow_min_cost_with_limit`、`maximize_flow_min_cost_slope`、`maximize_flow_min_cost_slope_with_limit`の制約：
// - 0 <= s, t < n, s != t
// - 負の閉路がない：容量が正の辺をたどる閉路で、コストの和が負のものがない。
//   流した後に辺を足してから再度流すときは、流れている辺の逆向き（コストの符号を反転した辺）も閉路に含める。
//   `s`から届く負の閉路があると、理由を標準エラー出力に出力してプログラムを終了する
// - 辺のコストの絶対値の最大をCとして、n * C <= 5e17
// - 容量の総和と、容量 * |コスト| の総和が、どちらも4e18以下
type MinCostFlowGraph = struct {
    // 頂点数
    _n : I64,
    // 内部の辺ごとの行き先の頂点。k番目に足した辺を内部の辺2kで、その逆辺を内部の辺2k + 1で表す
    _to : Array I64,
    // 内部の辺ごとの残余容量。k番目に足した辺の逆辺の残余容量は、その辺に流れている量に等しい
    _cap : Array I64,
    // 足した辺ごとのコスト。逆辺のコストは、その符号を反転したもの
    _cost : Array I64,
};

// 最小費用流問題のグラフの辺の番号
//
// `add_edge`と`add_edge_id`で足した辺に、足した順に0から振られる。足した辺がm本なら、番号は0以上m未満である。
type MinCostFlowEdgeId = I64;

// 最小費用流問題のグラフの辺の状態
type MinCostFlowEdge = struct {
    // 始点の頂点番号
    from : I64,
    // 終点の頂点番号
    to : I64,
    // 容量
    cap : I64,
    // 流れている量
    flow : I64,
    // 流量1あたりのコスト
    cost : I64,
};

namespace MinCostFlowGraph {
    // 辺のないグラフを作成する
    //
    // 計算量：O(1)
    //
    // # Parameters
    // - `n` : 頂点数
    create : I64 -> MinCostFlowGraph;
    create = |n| MinCostFlowGraph { _n : n, _to : [], _cap : [], _cost : [] };

    // グラフに辺を追加する
    //
    // 制約：0 <= from, to < n, cap >= 0。costは負でもよい（負の閉路については、型`MinCostFlowGraph`の説明にある、`maximize_flow_min_cost`、`maximize_flow_min_cost_with_limit`、`maximize_flow_min_cost_slope`、`maximize_flow_min_cost_slope_with_limit`の制約を見よ）
    //
    // 計算量：ならしO(1)
    //
    // # Parameters
    // - `from` : 始点の頂点番号
    // - `to` : 終点の頂点番号
    // - `cap` : 辺の容量
    // - `cost` : 辺の流量1あたりのコスト
    // - `graph` : グラフ
    add_edge : I64 -> I64 -> I64 -> I64 -> MinCostFlowGraph -> MinCostFlowGraph;
    add_edge = |from, to, cap, cost, g| g.add_edge_id(from, to, cap, cost).@0;

    // グラフに辺を追加する（辺の番号を返す）
    //
    // 辺の番号は、`add_edge`で足した辺も含めて、足した順に0から振られる。
    //
    // 制約：0 <= from, to < n, cap >= 0。costは負でもよい（負の閉路については、型`MinCostFlowGraph`の説明にある、`maximize_flow_min_cost`、`maximize_flow_min_cost_with_limit`、`maximize_flow_min_cost_slope`、`maximize_flow_min_cost_slope_with_limit`の制約を見よ）
    //
    // 計算量：ならしO(1)
    //
    // # Parameters
    // - `from` : 始点の頂点番号
    // - `to` : 終点の頂点番号
    // - `cap` : 辺の容量
    // - `cost` : 辺の流量1あたりのコスト
    // - `graph` : グラフ
    add_edge_id : I64 -> I64 -> I64 -> I64 -> MinCostFlowGraph -> (MinCostFlowGraph, MinCostFlowEdgeId);
    add_edge_id = |from, to, cap, cost, g| (
        let n = g.@_n;
        if !(0 <= from && from < n && 0 <= to && to < n) { undefined("[CPLib.MinCostFlow::MinCostFlowGraph::add_edge_id] got a vertex out of range") };
        if cap < 0 { undefined("[CPLib.MinCostFlow::MinCostFlowGraph::add_edge_id] got a negative capacity") };
        // 辺は足した順の番号（MinCostFlowEdgeId、つまりI64）で指す。ac-libraryのmcf_graphのadd_edge、get_edgeに合わせている
        let id = g.@_cost.@size;
        let g = g.mod__to(|ts| ts.push_back(to).push_back(from));
        let g = g.mod__cap(|cs| cs.push_back(cap).push_back(0));
        let g = g.mod__cost(|cs| cs.push_back(cost));
        (g, id)
    );

    // 辺に流れている量を取得する
    //
    // 計算量：O(1)
    //
    // # Parameters
    // - `edge_id` : 辺の番号（0 <= edge_id < 足した辺の数）
    // - `graph` : グラフ
    get_flow : MinCostFlowEdgeId -> MinCostFlowGraph -> I64;
    get_flow = |i, g| g.@_cap.@(2 * i + 1);

    // 辺の状態を取得する
    //
    // 計算量：O(1)
    //
    // # Parameters
    // - `edge_id` : 辺の番号（0 <= edge_id < 足した辺の数）
    // - `graph` : グラフ
    get_edge : MinCostFlowEdgeId -> MinCostFlowGraph -> MinCostFlowEdge;
    get_edge = |i, g| (
        let flow = g.@_cap.@(2 * i + 1);
        MinCostFlowEdge {
            from : g.@_to.@(2 * i + 1), to : g.@_to.@(2 * i), cap : g.@_cap.@(2 * i) + flow, flow : flow, cost : g.@_cost.@(i)
        }
    );

    // すべての辺の状態を、足した順に並べて取得する
    //
    // 計算量：O(m)
    //
    // # Parameters
    // - `graph` : グラフ
    get_edges : MinCostFlowGraph -> Array MinCostFlowEdge;
    get_edges = |g| range(0, g.@_cost.@size).map(|i| g.get_edge(i)).to_array;

    // 頂点`s`から頂点`t`へ流せるだけ流し、その流量を流すコストを最小にする
    //
    // 流した後のグラフと、新たに流した量と、そのコストを返す。
    // 何度でも呼べて、2回目以降はそれまでに流した状態から続けて流す。`s`と`t`は呼ぶたびに変えてよい。
    //
    // 制約：型`MinCostFlowGraph`の説明にある、この関数の制約を見よ
    //
    // 計算量：O(F (n + m) log(n + m))、Fは流した量。
    // 容量が正の辺にコストが負のものがあるとき（負のコストの辺を足したときと、2回目以降に呼ぶとき）は、追加でO(n (n + m))かかる。
    // 流す量によらず、呼ぶたびにO(n + m)かかる
    //
    // # Parameters
    // - `s` : 流し出す頂点の番号
    // - `t` : 流し込む頂点の番号
    // - `graph` : グラフ
    maximize_flow_min_cost : I64 -> I64 -> MinCostFlowGraph -> (MinCostFlowGraph, I64, I64);
    maximize_flow_min_cost = |s, t, g| g.maximize_flow_min_cost_with_limit(s, t, I64::maximum);

    // 頂点`s`から頂点`t`へ、流した量が上限に達するまで流せるだけ流し、その流量を流すコストを最小にする
    //
    // 流した後のグラフと、新たに流した量（上限以下）と、そのコストを返す。上限が0以下なら何も流さず0を返す。
    // 何度でも呼べて、2回目以降はそれまでに流した状態から続けて流す。`s`と`t`は呼ぶたびに変えてよい。
    //
    // 制約：型`MinCostFlowGraph`の説明にある、この関数の制約を見よ
    //
    // 計算量：O(F (n + m) log(n + m))、Fは流した量。
    // 容量が正の辺にコストが負のものがあるとき（負のコストの辺を足したときと、2回目以降に呼ぶとき）は、追加でO(n (n + m))かかる。
    // 流す量によらず、呼ぶたびにO(n + m)かかる
    //
    // # Parameters
    // - `s` : 流し出す頂点の番号
    // - `t` : 流し込む頂点の番号
    // - `flow_limit` : 流す量の上限
    // - `graph` : グラフ
    maximize_flow_min_cost_with_limit : I64 -> I64 -> I64 -> MinCostFlowGraph -> (MinCostFlowGraph, I64, I64);
    maximize_flow_min_cost_with_limit = |s, t, flow_limit, g| (
        let (g, slope) = g.maximize_flow_min_cost_slope_with_limit(s, t, flow_limit);
        let (flow, cost) = slope.@(slope.@size - 1);
        (g, flow, cost)
    );

    // 頂点`s`から頂点`t`へ流せるだけ流し、流量ごとの最小コストを折れ線で返す
    //
    // 流量xを流すときの最小コストをg(x)とすると、gは下に凸な折れ線である。流した後のグラフと、gの折れ点(x, g(x))の列を返す。
    // xはこの呼び出しで流した量、g(x)はそのコストである。
    // - 最初の点は(0, 0)、最後の点は(流した量, そのコスト)
    // - xは狭義単調増加で、3点が一直線に並ぶことはない
    //
    // 何度でも呼べて、2回目以降はそれまでに流した状態から続けて流す。`s`と`t`は呼ぶたびに変えてよい。
    //
    // 制約：型`MinCostFlowGraph`の説明にある、この関数の制約を見よ
    //
    // 計算量：O(F (n + m) log(n + m))、Fは流した量。
    // 容量が正の辺にコストが負のものがあるとき（負のコストの辺を足したときと、2回目以降に呼ぶとき）は、追加でO(n (n + m))かかる。
    // 流す量によらず、呼ぶたびにO(n + m)かかる
    //
    // # Parameters
    // - `s` : 流し出す頂点の番号
    // - `t` : 流し込む頂点の番号
    // - `graph` : グラフ
    maximize_flow_min_cost_slope : I64 -> I64 -> MinCostFlowGraph -> (MinCostFlowGraph, Array (I64, I64));
    maximize_flow_min_cost_slope = |s, t, g| g.maximize_flow_min_cost_slope_with_limit(s, t, I64::maximum);

    // 頂点`s`から頂点`t`へ、流した量が上限に達するまで流せるだけ流し、流量ごとの最小コストを折れ線で返す
    //
    // `maximize_flow_min_cost_slope`と同じく、流した後のグラフと、流量ごとの最小コストの折れ点の列を返す。
    // 最後の点の流量は上限以下である。上限が0以下なら何も流さず[(0, 0)]を返す。
    //
    // 制約：型`MinCostFlowGraph`の説明にある、この関数の制約を見よ
    //
    // 計算量：O(F (n + m) log(n + m))、Fは流した量。
    // 容量が正の辺にコストが負のものがあるとき（負のコストの辺を足したときと、2回目以降に呼ぶとき）は、追加でO(n (n + m))かかる。
    // 流す量によらず、呼ぶたびにO(n + m)かかる
    //
    // # Parameters
    // - `s` : 流し出す頂点の番号
    // - `t` : 流し込む頂点の番号
    // - `flow_limit` : 流す量の上限
    // - `graph` : グラフ
    maximize_flow_min_cost_slope_with_limit : I64 -> I64 -> I64 -> MinCostFlowGraph -> (MinCostFlowGraph, Array (I64, I64));
    maximize_flow_min_cost_slope_with_limit = |s, t, flow_limit, g| (
        if s == t { undefined("[CPLib.MinCostFlow::MinCostFlowGraph::maximize_flow_min_cost_slope_with_limit] s and t must differ") };
        if !(0 < flow_limit) { (g, [(0, 0)]) };
        let n = g.@_n;
        let (g, cap) = g[^_cap].ixchg([]);
        let res = g._make_residual(cap);
        let h = res._initial_potential(n, s, t);
        // unitは直前の折れ点までの区間の、流量1あたりのコスト
        let (res, slope) = loop((res, h, [(0, 0)], 0, 0, I64::minimum), |(res, h, slope, flow, cost, unit)|
            if !(flow < flow_limit) { break $ (res, slope) };
            let (dist, prev) = res._dijkstra(n, s, t, h);
            let dt = dist.@(t);
            if dt == I64::maximum { break $ (res, slope) };
            // ポテンシャルを更新する。tより近い頂点vにはdist(v) - dtを足し、tより遠い頂点（距離が確定していない頂点と、sから届かない頂点）は変えない。
            // h(t)は変わらず、補正したコストは0以上に保たれる
            let h = range(0, n).fold(h, |v, h| h.mod(v, |x| x + (min(dist.@(v), dt) - dt)));
            let (res, d) = res._augment_shortest_path(s, t, prev, flow_limit - flow);
            // 更新したポテンシャルの下では、sからtへの最短路の流量1あたりのコストはh(t) - h(s)
            let u = h.@(t) - h.@(s);
            let flow = flow + d;
            let cost = cost + d * u;
            // 傾きが前の区間と同じなら、前の折れ点を取り除いて区間をつなぐ
            let slope = if u == unit { slope.pop_back } else { slope };
            continue $ (res, h, slope.push_back((flow, cost)), flow, cost, u)
        );
        (g.set__cap(res._residual_capacities_by_edge_id(cap)), slope)
    );

    // 残余グラフを、内部の辺を始点ごとにまとめた並び（CSR形式）で作る
    //
    // # Parameters
    // - `cap` : 内部の辺の番号ごとの残余容量
    // - `graph` : グラフ
    _make_residual : Array I64 -> MinCostFlowGraph -> _ResidualGraph;
    _make_residual = |cap, g| (
        let n = g.@_n;
        let to = g.@_to;
        let cost = g.@_cost;
        let m2 = to.@size;
        // 内部の辺eの始点は、逆辺e ^ 1の行き先
        let out_degree = range(0, m2).fold(fill(n, 0), |e, deg| deg.mod(to.@(e.bit_xor(1)), |d| d + 1));
        let start = range(0, n).fold(fill(n + 1, 0), |v, start| start.set(v + 1, start.@(v) + out_degree.@(v)));
        // 内部の辺を番号の小さい順に見て、始点の区間に並べる。nextは各頂点の区間で次に置く位置
        let (pos, _) = range(0, m2).fold((fill(m2, 0), start), |e, (pos, next)|
            let v = to.@(e.bit_xor(1));
            let p = next.@(v);
            (pos.set(e, p), next.set(v, p + 1))
        );
        let (arc, rev, res_cap) = range(0, m2).fold((fill(m2, (0, 0)), fill(m2, 0), fill(m2, 0)), |e, (arc, rev, res_cap)|
            let p = pos.@(e);
            let c = cost.@(e / 2);
            let c = if e.bit_xor(1) > e { c } else { -c };
            (arc.set(p, (to.@(e), c)), rev.set(p, pos.@(e.bit_xor(1))), res_cap.set(p, cap.@(e)))
        );
        _ResidualGraph { start : start, pos : pos, arc : arc, rev : rev, cap : res_cap }
    );
}

// 最小費用流を求める間の残余グラフ
//
// 内部の辺を始点ごとにまとめて並べる（CSR形式）。頂点vから出る辺は、位置[start.@(v), start.@(v + 1))にある。
type _ResidualGraph = struct {
    // 長さが頂点数 + 1の配列。頂点vから出る辺の位置は[start.@(v), start.@(v + 1))
    start : Array I64,
    // 内部の辺の番号ごとの位置
    pos : Array I64,
    // 位置ごとの(行き先の頂点, コスト)。探索で一緒に読むので、1つの配列にまとめる
    arc : Array (I64, I64),
    // 位置ごとの、逆辺の位置
    rev : Array I64,
    // 位置ごとの残余容量
    cap : Array I64,
};

// 残余容量を内部の辺の番号の順に並べ直して返す
//
// # Parameters
// - `cap` : 書き戻す先の配列（内部の辺の番号ごと）
// - `res` : 残余グラフ
_residual_capacities_by_edge_id : Array I64 -> _ResidualGraph -> Array I64;
_residual_capacities_by_edge_id = |cap, res| (
    let pos = res.@pos;
    let res_cap = res.@cap;
    range(0, pos.@size).fold(cap, |e, cap| cap.set(e, res_cap.@(pos.@(e))))
);

// 最初のポテンシャルを求める
//
// 開始地点`s`から届く頂点の間の、残余容量のあるすべての辺u->vで、コスト + h(u) - h(v) >= 0となるhを返す。
// 残余容量のある辺のコストがすべて0以上なら、すべて0である。そうでなければ、`s`からベルマンフォード法で最短距離を求め、
// 終了地点`t`に届くなら`t`の値が0になるようにずらす。`s`から届かない頂点は0とする。
// `s`から届く範囲に、コストの和が負の閉路があれば止まる。
//
// # Parameters
// - `n` : 頂点数
// - `s` : 開始地点
// - `t` : 終了地点
// - `res` : 残余グラフ
_initial_potential : I64 -> I64 -> I64 -> _ResidualGraph -> Array I64;
_initial_potential = |n, s, t, res| (
    let start = res.@start;
    let arc = res.@arc;
    let cap = res.@cap;
    let m2 = arc.@size;
    if range(0, m2).fold(true, |p, ok| ok && !(cap.@(p) > 0 && arc.@(p).@1 < 0)) { fill(n, 0) };
    // 負の閉路がなければ、sからの最短距離は-(n - 1) * (残余容量のある辺のコストの絶対値の最大)以上で、途中の値もそれを下回らない。
    // 下回ったら負の閉路がある。値が溢れる前に、ここで止める
    let lower = -(n - 1) * range(0, m2).fold(0, |p, c| if cap.@(p) > 0 { max(c, abs(arc.@(p).@1)) } else { c });
    let negative_cycle = "[CPLib.MinCostFlow::MinCostFlowGraph::maximize_flow_min_cost_slope_with_limit] a cycle of negative cost is reachable from s";
    // sからの最短路は辺をn - 1本以下しか通らないので、n - 1周で縮まなくなる。n周目にも縮む頂点があれば、負の閉路がある
    let dist = loop((0, fill(n, I64::maximum).set(s, 0)), |(round, dist)|
        let (dist, changed) = range(0, n).fold((dist, false), |v, (dist, changed)|
            if dist.@(v) == I64::maximum { (dist, changed) };
            range(start.@(v), start.@(v + 1)).fold((dist, changed), |p, (dist, changed)|
                if !(cap.@(p) > 0) { (dist, changed) };
                let (w, c) = arc.@(p);
                let d = dist.@(v) + c;
                if !(d < dist.@(w)) { (dist, changed) };
                if d < lower { undefined(negative_cycle) };
                (dist.set(w, d), true)
            )
        );
        if !changed { break $ dist };
        if round == n - 1 { undefined(negative_cycle) };
        continue $ (round + 1, dist)
    );
    let base = if dist.@(t) == I64::maximum { 0 } else { dist.@(t) };
    dist.to_iter.map(|d| if d == I64::maximum { 0 } else { d - base }).to_array
);

// ポテンシャル`h`で補正したコストで、開始地点`s`からダイクストラ法で距離を求める
//
// 各頂点の距離と、その頂点に最短路で入る辺の位置を返す。終了地点`t`を取り出した時点で打ち切る。
// 到達できない頂点と、打ち切りで距離が確定していない頂点の距離は、確定した値以上である（到達できない頂点は`I64::maximum`）。
//
// # Parameters
// - `n` : 頂点数
// - `s` : 開始地点
// - `t` : 終了地点
// - `h` : ポテンシャル
// - `res` : 残余グラフ
_dijkstra : I64 -> I64 -> I64 -> Array I64 -> _ResidualGraph -> (Array I64, Array I64);
_dijkstra = |n, s, t, h, res| (
    let start = res.@start;
    let arc = res.@arc;
    let cap = res.@cap;
    let dist = fill(n, I64::maximum).set(s, 0);
    let prev = fill(n, -1);
    let que = MinBinaryHeap::empty.push(_NodeDistance::make(s, 0));
    loop((que, dist, prev), |(que, dist, prev)|
        if que.get_size == 0 { break $ (dist, prev) };
        let _NodeDistance { node : v, dist : d } = que.get_top.as_some;
        let que = que.pop;
        if dist.@(v) < d { continue $ (que, dist, prev) };
        if v == t { break $ (dist, prev) };
        let hv = h.@(v);
        continue $ range(start.@(v), start.@(v + 1)).fold((que, dist, prev), |p, (que, dist, prev)|
            if !(cap.@(p) > 0) { (que, dist, prev) };
            let (w, c) = arc.@(p);
            let new_d = d + c + hv - h.@(w);
            if !(dist.@(w) > new_d) { (que, dist, prev) };
            (que.push(_NodeDistance::make(w, new_d)), dist.set(w, new_d), prev.set(w, p))
        )
    )
);

// 最短路に沿って、`s`から`t`へ流せるだけ（`flow_rest`以下）流す
//
// 更新した残余グラフと、流した量を返す。
//
// # Parameters
// - `s` : 開始地点
// - `t` : 終了地点
// - `prev` : 各頂点に最短路で入る辺の位置
// - `flow_rest` : 流してよい量
// - `res` : 残余グラフ
_augment_shortest_path : I64 -> I64 -> Array I64 -> I64 -> _ResidualGraph -> (_ResidualGraph, I64);
_augment_shortest_path = |s, t, prev, flow_rest, res| (
    let arc = res.@arc;
    let rev = res.@rev;
    let (res, cap) = res[^cap].ixchg([]);
    // 辺の位置pの始点は、逆辺の行き先
    let from = |p| arc.@(rev.@(p)).@0;
    let d = loop((t, flow_rest), |(v, d)|
        if v == s { break $ d };
        let p = prev.@(v);
        continue $ (from(p), min(d, cap.@(p)))
    );
    let cap = loop((t, cap), |(v, cap)|
        if v == s { break $ cap };
        let p = prev.@(v);
        continue $ (from(p), cap.mod(p, |x| x - d).mod(rev.@(p), |x| x + d))
    );
    (res.set_cap(cap), d)
);
