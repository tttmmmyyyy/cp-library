// Union-Find木
//
// 要素の検索を伴う関数は、パス圧縮で更新したUnionFind木を結果とともに返します。
//
// # Examples
// ```fix
// let uf = create(4).unite(0, 1).unite(1, 2);
// let (uf, united) = uf.is_united(0, 2);
// assert(|_|"", united);;
// let (_, size) = uf.get_group_size(3);
// assert_eq(|_|"", size, 1)
// ```
module CPLib.UnionFind;

import Std::{
    loop, Array, Bool, I64, Array::{fill, mod, push_back, set, @, @size}, Indexable::ixchg, Iterator::{fold, range}, 
    LoopState::{break, continue}
};

type UnionFind = struct {
    // 要素xが根なら-(xの属するグループの大きさ)、そうでなければxの親
    _parent_or_size : Array I64,
};

// UnionFind木を作成する
// 
// `0`から`size - 1`までの`size`個の要素を持つUnionFind木を作成する
// 
// 制約：size >= 0
//
// 計算量：O(size)
//
// # Parameters
// - `size` : UnionFind木のサイズ
create : I64 -> UnionFind;
create = |size| UnionFind { _parent_or_size : fill(size, -1) };

// 指定された要素の属するグループの代表元を取得する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
find_parent : I64 -> UnionFind -> (UnionFind, I64);
find_parent = |x, uf| (
    let (uf, ps) = uf[^_parent_or_size].ixchg([]);
    let (ps, r) = _find_root(x, ps);
    (uf.set__parent_or_size(ps), r)
);

// 要素`x`の根を求め、通った頂点の親を根に書き換える
//
// 根までたどって根を求めてから、もう一度たどって親を書き換える。親がすでに根の要素には書き込まない。
//
// # Parameters
// - `x` : 対象となる要素
// - `ps` : 要素ごとの親、または根のときは-(グループの大きさ)
_find_root : I64 -> Array I64 -> (Array I64, I64);
_find_root = |x, ps| (
    let r = loop(x, |v| let p = ps.@(v); if p < 0 { break $ v } else { continue $ p });
    let ps = loop((x, ps), |(v, ps)|
        let p = ps.@(v);
        if p < 0 || p == r { break $ ps };
        continue $ (p, ps.set(v, r))
    );
    (ps, r)
);

// 2つの要素を同じグループにする
// 
// すでに同じグループに属しているなら何もしない。
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
unite : I64 -> I64 -> UnionFind -> UnionFind;
unite = |x, y, uf| (
    let (uf, ps) = uf[^_parent_or_size].ixchg([]);
    let (ps, rx) = _find_root(x, ps);
    let (ps, ry) = _find_root(y, ps);
    if rx == ry { uf.set__parent_or_size(ps) };
    // 大きいほうの根の下に、小さいほうの根をつなぐ。根の値は-(大きさ)なので、値の小さいほうが大きい
    let (rx, ry) = if ps.@(rx) <= ps.@(ry) { (rx, ry) } else { (ry, rx) };
    let ps = ps.set(rx, ps.@(rx) + ps.@(ry)).set(ry, rx);
    uf.set__parent_or_size(ps)
);

// 2つの要素が同じグループに属しているかどうかを判定する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素 
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
is_united : I64 -> I64 -> UnionFind -> (UnionFind, Bool);
is_united = |x, y, uf| (
    let (uf, ps) = uf[^_parent_or_size].ixchg([]);
    let (ps, rx) = _find_root(x, ps);
    let (ps, ry) = _find_root(y, ps);
    (uf.set__parent_or_size(ps), rx == ry)
);

// 指定された要素が属するグループのサイズを取得する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
get_group_size : I64 -> UnionFind -> (UnionFind, I64);
get_group_size = |x, uf| (
    let (uf, ps) = uf[^_parent_or_size].ixchg([]);
    let (ps, r) = _find_root(x, ps);
    let size = -ps.@(r);
    (uf.set__parent_or_size(ps), size)
);

// グループの配列を取得する
// 
// グループの配列[g0, g1, g2, ...]を返す。各グループの要素は昇順で、グループは最小の要素の昇順に並ぶ。
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 計算量：O(size α(size))
//
// # Parameters
// - `uf` : UnionFind木
get_groups : UnionFind -> (UnionFind, Array (Array I64));
get_groups = |uf| (
    let (uf, ps) = uf[^_parent_or_size].ixchg([]);
    let n = ps.@size;
    // group_of_root.@(r)は、根rのグループのgroupsの中での位置。まだ無ければ-1
    let (ps, _, groups) = range(0, n).fold((ps, fill(n, -1), []), |i, (ps, group_of_root, groups)|
        let (ps, r) = _find_root(i, ps);
        let g = group_of_root.@(r);
        if g >= 0 { (ps, group_of_root, groups.mod(g, push_back(i))) };
        (ps, group_of_root.set(r, groups.@size), groups.push_back([i]))
    );
    (uf.set__parent_or_size(ps), groups)
);
