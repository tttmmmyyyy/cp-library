// Union-Find木
//
// 要素の検索を伴う関数は、パス圧縮で更新したUnionFind木を結果とともに返します。
//
// # Examples
// ```fix
// let uf = create(4).unite(0, 1).unite(1, 2);
// let (uf, united) = uf.is_united(0, 2);
// assert(|_|"", united);;
// let (_, size) = uf.get_group_size(3);
// assert_eq(|_|"", size, 1)
// ```
module CPLib.UnionFind;

import Std::{
    loop, undefined, Array, Bool, I32, I64, Array::{fill, mod, push_back, set, @, @size}, Iterator::{fold, range}, 
    I32::maximum, LoopState::{break, continue}, ToI32::i32, ToI64::i64
};

type UnionFind = struct {
    // 要素xが根なら-(xの属するグループの大きさ)、そうでなければxの親
    //
    // 4バイトの要素で持つのは、配列をキャッシュに収めやすくするため。2*10^6要素で8MBになり、`I64`の16MBと違ってL3キャッシュに収まる機械が多い。
    _parent_or_size : Array I32,
};

// UnionFind木を作成する
// 
// `0`から`size - 1`までの`size`個の要素を持つUnionFind木を作成する
// 
// 制約：0 <= size < 2^31
//
// 計算量：O(size)
//
// # Parameters
// - `size` : UnionFind木のサイズ
create : I64 -> UnionFind;
create = |size| (
    if size > I32::maximum.i64 { undefined("[CPLib.UnionFind::create] got a size of 2^31 or more") };
    UnionFind { _parent_or_size : fill(size, -1_I32) }
);

// 指定された要素の属するグループの代表元を取得する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
get_leader : I64 -> UnionFind -> (UnionFind, I64);
get_leader = |x, uf| (
    _find_root(x, uf)
);

// `get_leader`の別名（非推奨）
find_parent : I64 -> UnionFind -> (UnionFind, I64) = get_leader;
DEPRECATED[find_parent, "Use `CPLib.UnionFind::get_leader` instead."];

// 要素`x`の根を求め、通った要素の親を根に書き換える
//
// 根までたどって根を求めてから、もう一度たどって親を書き換える。親がすでに根の要素には書き込まない。
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
_find_root : I64 -> UnionFind -> (UnionFind, I64);
_find_root = |x, uf| (
    let r = loop(x, |v| let p = uf.@_parent_or_size.@(v).i64; if p < 0 { break $ v } else { continue $ p });
    let uf = loop((x, uf), |(v, uf)|
        let p = uf.@_parent_or_size.@(v).i64;
        if p < 0 || p == r { break $ uf };
        continue $ (p, uf.mod__parent_or_size(set(v, r.i32)))
    );
    (uf, r)
);

// 2つの要素を同じグループにする
// 
// すでに同じグループに属しているなら何もしない。
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
unite : I64 -> I64 -> UnionFind -> UnionFind;
unite = |x, y, uf| (
    let (uf, rx) = _find_root(x, uf);
    let (uf, ry) = _find_root(y, uf);
    if rx == ry { uf };
    let ps = uf.@_parent_or_size;
    let (rx, ry) = if ps.@(rx) <= ps.@(ry) { (rx, ry) } else { (ry, rx) };
    let sz = ps.@(rx) + ps.@(ry);
    uf.mod__parent_or_size(|ps| ps.set(rx, sz).set(ry, rx.i32))
);

// 2つの要素が同じグループに属しているかどうかを判定する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素 
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
is_united : I64 -> I64 -> UnionFind -> (UnionFind, Bool);
is_united = |x, y, uf| (
    let (uf, rx) = _find_root(x, uf);
    let (uf, ry) = _find_root(y, uf);
    (uf, rx == ry)
);

// 指定された要素が属するグループのサイズを取得する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
get_group_size : I64 -> UnionFind -> (UnionFind, I64);
get_group_size = |x, uf| (
    let (uf, r) = _find_root(x, uf);
    (uf, -uf.@_parent_or_size.@(r).i64)
);

// グループの配列を取得する
// 
// グループの配列[g0, g1, g2, ...]を返す。各グループの要素は昇順で、グループは最小の要素の昇順に並ぶ。
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 計算量：O(size α(size))
//
// # Parameters
// - `uf` : UnionFind木
get_groups : UnionFind -> (UnionFind, Array (Array I64));
get_groups = |uf| (
    let n = uf.@_parent_or_size.@size;
    let (uf, _, groups) = range(0, n).fold((uf, fill(n, -1), []), |i, (uf, group_of_root, groups)|
        let (uf, r) = _find_root(i, uf);
        let g = group_of_root.@(r);
        if g >= 0 { (uf, group_of_root, groups.mod(g, push_back(i))) };
        (uf, group_of_root.set(r, groups.@size), groups.push_back([i]))
    );
    (uf, groups)
);
