// Union-Find木
//
// 要素の検索を伴う関数は、パス圧縮で更新したUnionFind木を結果とともに返します。
//
// # Examples
// ```fix
// let uf = create(4).unite(0, 1).unite(1, 2);
// let (uf, united) = uf.is_united(0, 2);
// assert(|_|"", united);;
// let (_, size) = uf.get_group_size(3);
// assert_eq(|_|"", size, 1)
// ```
module CPLib.UnionFind;

import Std::{
    loop, undefined, Array, Bool, I32, I64, Array::{fill, mod, push_back, set, @, @size}, Iterator::{fold, range}, 
    I32::maximum, LoopState::{break, continue}, ToI32::i32, ToI64::i64, Tuple2::@0
};

type UnionFind = struct {
    // 要素xが根なら-(xの属するグループの大きさ)、そうでなければxの親
    //
    // 4バイトの要素で持つのは、配列をキャッシュに収めやすくするため。2*10^6要素で8MBになり、`I64`の16MBと違ってL3キャッシュに収まる機械が多い。
    _parent_or_size : Array I32,
    // グループの数
    _group_count : I64,
};

// UnionFind木を作成する
// 
// `0`から`size - 1`までの`size`個の要素を持つUnionFind木を作成する
// 
// 制約：0 <= size < 2^31
//
// 計算量：O(size)
//
// # Parameters
// - `size` : UnionFind木のサイズ
create : I64 -> UnionFind;
create = |size| (
    if size > I32::maximum.i64 { undefined("[CPLib.UnionFind::create] got a size of 2^31 or more") };
    UnionFind { _parent_or_size : fill(size, -1_I32), _group_count : size }
);

// 指定された要素の属するグループの代表元を取得する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
get_leader : I64 -> UnionFind -> (UnionFind, I64);
get_leader = |x, uf| (
    _find_root(x, uf)
);

// `get_leader`の別名（非推奨）
find_parent : I64 -> UnionFind -> (UnionFind, I64) = get_leader;
DEPRECATED[find_parent, "Use `CPLib.UnionFind::get_leader` instead."];

// 要素`x`の根を求め、通った要素の親を付け替えて木を低くする
//
// 根までたどりながら、たどった要素の親を祖父に付け替える（path halving）。根を一度たどるだけで済み、大きさによる併合と組み合わせて計算量はならしO(α(size))。
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
_find_root : I64 -> UnionFind -> (UnionFind, I64);
_find_root = |x, uf| (
    loop((x, uf), |(v, uf)|
        let p = uf.@_parent_or_size.@(v).i64;
        if p < 0 { break $ (uf, v) };
        let g = uf.@_parent_or_size.@(p).i64;
        if g < 0 { break $ (uf, p) };
        continue $ (g, uf.mod__parent_or_size(set(v, g.i32)))
    )
);

// 2つの要素を同じグループにする
// 
// すでに同じグループに属しているなら何もしない。
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
unite : I64 -> I64 -> UnionFind -> UnionFind;
unite = |x, y, uf| try_unite(x, y, uf).@0;

// 2つの要素を同じグループにし、2つが別のグループだったかを返す
// 
// 別のグループだったなら併合して`true`を、すでに同じグループに属しているなら何もせず`false`を返す。
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
//
// # Examples
// ```fix
// // クラスカル法：別のグループを結ぶ辺だけを採る
// let (uf, taken) = [(0, 1), (1, 2), (0, 2)].to_iter.fold((create(3), []), |(x, y), (uf, taken)|
//     let (uf, merged) = uf.try_unite(x, y);
//     (uf, taken.push_back(merged))
// );
// assert_eq(|_|"", taken, [true, true, false])
// ```
try_unite : I64 -> I64 -> UnionFind -> (UnionFind, Bool);
try_unite = |x, y, uf| (
    let (uf, rx) = _find_root(x, uf);
    let (uf, ry) = _find_root(y, uf);
    if rx == ry { (uf, false) };
    let ps = uf.@_parent_or_size;
    let (rx, ry) = if ps.@(rx) <= ps.@(ry) { (rx, ry) } else { (ry, rx) };
    let sz = ps.@(rx) + ps.@(ry);
    let uf = uf.mod__parent_or_size(|ps| ps.set(rx, sz).set(ry, rx.i32));
    (uf.mod__group_count(|c| c - 1), true)
);

// グループの数を取得する
//
// 計算量：O(1)
//
// # Parameters
// - `uf` : UnionFind木
get_group_count : UnionFind -> I64;
get_group_count = |uf| uf.@_group_count;

// 2つの要素が同じグループに属しているかどうかを判定する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x, y < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 1つ目の要素 
// - `y` : 2つ目の要素
// - `uf` : UnionFind木
is_united : I64 -> I64 -> UnionFind -> (UnionFind, Bool);
is_united = |x, y, uf| (
    let (uf, rx) = _find_root(x, uf);
    let (uf, ry) = _find_root(y, uf);
    (uf, rx == ry)
);

// 指定された要素が属するグループのサイズを取得する
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 制約：0 <= x < size
//
// 計算量：ならしO(α(size))
//
// # Parameters
// - `x` : 対象となる要素
// - `uf` : UnionFind木
get_group_size : I64 -> UnionFind -> (UnionFind, I64);
get_group_size = |x, uf| (
    let (uf, r) = _find_root(x, uf);
    (uf, -uf.@_parent_or_size.@(r).i64)
);

// グループの配列を取得する
// 
// グループの配列[g0, g1, g2, ...]を返す。各グループの要素は昇順で、グループは最小の要素の昇順に並ぶ。
// 
// パス圧縮を行うため、UnionFindの状態も変化する
// 
// 計算量：O(size α(size))
//
// # Parameters
// - `uf` : UnionFind木
get_groups : UnionFind -> (UnionFind, Array (Array I64));
get_groups = |uf| (
    let n = uf.@_parent_or_size.@size;
    let (uf, _, groups) = range(0, n).fold((uf, fill(n, -1), []), |i, (uf, group_of_root, groups)|
        let (uf, r) = _find_root(i, uf);
        let g = group_of_root.@(r);
        if g >= 0 { (uf, group_of_root, groups.mod(g, push_back(i))) };
        (uf, group_of_root.set(r, groups.@size), groups.push_back([i]))
    );
    (uf, groups)
);
