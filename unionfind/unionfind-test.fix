module CPLib.UnionFind.Test;

import CPLib.UnionFind::{create, get_group_count, get_leader, get_group_size, get_groups, is_united, try_unite, unite};
import EZS::{cd, run_o, run_wi_oec, Context::default};
import Random::{generate_I64_nonneg, init_by_seed, Random};
import Std::{
    Array, I64, IO, Array::{fill, mod, push_back, set, sort_by, to_iter, @, @size}, Debug::{assert_eq, consumed_time_while_lazy}, 
    Functor::map, IO::println, Iterator::{fold, fold_m, range}, Monad::pure, Option::is_some, String::{find, populate}, ToString::to_string, 
    Tuple2::@1
};

// https://atcoder.jp/contests/language-test-202505/submissions/68392520

test : IO ();
test = (
    test_zero;;
    test_by_hand;;
    test_create_too_large;;
    let _ = *test_random(Random::init_by_seed(0_U64));
    test_speed;;
    pure()
);

test_zero : IO ();
test_zero = (
    // UnionFind木のサイズが0の場合
    let uf = UnionFind::create(0);
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 0);;

    pure()
);

// 大きさが2^31以上だと、`create`が理由を書いて止まる
test_create_too_large : IO ();
test_create_too_large = (
    let ezs = EZS::Context::default;
    ezs.cd("unionfind/too-large");;
    ezs.run_o(["fix", "deps", "update"]);;
    let (_, err, code) = *ezs.run_wi_oec(["fix", "run", "--allow-preliminary-commands"], "0");
    assert_eq(|_|"too large: " + err, code != 0_U8 && err.find("[CPLib.UnionFind::create] got a size of 2^31 or more", 0).is_some, true);;
    let (out, _, code) = *ezs.run_wi_oec(["fix", "run", "--allow-preliminary-commands"], "1");
    assert_eq(|_|"small: " + out, code == 0_U8 && out.find("1", 0).is_some, true);;
    // 後のテストのために、作業ディレクトリをライブラリのルートに戻す
    ezs.cd("../..")
);

test_by_hand : IO ();
test_by_hand = (
    let uf = UnionFind::create(6);
    assert_eq(|_|"", uf.is_united(0, 0).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 1).@1, false);;
    assert_eq(|_|"", uf.get_group_size(0).@1, 1);;
    assert_eq(|_|"", uf.get_group_size(5).@1, 1);;
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 6);;

    let uf = uf.unite(0, 1);
    assert_eq(|_|"", uf.is_united(0, 1).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 2).@1, false);;
    assert_eq(|_|"", uf.is_united(1, 2).@1, false);;
    assert_eq(|_|"", uf.get_group_size(0).@1, 2);;
    assert_eq(|_|"", uf.get_group_size(1).@1, 2);;
    assert_eq(|_|"", uf.get_group_size(2).@1, 1);;
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 5);;

    let uf = uf.unite(1, 2);
    assert_eq(|_|"", uf.is_united(1, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 3).@1, false);;
    assert_eq(|_|"", uf.get_group_size(0).@1, 3);;
    assert_eq(|_|"", uf.get_group_size(1).@1, 3);;
    assert_eq(|_|"", uf.get_group_size(2).@1, 3);;
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 4);;

    let uf = uf.unite(3, 4);
    assert_eq(|_|"", uf.is_united(1, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 3).@1, false);;
    assert_eq(|_|"", uf.is_united(3, 4).@1, true);;
    assert_eq(|_|"", uf.is_united(4, 5).@1, false);;
    assert_eq(|_|"", uf.get_group_size(3).@1, 2);;
    assert_eq(|_|"", uf.get_group_size(4).@1, 2);;
    assert_eq(|_|"", uf.get_group_size(5).@1, 1);;
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 3);;
    let grps = grps.sort_by(|(a, b)| a.@size > b.@size);
    let grps = grps.map(|grp| grp.sort_by(|(a, b)| a < b));
    assert_eq(|_|"", grps, [[0, 1, 2], [3, 4], [5]]);;

    let uf = uf.unite(2, 3);
    assert_eq(|_|"", uf.is_united(1, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 3).@1, true);;
    assert_eq(|_|"", uf.is_united(3, 4).@1, true);;
    assert_eq(|_|"", uf.is_united(4, 5).@1, false);;
    assert_eq(|_|"", uf.get_group_size(0).@1, 5);;
    assert_eq(|_|"", uf.get_group_size(3).@1, 5);;
    assert_eq(|_|"", uf.get_group_size(5).@1, 1);;
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 2);;

    let uf = uf.unite(4, 5);
    assert_eq(|_|"", uf.is_united(1, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 2).@1, true);;
    assert_eq(|_|"", uf.is_united(0, 3).@1, true);;
    assert_eq(|_|"", uf.is_united(3, 4).@1, true);;
    assert_eq(|_|"", uf.is_united(4, 5).@1, true);;
    assert_eq(|_|"", uf.get_group_size(0).@1, 6);;
    assert_eq(|_|"", uf.get_group_size(5).@1, 6);;
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"", grps.@size, 1);;

    pure()
);

test_speed : IO ();
test_speed = (
    // n=10^5個の要素を持つUnionFind木を生成し、n回程度ランダムにクエリを投げる。
    // もしn^2実装になっていたらこのテストは終わらない。
    let n = 1e5;
    let rng = Random::init_by_seed(0_U64);
    let uf = UnionFind::create(n);
    let ((uf, rng), time) = consumed_time_while_lazy(|_| range(0, n).fold((uf, rng), |_, (uf, rng)| (
        // unite
        let (rng, i) = rng.generate_I64_nonneg;
        let (rng, j) = rng.generate_I64_nonneg;
        let i = i % n; // 0 <= i < n
        let j = j % n; // 0 <= j < n
        let uf = uf.unite(i, j);

        // is_united
        let (rng, k) = rng.generate_I64_nonneg;
        let (rng, l) = rng.generate_I64_nonneg;
        let k = k % n; // 0 <= k < n
        let l = l % n; // 0 <= l < n
        let (uf, is_united) = uf.is_united(k, l);

        (uf, rng)
    )));
    let (uf, grps) = uf.get_groups;
    assert_eq(|_|"test_speed", grps.@size, 16102);;
    println $ "[CPLib.UnionFind.Test] UnionFind({}): {}".populate([n.to_string, time.to_string]);;

    pure()
);

// 要素ごとのグループの番号を持つ素朴な実装と、乱択の操作列で比べる
test_random : Random -> IO Random;
test_random = |rng| (
    range(0, 300).fold_m(rng, |_, rng|
        let (rng, n) = rng.generate_I64_nonneg;
        let n = 1 + n % 8;
        let (rng, ops) = rng.generate_I64_nonneg;
        let ops = ops % 20;
        // try_uniteの戻り値が、2つが別のグループだったかと一致するかをmergedsに集める
        let (rng, uf, label, log, mergeds) = range(0, ops).fold((rng, UnionFind::create(n), range(0, n).fold([], |i, a| a.push_back(i)), "", []), |_, (rng, uf, label, log, mergeds)|
            let (rng, x) = rng.generate_I64_nonneg;
            let (rng, y) = rng.generate_I64_nonneg;
            let (rng, use_try) = rng.generate_I64_nonneg;
            let (x, y) = (x % n, y % n);
            // yのグループの番号を、すべてxのグループの番号に替える
            let (lx, ly) = (label.@(x), label.@(y));
            let label = range(0, n).fold(label, |i, label| if label.@(i) == ly { label.set(i, lx) } else { label });
            if use_try % 2 == 0 {
                (rng, uf.unite(x, y), label, log + " unite(" + x.to_string + "," + y.to_string + ")", mergeds)
            };
            let (uf, merged) = uf.try_unite(x, y);
            (rng, uf, label, log + " try_unite(" + x.to_string + "," + y.to_string + ")", mergeds.push_back((merged, lx != ly)))
        );
        let msg = |_| "n=" + n.to_string + log;
        mergeds.to_iter.fold_m((), |(merged, expected), _| assert_eq(msg, merged, expected));;
        // グループの数は、異なる番号の数
        assert_eq(msg, uf.get_group_count, range(0, n).fold(0, |i, c| if label.@(i) == i { c + 1 } else { c }));;
        let uf = *range(0, n).fold_m(uf, |x, uf|
            let (uf, size) = uf.get_group_size(x);
            assert_eq(msg, size, range(0, n).fold(0, |i, c| if label.@(i) == label.@(x) { c + 1 } else { c }));;
            // 代表元はxと同じグループの要素で、代表元の代表元はそれ自身
            let (uf, rx) = uf.get_leader(x);
            assert_eq(msg, label.@(rx), label.@(x));;
            assert_eq(msg, uf.get_leader(rx).@1, rx);;
            range(0, n).fold_m(uf, |y, uf|
                let (uf, united) = uf.is_united(x, y);
                assert_eq(msg, united, label.@(x) == label.@(y));;
                // 代表元が一致することと、同じグループに属することは同値
                let (uf, ry) = uf.get_leader(y);
                assert_eq(msg, rx == ry, label.@(x) == label.@(y));;
                pure $ uf
            )
        );
        // 素朴なグループの配列：要素を昇順に見て、初めて出たグループの番号に新しい位置を割り当てる
        let (_, expected) = range(0, n).fold((fill(n, -1), []), |i, (pos, groups)|
            let g = pos.@(label.@(i));
            if g >= 0 { (pos, groups.mod(g, push_back(i))) };
            (pos.set(label.@(i), groups.@size), groups.push_back([i]))
        );
        let (_, groups) = uf.get_groups;
        assert_eq(msg, groups, expected);;
        pure $ rng
    )
);
