    assert_eq(|_|"case lp 2", lp.@(2), 2_U32);;
    assert_eq(|_|"case lp 3", lp.@(3), 3_U32);;
    assert_eq(|_|"case lp 4", lp.@(4), 2_U32);;
    assert_eq(|_|"case lp 5", lp.@(5), 5_U32);;
    assert_eq(|_|"case lp 6", lp.@(6), 2_U32);;
    assert_eq(|_|"case lp 7", lp.@(7), 7_U32);;
    assert_eq(|_|"case lp 8", lp.@(8), 2_U32);;
    assert_eq(|_|"case lp 9", lp.@(9), 3_U32);;
    assert_eq(|_|"case lp 10", lp.@(10), 2_U32);;
    assert_eq(|_|"case lp 11", lp.@(11), 11_U32);;
    assert_eq(|_|"case lp 12", lp.@(12), 2_U32);;
    assert_eq(|_|"case lp 13", lp.@(13), 13_U32);;
    assert_eq(|_|"case lp 14", lp.@(14), 2_U32);;
    assert_eq(|_|"case lp 15", lp.@(15), 3_U32);;
    assert_eq(|_|"case lp 16", lp.@(16), 2_U32);;
    assert_eq(|_|"case lp 17", lp.@(17), 17_U32);;
    assert_eq(|_|"case lp 18", lp.@(18), 2_U32);;
    assert_eq(|_|"case lp 19", lp.@(19), 19_U32);;
    assert_eq(|_|"case lp 20", lp.@(20), 2_U32);;
    assert_eq(|_|"case ps 0", ps.@(0), 2_U32);;
    assert_eq(|_|"case ps 1", ps.@(1), 3_U32);;
    assert_eq(|_|"case ps 2", ps.@(2), 5_U32);;
    assert_eq(|_|"case ps 3", ps.@(3), 7_U32);;
    assert_eq(|_|"case ps 4", ps.@(4), 11_U32);;
    assert_eq(|_|"case ps 5", ps.@(5), 13_U32);;
    assert_eq(|_|"case ps 6", ps.@(6), 17_U32);;
    assert_eq(|_|"case ps 7", ps.@(7), 19_U32);;

    pure()
);

// 制約を満たさない引数を渡すと、`pow_mod`（負の指数）、`lift_crt`（長さの違う配列、1未満の法）、
// ペル方程式の関数（平方数か正でない`d`、0の`m`）が理由を書いて止まる
test_out_of_range : IO ();
test_out_of_range = (
    let ezs = EZS::Context::default;
    ezs.cd("arithmetic/out-of-range");;
    ezs.run_o(["fix", "deps", "update"]);;
    let messages = [
        "[CPLib.Arithmetic::pow_mod] `e` is negative",
        "[CPLib.Arithmetic::lift_crt] `rs` and `ms` have different sizes",
        "[CPLib.Arithmetic::lift_crt] `ms` has an element less than 1",
        "[CPLib.Arithmetic::calc_pell_fundamental_solution] `d` is a square number",
        "[CPLib.Arithmetic::calc_general_pell_representatives] `d` is not positive",
        "[CPLib.Arithmetic::calc_general_pell_representatives] `m` is zero"
    ];
    range(0, 6).fold_m((), |case, _|
        let (_, err, code) = *ezs.run_wi_oec(["fix", "run", "--allow-preliminary-commands"], case.to_string);
        assert_eq(|_|"case " + case.to_string + ": " + err, code != 0_U8 && err.find(messages.@(case), 0).is_some, true)
    );;
    let (out, _, code) = *ezs.run_wi_oec(["fix", "run", "--allow-preliminary-commands"], "6");
    assert_eq(|_|"in range: " + out, code == 0_U8 && out.find("(2, (8, 15))", 0).is_some, true);;
    // 後のテストのために、作業ディレクトリをライブラリのルートに戻す
    ezs.cd("../..")
);

// `Integer`の演算だけで`I64`の値を作る変換が、元の値を保つことを確かめる
test_integer_from_i64 : IO () = (
    [0, 1, -1, 2, -2, 12345, -98765, I64::maximum, I64::minimum].to_iter.fold_m((), |x, _|
        assert_eq(|_|"_integer_from_i64 I64 {}".format((x,)), (_integer_from_i64(x) : I64), x);;
        assert_eq(|_|"_integer_from_i64 I128 {}".format((x,)), (_integer_from_i64(x) : I128), x.i128)
    )
);

// 平方根を、総当たりで求めたものと比べる
test_sqrt_mod : IO () = (
    range(1, 301).fold_m((), |m, _|
        let factors = m.factorize.to_iter.map(|(p, k)| (p, k.i64)).to_array;
        range(0, m).fold_m((), |a, _|
            let expected = range(0, m).filter(|z| z * z % m == a).to_array;
            assert_eq(|_|"_calc_sqrts_mod_factors a={} m={}".format((a, m)), _calc_sqrts_mod_factors(a, factors).sort, expected)
        )
    );;
    [998244353, 1000000007, 4611686018427387847].to_iter.fold_m((), |p, _|
        range(0, 200).fold_m((), |a, _|
            let a = mul_mod(a, 123456789123, p);
            let r = _calc_sqrt_mod_prime(a, p);
            let is_qr = a == 0 || a.pow_mod((p - 1) / 2, p) == 1;
            assert_eq(|_|"_calc_sqrt_mod_prime a={} p={}".format((a, p)), r.is_some, is_qr);;
            if r.is_none { pure() };
            assert_eq(|_|"_calc_sqrt_mod_prime a={} p={} square".format((a, p)), mul_mod(r.as_some, r.as_some, p), a)
        )
    )
);

test_pell : IO () = (
    test_integer_from_i64;;
    test_sqrt_mod;;
    test_pell_fundamental_solution;;
    test_pell_representatives;;
    test_pell_solutions;;
    pure()
);

// `x^2 - d y^2`
_pell_norm : I64 -> (I64, I64) -> I64 = |d, (x, y)| x * x - d * y * y;

// `[2, n)` に含まれる平方数でない整数
_non_square_ds : I64 -> Array I64 = |n| (
    range(2, n).filter(|d| let s = isqrt(d.u64).i64; s * s != d).to_array
);

// `x + y root(d)` と `u + v root(d)` の比が単数かどうか
_pell_same_class : I64 -> (I64, I64) -> (I64, I64) -> Bool = |d, (x, y), (u, v)| (
    // (x + y root(d)) / (u + v root(d)) = (x + y root(d)) (u - v root(d)) / N(u + v root(d))
    let n = _pell_norm(d, (u, v));
    let p = x * u - d * y * v;
    let q = y * u - x * v;
    if p % n != 0 || q % n != 0 { false };
    _pell_norm(d, (p / n, q / n)).abs == 1
);

// `|x^2 - d y^2| = m` を満たす非負の整数解のうち、`y <= y_max` のもの
_pell_brute_solutions : I64 -> I64 -> I64 -> Array (I64, I64) = |d, m, y_max| (
    range(0, y_max + 1).flat_map(|y|
        [d * y * y + m, d * y * y - m].to_iter.filter_map(|t|
            if t < 0 { none() };
            let x = isqrt(t.u64).i64;
            if x * x != t { none() };
            (x, y).some
        )
    ).to_array
);

// 基本解を、`|x^2 - d y^2| = 1` を満たす最小の `y >= 1` を総当たりで探したものと比べる
test_pell_fundamental_solution : IO () = (
    _non_square_ds(101).to_iter.fold_m((), |d, _|
        let actual : (I64, I64) = calc_pell_fundamental_solution(d);
        let expected = count_up(1).filter_map(|y|
            [d * y * y + 1, d * y * y - 1].to_iter.filter_map(|t|
                let x = isqrt(t.u64).i64;
                if x * x != t { none() };
                (x, y).some
            ).get_first
        ).get_first.as_some;
        assert_eq(|_|"calc_pell_fundamental_solution d={}".format((d,)), actual, expected)
    )
);

// 代表解が、解であること、互いに単数倍で移り合わないこと、総当たりで見つけた解をすべて単数倍で表せることを確かめる
test_pell_representatives : IO () = (
    _non_square_ds(41).to_iter.fold_m((), |d, _|
        range(1, 61).fold_m((), |m, _|
            let reps : Array (I64, I64) = calc_general_pell_representatives(d, m);
            let n = reps.@size;
            let msg = |what| "calc_general_pell_representatives d={} m={}: {}".format((d, m, what));
            assert(|_|msg("norm"), reps.to_iter.check_all(|r| _pell_norm(d, r).abs == m));;
            assert(|_|msg("distinct classes"), range(0, n).check_all(|i|
                range(0, i).check_all(|j| !_pell_same_class(d, reps.@(i), reps.@(j)))
            ));;
            assert(|_|msg("coverage"), _pell_brute_solutions(d, m, 200).to_iter.check_all(|(x, y)|
                [(x, y), (x, -y)].to_iter.check_all(|b| reps.to_iter.check_any(|r| _pell_same_class(d, b, r)))
            ))
        )
    )
);

// 総当たりで見つけた小さい解がすべて出るまでの出力が、重複のない非負の解であることを確かめる
test_pell_solutions : IO () = (
    _non_square_ds(31).to_iter.fold_m((), |d, _|
        range(1, 41).fold_m((), |m, _|
            let msg = |what| "iterate_general_pell_solutions d={} m={}: {}".format((d, m, what));
            let brute = _pell_brute_solutions(d, m, 50);
            // 解が大きくなると I64 があふれるので、小さい解が出そろうまでの出力だけを確かめる
            let sols : Array (I64, I64) = iterate_general_pell_solutions(d, m).take(64).to_array;
            let idxs = brute.to_iter.map(|b| sols.find_by(|s| s == b)).to_array;
            assert(|_|msg("coverage"), idxs.to_iter.check_all(is_some));;
            let len = idxs.to_iter.fold(0, |i, len| max(i.as_some + 1, len));
            let prefix = sols.get_sub(0, len);
            assert(|_|msg("valid"), prefix.to_iter.check_all(|(x, y)| x >= 0 && y >= 0 && _pell_norm(d, (x, y)).abs == m));;
            assert(|_|msg("distinct"), range(0, len).check_all(|i| range(0, i).check_all(|j| prefix.@(i) != prefix.@(j))))
        )
    );;
    assert_eq(|_|"iterate_general_pell_solutions no solution 1", (iterate_general_pell_solutions(2, 3).take(5).to_array : Array (I64, I64)), []);;
    assert_eq(|_|"iterate_general_pell_solutions no solution 2", (iterate_general_pell_solutions(10, 3).take(5).to_array : Array (I64, I64)), []);;
    pure()
);
