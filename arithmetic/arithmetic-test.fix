        [(3, 4, 5), (15, 8, 17), (35, 12, 37), (63, 16, 65), (99, 20, 101), (5, 12, 13), (21, 20, 29), (45, 28, 53), (77, 36, 85), (7, 24, 25), (55, 48, 73), (9, 40, 41), (33, 56, 65), (65, 72, 97), (11, 60, 61), (39, 80, 89), (13, 84, 85)].sort
    );;    

    pure()
);

test_factorize_flat : IO ();
test_factorize_flat = (
    assert_eq(|_|"factorize_flat 1", factorize_flat(1), []);;
    assert_eq(|_|"factorize_flat 2", factorize_flat(2), [2]);;
    assert_eq(|_|"factorize_flat 3", factorize_flat(3), [3]);;
    assert_eq(|_|"factorize_flat 4", factorize_flat(4), [2, 2]);;
    assert_eq(|_|"factorize_flat 6", factorize_flat(6), [2, 3]);;
    assert_eq(|_|"factorize_flat 12", factorize_flat(12), [2, 2, 3]);;
    assert_eq(|_|"factorize_flat 17", factorize_flat(17), [17]);;
    assert_eq(|_|"factorize_flat 360", factorize_flat(360), [2, 2, 2, 3, 3, 5]);;
    // 平方数（d > n/d の境界ケース）
    assert_eq(|_|"factorize_flat 9", factorize_flat(9), [3, 3]);;
    assert_eq(|_|"factorize_flat 25", factorize_flat(25), [5, 5]);;
    assert_eq(|_|"factorize_flat 49", factorize_flat(49), [7, 7]);;
    assert_eq(|_|"factorize_flat 36", factorize_flat(36), [2, 2, 3, 3]);;
    assert_eq(|_|"factorize_flat 100", factorize_flat(100), [2, 2, 5, 5]);;
    assert_eq(|_|"factorize_flat 1018081", factorize_flat(1018081), [1009, 1009]);; // 1009^2, 1009 is prime
    // 大きめの素数
    assert_eq(|_|"factorize_flat 1000003", factorize_flat(1000003), [1000003]);;
    // 大きめの合成数：1000000007 は素数なので、1000000007 * 2 = 2000000014
    assert_eq(|_|"factorize_flat 2000000014", factorize_flat(2000000014), [2, 1000000007]);;
    // 2^32 以上の素因数：405882859399 と 4294967311 = 2^32 + 15 は素数
    assert_eq(|_|"factorize_flat 811765718798", factorize_flat(2 * 405882859399), [2, 405882859399]);;
    assert_eq(|_|"factorize_flat 4294967311", factorize_flat(4294967311), [4294967311]);;
    pure()
);

test_factorize : IO ();
test_factorize = (
    assert_eq(|_|"factorize 1", factorize(1), []);;
    assert_eq(|_|"factorize 2", factorize(2), [(2, 1_U8)]);;
    assert_eq(|_|"factorize 4", factorize(4), [(2, 2_U8)]);;
    assert_eq(|_|"factorize 6", factorize(6), [(2, 1_U8), (3, 1_U8)]);;
    assert_eq(|_|"factorize 12", factorize(12), [(2, 2_U8), (3, 1_U8)]);;
    assert_eq(|_|"factorize 243", factorize(243), [(3, 5_U8)]);;
    assert_eq(|_|"factorize 360", factorize(360), [(2, 3_U8), (3, 2_U8), (5, 1_U8)]);;
    // 平方数（d > n/d の境界ケース）
    assert_eq(|_|"factorize 9", factorize(9), [(3, 2_U8)]);;
    assert_eq(|_|"factorize 25", factorize(25), [(5, 2_U8)]);;
    assert_eq(|_|"factorize 49", factorize(49), [(7, 2_U8)]);;
    assert_eq(|_|"factorize 36", factorize(36), [(2, 2_U8), (3, 2_U8)]);;
    assert_eq(|_|"factorize 100", factorize(100), [(2, 2_U8), (5, 2_U8)]);;
    assert_eq(|_|"factorize 81", factorize(81), [(3, 4_U8)]);; // 3^4
    assert_eq(|_|"factorize 1018081", factorize(1018081), [(1009, 2_U8)]);; // 1009^2
    assert_eq(|_|"factorize 1000003", factorize(1000003), [(1000003, 1_U8)]);;
    assert_eq(|_|"factorize 2000000014", factorize(2000000014), [(2, 1_U8), (1000000007, 1_U8)]);;
    // 2^32 以上の素因数：405882859399 と 4294967311 = 2^32 + 15 は素数
    assert_eq(|_|"factorize 811765718798", factorize(2 * 405882859399), [(2, 1_U8), (405882859399, 1_U8)]);;
    assert_eq(|_|"factorize 4294967311", factorize(4294967311), [(4294967311, 1_U8)]);;
    pure()
);

test_euler_tortient : IO ();
test_euler_tortient = (
    assert_eq(|_|"calc_totient 1", calc_totient(1), 1);;
    assert_eq(|_|"calc_totient 2", calc_totient(2), 1);;
    assert_eq(|_|"calc_totient 3", calc_totient(3), 2);;
    assert_eq(|_|"calc_totient 4", calc_totient(4), 2);;
    assert_eq(|_|"calc_totient 5", calc_totient(5), 4);;
    assert_eq(|_|"calc_totient 6", calc_totient(6), 2);;
    assert_eq(|_|"calc_totient 7", calc_totient(7), 6);;
    assert_eq(|_|"calc_totient 8", calc_totient(8), 4);;
    assert_eq(|_|"calc_totient 9", calc_totient(9), 6);;
    assert_eq(|_|"calc_totient 10", calc_totient(10), 4);;
    assert_eq(|_|"calc_totient 12", calc_totient(12), 4);;
    assert_eq(|_|"calc_totient 36", calc_totient(36), 12);; // 2^2 * 3^2 -> 36 * 1/2 * 2/3 = 12
    assert_eq(|_|"calc_totient 49", calc_totient(49), 42);; // 7^2 -> 42
    assert_eq(|_|"calc_totient 1000003", calc_totient(1000003), 1000002);; // prime
    pure()
);

