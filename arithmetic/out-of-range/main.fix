// 標準入力で選んだ引数で関数を呼ぶ。0：pow_modの指数が負、1：lift_crtの配列の長さが違う、2：lift_crtの法が0、3：範囲内
module Main;

import CPLib.Arithmetic::{lift_crt, pow_mod};
import CPLib.IO::read_i;
import Std::{IO, IO::println, ToString::to_string};

main : IO ();
main = (
    let case = *read_i;
    if case == 0 { println(3.pow_mod(-1, 7).to_string) };
    if case == 1 { println(lift_crt([1], [3, 5]).to_string) };
    if case == 2 { println(lift_crt([1, 0], [3, 0]).to_string) };
    println((3.pow_mod(2, 7), lift_crt([2, 3], [3, 5])).to_string)
);
