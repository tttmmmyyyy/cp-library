module CPLib.Arithmetic;

import BoolArray::{BoolArray, BoolArray::{@, fill_true, get_size, make, set}};
import CPLib.Trait::Integer;
import Std::{
    loop, undefined, Add, Array, Bool, I128, I64, Iterator, Multiplicative, Option, String, U128, U32, 
    U64, U8, Add::add, 
    Array::{@, @size, append, empty, fill, get_last, is_empty, mod, pop_back, push_back, set, sort, to_iter}, 
    I128::abs, 
    LessThan::min, 
    I64::{abs, bit_and, shift_left, shift_right}, Indexable::{iget, imod}, 
    Iterator::{
        check_all, count_up, filter, filter_map, flat_map, flatten, fold, generate, get_first, loop_iter, map, 
        loop_iter_s, push_front, range, range_step, take_while, to_array, to_dyn, Item
    }, 
    LoopState::{break, continue, is_break}, One::one, Option::{as_some, is_none, is_some, none, some}, 
    ToI128::i128, ToI64::i64, ToU128::u128, ToU32::u32, ToU64::u64, ToU8::u8, Tuple2::{act_0, act_1}, 
    U128::shift_right, U64::{bit_and, count_leading_zeros, shift_left, shift_right}, Zero::zero
};

// `x`を`m`で割った余りを非負で返す
//
// C言語の%演算子とは異なり、負の数に対しても正の余りを返す
//
// 制約：m >= 1
//
// 計算量：O(1)
//
// # Parameters
// - `m`: 法
// - `x`: 整数
//
// # Examples
// ```fix
// assert_eq(|_|"", (-7).pmod(3), 2)
// ```
pmod : I64 -> I64 -> I64;
pmod = |m, x| (
    let r = x % m;
    if r < 0 { r + m } else { r }
);

// `x`を`m`で割った余りを非負で返す
//
// 制約：1 <= m <= 2^63
_pmod_i128 : I128 -> I128 -> I64;
_pmod_i128 = |m, x| (
    let r = x % m;
    (if r < 0_I128 { r + m } else { r }).i64
);

// `x + y`を`|m|`で割った余りを（非負で）返す
//
// 制約：m != 0
//
// 計算量：O(1)
//
// # Parameters
// - `x`: 整数
// - `y`: 整数
// - `m`: 法
//
// # Examples
// ```fix
// assert_eq(|_|"", add_mod(5, 4, 7), 2)
// ```
add_mod : I64 -> I64 -> I64 -> I64;
add_mod = |x, y, m| _pmod_i128(m.i128.abs, x.i128 + y.i128);

// `x - y`を`|m|`で割った余りを（非負で）返す
// 
// 制約：m != 0
//
// 計算量：O(1)
//
// # Parameters
// - `x`: 整数
// - `y`: 整数
// - `m`: 法
//
// # Examples
// ```fix
// assert_eq(|_|"", sub_mod(2, 5, 7), 4)
// ```
sub_mod : I64 -> I64 -> I64 -> I64;
sub_mod = |x, y, m| _pmod_i128(m.i128.abs, x.i128 - y.i128);

// `x * y`を`|m|`で割った余りを（非負で）返す
//
// 制約：m != 0
//
// 計算量：O(1)
//
// # Parameters
// - `x`: 整数
// - `y`: 整数
// - `m`: 法
//
// # Examples
// ```fix
// assert_eq(|_|"", mul_mod(5, 4, 7), 6)
// ```
mul_mod : I64 -> I64 -> I64 -> I64;
mul_mod = |x, y, m| _pmod_i128(m.i128.abs, x.i128 * y.i128);

// 64ビット整数の平方根の整数部分を計算する
//
// 計算量：O(log log s)
//
// # Parameters
// - `s`: 64ビット整数
isqrt : U64 -> U64;
isqrt = |s| (
    if s <= 1_U64 { s };
    // s < 2^bitsなので、2^ceil(bits / 2)は√s以上。√s以上の値から始めたニュートン法は、単調に減って√sの整数部分で止まる
    let bits = 64_U64 - s.count_leading_zeros;
    let x0 = 1_U64.shift_left((bits + 1_U64) / 2_U64);
    let x1 = (x0 + s / x0) / 2_U64;
    loop((x0, x1), |(x0, x1)| 
        if x1 >= x0 { break $ x0 };
        let x0 = x1;
        let x1 = (x0 + s / x0) / 2_U64;
        continue $ (x0, x1)
    )
);

// 2つの整数の最大公約数（非負整数）を計算する
// 
// 制約：最大公約数 <= I64::maximum
//
// 計算量：O(log max(|a|, |b|))
//
// # Parameters
// - `a`: 整数
// - `b`: 整数
calc_gcd : I64 -> I64 -> I64;
calc_gcd = |a, b| (
    // 互除法で溢れるのは`I64::minimum % -1`だけで、これは`a`か`b`が-1のときに限って現れる
    if a == -1 || b == -1 { 1 };
    _calc_gcd(a, b)
);

_calc_gcd : I64 -> I64 -> I64;
_calc_gcd = |a, b| (
    if b == 0 { a.abs };
    _calc_gcd(b, a % b)
);

// 拡張ユークリッドの互除法
// 
// 2つの整数 `a`, `b` に対して、その最大公約数 `d >= 0` および、`ax + by = d` を満たす整数 `x`, `y` を求める
//
// 制約：最大公約数 <= I64::maximum
//
// 計算量：O(log max(|a|, |b|))
//
// # Returns 
// `(d, (x, y))`
// 
// # Parameters
// - `a`: 整数
// - `b`: 整数
//
// # Examples
// ```fix
// let (d, (x, y)) = ext_gcd(12, 18);
// assert_eq(|_|"", d, 6);;
// assert_eq(|_|"", 12 * x + 18 * y, 6)
// ```
ext_gcd : I64 -> I64 -> (I64, (I64, I64));
ext_gcd = |a, b| (
    // 互除法で溢れるのは`I64::minimum % -1`だけで、これは`a`か`b`が-1のときに限って現れる
    if a == -1 { (1, (-1, 0)) };
    if b == -1 { (1, (0, -1)) };
    _ext_gcd(a, b)
);

_ext_gcd : I64 -> I64 -> (I64, (I64, I64));
_ext_gcd = |a, b| (
    if b == 0 { 
        if a >= 0 { (a, (1, 0)) } else { (-a, (-1, 0)) }
    };
    let (d, (x1, y1)) = _ext_gcd(b, a % b);
    (d, (y1, x1 - (a / b) * y1))
);

// `x^e`を`m`で割った余りを計算する
//
// 制約：e >= 0, m >= 1
//
// 計算量：O(log e)
//
// # Parameters
// - `e`: 指数
// - `m`: 法
// - `x`: 底
//
// # Examples
// ```fix
// assert_eq(|_|"", 2.pow_mod(10, 1000), 24) // 2^10 = 1024
// ```
pow_mod : I64 -> I64 -> I64 -> I64;
pow_mod = |e, m, x| (
    if e < 0 { undefined("[CPLib.Arithmetic::pow_mod] `e` is negative") };
    let e = e.u64;
    let m = m.abs;
    let x = x.pmod(m).u64;
    x.pow_mod_u(e, m.u64).i64
);

// `x^e`を`m`で割った余りを計算する（unsigned版）
//
// 制約：m >= 1
//
// 計算量：O(log e)
//
// # Parameters
// - `e`: 指数
// - `m`: 法
// - `x`: 底
pow_mod_u : U64 -> U64 -> U64 -> U64;
pow_mod_u = |e, m, x| (
    // 次で求めるim = ceil(2^64 / m)は、m = 1のとき64ビットに収まらないので、先に返す
    if m == 1_U64 { 0_U64 };
    // 法が2^32未満なら、積が64ビットに収まるので、かけ算の余りを割り算なしで求める（`_mul_mod_barrett`）。
    // 128ビットの`%`はライブラリ関数の呼び出しになり遅いので、それを使うのは法が2^32以上のときだけにする。
    if m < 4294967296_U64 {
        let im = 18446744073709551615_U64 / m + 1_U64; // ceil(2^64 / m)
        loop((e, 1_U64, x % m), |(e, pow, x)|
            if e == 0_U64 { break $ pow };
            let pow = if e.bit_and(1_U64) == 1_U64 { _mul_mod_barrett(m, im, pow, x) } else { pow };
            continue $ (e.shift_right(1_U64), pow, _mul_mod_barrett(m, im, x, x))
        )
    };
    loop((e, 1_U64, x), |(e, pow, x)|
        if e == 0_U64 { break $ pow };
        let pow = if e.bit_and(1_U64) == 1_U64 { _mul_mod_u(m, pow, x) } else { pow };
        continue $ (e.shift_right(1_U64), pow, _mul_mod_u(m, x, x))
    )
);

// `x * y`を`m`で割った余りを、割り算を使わずに返す（Barrett reduction）
//
// `im = ceil(2^64 / m)`とすると、`q = floor(x * y * im / 2^64)`は`floor(x * y / m)`か、それより1大きい値になる。
// `x * y - q * m`が負になったときは`m`を足す。
//
// 制約：2 <= m < 2^32, im = ceil(2^64 / m), 0 <= x, y < m
_mul_mod_barrett : U64 -> U64 -> U64 -> U64 -> U64;
_mul_mod_barrett = |m, im, x, y| (
    let z = x * y;
    let qm = (z.u128 * im.u128).shift_right(64_U128).u64 * m;
    if z < qm { z + m - qm } else { z - qm }
);

// `x`の`e`乗を、繰り返し二乗法で計算します。
//
// `*`と`one`を持つ型（`Multiplicative`を実装した型）なら何にでも使えます。たとえば`I64`、`F64`、`ZP p`や、自分で作った行列の型です。
// `*`は結合的で、`one`はその単位元でなければなりません。
//
// 制約：e >= 0
//
// 計算量：`*`をO(log e)回
//
// # Parameters
// - `e`: 指数
// - `x`: 底
//
// # Examples
// ```fix
// assert_eq(|_|"", 3.power(4), 81)
// ```
power : [a : Multiplicative] I64 -> a -> a;
power = |e, x| (
    if e < 0 { undefined("[CPLib.Arithmetic::power] the exponent is negative") };
    if e == 0 { one };
    // 最上位のビットを処理したら、xをそれ以上二乗せずに終える（使わない二乗が溢れないように）
    loop((e, one, x), |(e, pow, x)|
        let pow = if e.bit_and(1) == 1 { pow * x } else { pow };
        let e = e.shift_right(1);
        if e == 0 { break $ pow };
        continue $ (e, pow, x * x)
    )
);

// `x * y`を`m`で割った余りを返す
//
// 制約：m >= 1
_mul_mod_u : U64 -> U64 -> U64 -> U64;
_mul_mod_u = |m, x, y| (x.u128 * y.u128 % m.u128).u64;

// `ax = 1 mod m`なる`x`のうち、`0 <= x < m`を満たすものを返す
//
// 制約：gcd(a, m) = 1, m >= 1
//
// 計算量：O(log m)
//
// # Parameters
// - `m`: 法
// - `a`: 整数
//
// # Examples
// ```fix
// assert_eq(|_|"", 3.inv_mod(7), 5) // 3 * 5 = 15 = 1 mod 7
// ```
inv_mod : I64 -> I64 -> I64;
inv_mod = |m, a| (
    let m = m.abs;
    let (g, x) = _inv_gcd(a, m);
    if g != 1 { undefined("[CPLib.Arithmetic::inv_mod] `a` is not coprime to `m`") };
    x
);

// [0, n)の範囲での素数テーブルを作成する
//
// 配列（`BoolArray`）`table`は素数テーブルであり、`table.@(n)`が`true`の場合に`n`が素数であることを意味する。
// 
// 注意：戻り値の要素に`@(n)`でアクセスするには`import BoolArray;`が必要です。
//
// 制約：n >= 1
//
// 計算量：O(n log log n)
//
// # Parameters
// - `n` : 素数テーブルの上限（exclusive）
//
// # Examples
// ```fix
// import BoolArray;
//
// let table = calc_prime_table(10);
// assert(|_|"", table.@(7));;
// assert(|_|"", !table.@(9))
// ```
calc_prime_table : I64 -> BoolArray;
calc_prime_table = |size| (
    let table = BoolArray::make(size).fill_true;
    let size = table.get_size;
    let table = table.set(0, false).set(1, false);
    let table = range(2, size).loop_iter(table, |n, table|
        if n > (size - 1) / n { break $ table };
        if !table.@(n) { continue $ table };
        let table = range_step(2 * n, size, n).fold(table, |m, table| table.set(m, false));
        continue $ table
    );
    table
);

// `calc_prime_table`の別名（非推奨）
create_prime_table : I64 -> BoolArray = calc_prime_table;
DEPRECATED[create_prime_table, "Use `CPLib.Arithmetic::calc_prime_table` instead."];

// [0, n)の範囲での素数リストを作成する
//
// 制約：n >= 1
//
// 計算量：O(n log log n)
//
// # Parameters
// - `n` : 素数リストの上限（exclusive）
calc_prime_list : I64 -> Array U32;
calc_prime_list = |n| (
    let table = calc_prime_table(n);
    let count = range(0, n).fold(0, |i, cnt| if table.@(i) { cnt + 1 } else { cnt });
    let list = empty(count);
    let list = range(0, n).fold(list, |p, list|
        if table.@(p) { list.push_back(p.u32) } else { list }
    );
    list
);

// `calc_prime_list`の別名（非推奨）
create_prime_list : I64 -> Array U32 = calc_prime_list;
DEPRECATED[create_prime_list, "Use `CPLib.Arithmetic::calc_prime_list` instead."];

// 線形ふるいを用いて、[0, n)の範囲で、各数の最小の素因数を格納した配列と、素数のリストを作成する
// 
// 計算量：O(n)
//
// # Parameters
// - `n` : 上限（exclusive）
// 
// # Returns
// `(lp, ps)`
// - `lp`: 最小素因子テーブル。長さnの配列で、`lp.@(i)`は`i`の最小の素因数。`lp.@(0)`, `lp.@(1)`は0。
// - `ps`: [0, n)の範囲の素数のリスト
calc_lp_table : U32 -> (Array U32, Array U32);
calc_lp_table = |n| (
    let n = n.i64;
    let lp = fill(n, 0_U32);
    let ps = empty(n / 10);
    range(2, n).fold((lp, ps), |i, (lp, ps)|
        let (lp, ps) = if lp.@(i) == 0_U32 { (lp.set(i, i.u32), ps.push_back(i.u32)) } else { (lp, ps) };
        // iの最小の素因数以下の素数pについて、i * pの最小の素因数はp
        let lp_i = lp.@(i);
        let lp = loop((0, lp), |(k, lp)|
            if k >= ps.@size { break $ lp };
            let p = ps.@(k);
            if p > lp_i || i * p.i64 >= n { break $ lp };
            continue $ (k + 1, lp.set(i * p.i64, p))
        );
        (lp, ps)
    )
);

// `calc_lp_table`の別名（非推奨）
linear_sieve : U32 -> (Array U32, Array U32) = calc_lp_table;
DEPRECATED[linear_sieve, "Use `CPLib.Arithmetic::calc_lp_table` instead."];

// Pollard の ρ 法（Brent の変種）で、合成数`n`の、1 でも`n`でもない約数を1つ見つける
//
// 制約：`n`は奇数の合成数
//
// 計算量：O(n^(1/4) log(n))（期待値）
//
// # Parameters
// - `n`: 奇数の合成数
_find_divisor_rho : I64 -> I64 = |n| (
    // f(x) = x^2 + c (mod n) で作る列が mod p で巡回することを使う。約数が見つからなければ c を変える。
    count_up(1).filter_map(|c|
        let f = |x| add_mod(mul_mod(x, x, n), c, n);
        // 1 回の gcd でまとめて調べる |x - y| の個数
        let batch = 128;
        // x を固定して y を r ステップ進め、|x - y| の積の gcd を batch ステップごとにとる。r は倍々にする。
        let (x, ys, g) = loop((2, 1), |(y, r)|
            let x = y;
            let y = range(0, r).fold(y, |_, y| f(y));
            let (y, found) = loop((0, y, 1), |(k, y, q)|
                if k >= r { break $ (y, none()) };
                let ys = y;
                let (y, q) = range(0, min(batch, r - k)).fold((y, q), |_, (y, q)|
                    let y = f(y);
                    (y, mul_mod(q, (x - y).abs, n))
                );
                let g = calc_gcd(q, n);
                if g != 1 { break $ (y, (ys, g).some) };
                continue $ (k + batch, y, q)
            );
            match found {
                none() => continue $ (y, 2 * r),
                some((ys, g)) => break $ (x, ys, g)
            }
        );
        // 積が n の倍数になって g = n となったら、まとめる前の位置から 1 ステップずつ調べ直す
        let g = if g != n { g } else {
            loop(ys, |ys|
                let ys = f(ys);
                let g = calc_gcd((x - ys).abs, n);
                if g != 1 { break $ g };
                continue $ ys
            )
        };
        if g == n { none() } else { g.some }
    ).get_first.as_some
);

// 1000 以下の素因数を持たない`n`の素因数を、昇順に重複ありで返す（Pollard の ρ 法）
//
// 制約：n >= 1、nは1000以下の素因数を持たない
//
// # Parameters
// - `n`: 素因数分解する数
_factorize_large_factors : I64 -> Array I64 = |n| (
    // 素数になるまで約数で分ける。n は奇数なので、ρ 法の前提を満たす。
    loop(([n], []), |(stack, ps)|
        if stack.is_empty { break $ ps.sort };
        let k = stack.get_last.as_some;
        let stack = stack.pop_back;
        if k == 1 { continue $ (stack, ps) };
        if k.u64.is_prime { continue $ (stack, ps.push_back(k)) };
        let g = _find_divisor_rho(k);
        continue $ (stack.push_back(g).push_back(k / g), ps)
    )
);

// 数を素因数分解する（素因子を重複ありのフラットな配列で返す）
//
// 1000 以下の素因数を試し割りで取り除いたあと、残りを Pollard の ρ 法で分ける。
//
// 制約：n >= 1
//
// 計算量：O(n^(1/4) log(n))（期待値）
//
// # Parameters
// - `n`: 素因数分解する数
//
// # Returns
// 素因数分解の結果。素因子を昇順に並べた配列（同じ素因子はその指数分だけ繰り返し現れる）。
// `n`が1の場合は空の配列を返す。
factorize_flat : I64 -> Array I64;
factorize_flat = |n| (
    // 試し割りの途中で d^2 > n となれば、残りは 1 か素数
    let (d, n, factors) = loop((2, n, []), |(d, n, factors)|
        let q = n / d;
        if d > q || d > 1000 { break $ (d, n, factors) };
        if n - q * d != 0 { continue $ (d + 1, n, factors) };
        continue $ (d, q, factors.push_back(d))
    );
    if d <= 1000 { if n > 1 { factors.push_back(n) } else { factors } };
    factors.append(_factorize_large_factors(n))
);

// 数を素因数分解する（素因子と指数のペアの配列で返す）
//
// 1000 以下の素因数を試し割りで取り除いたあと、残りを Pollard の ρ 法で分ける。
//
// 制約：n >= 1
//
// 計算量：O(n^(1/4) log(n))（期待値）
//
// # Parameters
// - `n`: 素因数分解する数
//
// # Returns
// 素因数分解の結果。
// `(p, e)`の配列で、`p`は素因子、`e`はその指数を表す。`p`は昇順に並ぶ。
// `n`が1の場合は空の配列を返す。
factorize : I64 -> Array (I64, U8);
factorize = |n| (
    // 試し割りの途中で d^2 > n となれば、残りは 1 か素数
    let (d, n, factors) = loop((2, n, []), |(d, n, factors)|
        let q = n / d;
        if d > q || d > 1000 { break $ (d, n, factors) };
        if n - q * d != 0 { continue $ (d + 1, n, factors) };
        let (n, e) = loop((n, 0_U8), |(n, e)|
            if n % d != 0 { break $ (n, e) };
            continue $ (n / d, e + 1_U8)
        );
        continue $ (d + 1, n, factors.push_back((d, e)))
    );
    if d <= 1000 { if n > 1 { factors.push_back((n, 1_U8)) } else { factors } };
    _factorize_large_factors(n).to_iter.fold(factors, |p, factors|
        let k = factors.@size;
        if k > 0 && (let (q, _) = factors.@(k - 1); q == p) { factors.mod(k - 1, |(q, e)| (q, e + 1_U8)) };
        factors.push_back((p, 1_U8))
    )
);

// オイラーのトーシェント関数 φ(n) を計算する
//
// 制約：n >= 1
//
// 計算量：O(n^(1/4) log(n))（期待値）
//
// # Parameters
// - `n`: 正の整数
calc_totient : I64 -> I64;
calc_totient = |n| factorize(n).to_iter.fold(n, |(p, _), tot| tot / p * (p - 1));

// `calc_totient`の別名（非推奨）
euler_tortient : I64 -> I64 = calc_totient;
DEPRECATED[euler_tortient, "Use `CPLib.Arithmetic::calc_totient` instead."];

// 0 <= i < n に対するオイラーのトーシェント関数 φ(i) の表を作成する
//
// `table.@(i)` が φ(i) の値となる。ただし `table.@(0) = 0` とする。
//
// 計算量：O(n log log n)
//
// # Parameters
// - `n`: 表の上限（exclusive）
calc_totient_table : I64 -> Array I64;
calc_totient_table = |n| (
    let table = fill(n, 0);
    let table = range(0, n).fold(table, |i, table| table.set(i, i));
    range(2, n).fold(table, |i, table|
        if table.@(i) != i { table };
        range_step(i, n, i).fold(table, |j, table| table.set(j, table.@(j) / i * (i - 1)))
    )
);

// `calc_totient_table`の別名（非推奨）
euler_tortient_table : I64 -> Array I64 = calc_totient_table;
DEPRECATED[euler_tortient_table, "Use `CPLib.Arithmetic::calc_totient_table` instead."];

// 最小素因子テーブルを用いて、数を素因数分解する
//
// 制約：n < |lp_table|
//
// 計算量：O(log n)
//
// # Parameters
// - `n`: 素因数分解する数
// - `lp_table`: 最小素因子テーブル。最小素因子テーブルの定義は`calc_lp_table`のコメントを参照。
// 
// # Returns
// 素因数分解の結果。
// `(p, e)`の配列で、`p`は素因子、`e`はその指数を表す。`p`は昇順に並ぶ。
// `n`が0の場合は空の配列を返す。
//
// # Examples
// ```fix
// let (lp, _) = calc_lp_table(100_U32);
// assert_eq(|_|"", factorize_via_lp_table(12_U32, lp), [(2_U32, 2_U8), (3_U32, 1_U8)]) // 12 = 2^2 * 3
// ```
factorize_via_lp_table : U32 -> Array U32 -> Array (U32, U8) = |n, lp_table| (
    loop((n, []), |(n, fact)|
        let p = lp_table.@(n.i64);
        if p < 2.u32 { fact.break };
        let n_fact = fact.@size;
        let fact = if fact.@size == 0 || fact[n_fact-1][^0].iget != p { 
            fact.push_back((p, 1.u8))
        } else {
            fact[n_fact-1][^1].imod(add(1.u8))
        };
        let n = n / p;
        (n, fact).continue
    )
);

// Miller-Rabin 素数判定法
// 
// 計算量：O(log n)
//
// # Parameters
// - `n`: 調べる数
is_prime : U64 -> Bool;
is_prime = |n| (
    if n < 2_U64 { false };
    // Montgomery乗算は法が奇数であることを要する
    if n.bit_and(1_U64) == 0_U64 { n == 2_U64 };
    let (s, d) = loop((0, n - 1_U64), |(s, d)|
        if d.bit_and(1_U64) == 0_U64 { continue $ (s + 1, d.shift_right(1_U64)) } else { break $ (s, d) }
    );
    // 数xのMontgomery表現は x * 2^64 mod n。`mul`はMontgomery表現どうしの積を返す
    let n_inv = range(0, 6).fold(n, |_, x| x * (2_U64 - n * x)); // n * n_inv = 1 (mod 2^64)
    let mul = |x, y| _montgomery_reduce(n, n_inv, x.u128 * y.u128);
    let one = (0_U64 - n) % n; // 2^64 mod n
    let minus_one = n - one;
    let r2 = (one.u128 * one.u128 % n.u128).u64; // 2^128 mod n。`mul(x, r2)`はxのMontgomery表現
    // 底は、4759123141未満のすべての数を正しく判定する3個と、2^64未満のすべての数を正しく判定する7個
    // （https://miller-rabin.appspot.com）。4759123141は、底2, 7, 61のすべてで素数と区別できない最小の合成数。
    let bases = if n < 4759123141_U64 {
        [2_U64, 7_U64, 61_U64]
    } else {
        [2_U64, 325_U64, 9375_U64, 28178_U64, 450775_U64, 9780504_U64, 1795265022_U64]
    };
    match bases.to_iter.loop_iter_s((), |a, _|
        let a = a % n;
        if a == 0_U64 { continue $ () };
        // x = a^d
        let x = loop((d, one, mul(a, r2)), |(e, pow, b)|
            if e == 0_U64 { break $ pow };
            let pow = if e.bit_and(1_U64) == 1_U64 { mul(pow, b) } else { pow };
            continue $ (e.shift_right(1_U64), pow, mul(b, b))
        );
        if x == one || x == minus_one { continue $ () };
        // a^(2^r * d) = -1 となる 1 <= r < s があれば、nは素数である可能性がある
        let maybe_prime = range(1, s).loop_iter_s(x, |_, x|
            let x = mul(x, x);
            if x == minus_one { break $ () };
            continue $ x
        ).is_break;
        if maybe_prime { continue $ () } else { break $ false }
    ) {
        break(r) => r,
        continue(_) => true
    }
);

// Montgomery簡約：t * 2^(-64) mod n を返す
//
// 制約：nは奇数, n * n_inv = 1 (mod 2^64), t < n * 2^64
_montgomery_reduce : U64 -> U64 -> U128 -> U64;
_montgomery_reduce = |n, n_inv, t| (
    // m = t * n_inv (mod 2^64) とすると t - m * n は 2^64 で割り切れ、(t - m * n) / 2^64 は (-n, n) に入る
    let hi = t.shift_right(64_U128).u64;
    let m = t.u64 * n_inv;
    let mn_hi = (m.u128 * n.u128).shift_right(64_U128).u64;
    if hi >= mn_hi { hi - mn_hi } else { hi + (n - mn_hi) }
);

// Miller-Rabin 素数判定法（32bit版）
//
// `is_prime(n.u64)`と同じ。
// 
// # Parameters
// - `n`: 調べる数
is_prime_32 : U32 -> Bool;
is_prime_32 = |n| is_prime(n.u64);
DEPRECATED[is_prime_32, "Use `CPLib.Arithmetic::is_prime` instead."];

// @param b `1 <= b`
// @return pair (g, x) s.t. g = gcd(a, b), xa = g (mod b), 0 <= x < b/g
// 
// https://github.com/atcoder/ac-library/blob/master/atcoder/internal_math.hpp#L107
_inv_gcd : I64 -> I64 -> (I64, I64);
_inv_gcd = |a, b| (
    let a = a.pmod(b);
    if a == 0 { (b, 0) };

    let s = b; let t = a;
    let m0 = 0; let m1 = 1;

    let (s, m0) = loop((s, t, m0, m1), |(s, t, m0, m1)|
        if t == 0 { break $ (s, m0) };
        let u = s / t;
        let s = s - t * u;
        let m0 = m0 - m1 * u;

        let tmp = s;
        let s = t;
        let t = tmp;
        let tmp = m0;
        let m0 = m1;
        let m1 = tmp;
        continue $ (s, t, m0, m1)
    );

    let m0 = if m0 < 0 { m0 + b / s } else { m0 };
    (s, m0)
);

// 連立合同方程式 P: x = r(i) (mod m(i)) を解きます。
// 
// 解が存在するときは P <=> x = y (mod z), z = lcm(m(i)) となるような (y, z) を返します。
// 
// 解が存在しない場合は、`(0, 0)`を返します。
// 
// 制約：|rs| = |ms|, ms.@(i) >= 1, lcm(ms)が`I64`に収まる
//
// 計算量：O(n log lcm(ms))、n = |rs|
// 
// # Parameters
// - `rs`: r(i)の配列
// - `ms`: m(i)の配列
//
// # Examples
// ```fix
// // x = 2 (mod 3) かつ x = 3 (mod 5) <=> x = 8 (mod 15)
// assert_eq(|_|"", lift_crt([2, 3], [3, 5]), (8, 15));;
// // x = 0 (mod 2) かつ x = 1 (mod 4) には解がない
// assert_eq(|_|"", lift_crt([0, 1], [2, 4]), (0, 0))
// ```
lift_crt : Array I64 -> Array I64 -> (I64, I64);
lift_crt = |r, m| (
    if r.@size != m.@size { undefined("[CPLib.Arithmetic::lift_crt] `rs` and `ms` have different sizes") };
    let n = r.@size;
    let r0 = 0; let m0 = 1;

    range(0, n).loop_iter((r0, m0), |i, (r0, m0)|
        if m.@(i) <= 0 { undefined("[CPLib.Arithmetic::lift_crt] `ms` has an element less than 1") };
        let r1 = r.@(i).pmod(m.@(i));
        let m1 = m.@(i);
        let (r0, r1, m0, m1) = if m0 < m1 {
            (r1, r0, m1, m0)
        } else {
            (r0, r1, m0, m1)
        };
        if m0 % m1 == 0 {
            if r0 % m1 != r1 {
                break $ (0, 0)
            };
            continue $ (r0, m0)
        };
        let (g, im) = _inv_gcd(m0, m1);
        let u1 = m1 / g;
        if (r1 - r0) % g != 0 {
            break $ (0, 0)
        };
        let x = (r1 - r0) / g % u1 * im % u1;
        let r0 = r0 + x * m0;
        let m0 = m0 * u1;
        let r0 = r0 + if r0 < 0 { m0 } else { 0 };
        continue $ (r0, m0)
    )
);

// 素数pの原始根r（1 <= r < p）を一つ求める。
// 
// # Parameters
// - `p`: 素数
_calc_primitive_root : I64 -> I64;
_calc_primitive_root = |p| (
    // 各 1 <= g <= p-1 ごとに、g が原子根であるかを調べる。
    // 全ての φ(p) = p-1 の素因子qに対し g^(φ(p) / q) != 1 であるならば、gは原子根である。

    let factors = factorize(p - 1).to_iter.map(|(q, _)| q).to_array;

    range(1, p).filter_map(|g|
        let ok = factors.to_iter.check_all(|q|
            let e = (p - 1) / q;
            g.pow_mod(e, p) != 1
        );
        if ok { some(g) } else { none() }
    ).get_first.as_some
);

// 素数pの原始根r（1 <= r < p）を一つ求める。
// 
// https://cp-algorithms.com/algebra/primitive-root.html#algorithm-for-finding-a-primitive-root
// 
// 制約：pは素数
//
// 計算量：O(sqrt(p))。pが`CPLib.ZP`に定義されている素数ならO(1)
// 
// # Parameters
// - `p`: 素数
calc_primitive_root : I64 -> I64;
calc_primitive_root = |p| (
    if p == 1e9 + 7 { 5 };
    if p == 1e9 + 9 { 13 };
    if p == 998244353 { 3 };
    if p == 754974721 { 11 };
    if p == 167772161 { 3 };
    if p == 469762049 { 3 };
    p._calc_primitive_root
);

// 0 <= i < n に対する floor((a * i + b) / m) の和を計算する
// 
// ac-libraryのmathにある同名の関数の移植です。
// 
// 制約：0 <= n < 2^32, 1 <= m < 2^32
//
// 計算量：O(log m)
// 
// # Parameters
// - `n`: 項の数
// - `m`: 除数
// - `a`: `i`の係数
// - `b`: 定数項
//
// # Examples
// ```fix
// // floor(1/3) + floor(3/3) + floor(5/3) + floor(7/3) = 0 + 1 + 1 + 2
// assert_eq(|_|"", floor_sum(4, 3, 2, 1), 4)
// ```
floor_sum : I64 -> I64 -> I64 -> I64 -> I64;
floor_sum = |n, m, a, b| (
    let ans = 0_U64;
    let (ans, a) = if a < 0 {
        let a2 = a.pmod(m).u64;
        let ans = ans - 1_U64 * n.u64 * (n - 1).u64 / 2_U64 * ((a2 - a.u64) / m.u64);
        let a = a2;
        (ans, a)
    } else { (ans, a.u64) };
    let (ans, b) = if b < 0 {
        let b2 = b.pmod(m).u64;
        let ans = ans - n.u64 * ((b2 - b.u64) / m.u64);
        let b = b2;
        (ans, b)
    } else { (ans, b.u64) };
    (ans + _floor_sum_unsigned(n.u64, m.u64, a, b)).i64
);

_floor_sum_unsigned : U64 -> U64 -> U64 -> U64 -> U64;
_floor_sum_unsigned = |n, m, a, b| (
    let ans = 0_U64;
    loop((ans, n, m, a, b), |(ans, n, m, a, b)|
        let (ans, a) = if a >= m {
            let ans = ans + n * (n - 1_U64) / 2_U64 * (a / m);
            let a = a % m;
            (ans, a)
        } else { (ans, a) };
        let (ans, b) = if b >= m {
            let ans = ans + n * (b / m);
            let b = b % m;
            (ans, b)
        } else { (ans, b) };
        let y_max = a * n + b;
        if y_max < m { break $ ans };
        let n = y_max / m;
        let b = y_max % m;
        let (m, a) = (a, m);
        continue $ (ans, n, m, a, b)
    )
);

// 原始ピタゴラス数`(a, b, c)`を列挙する
// 
// `a^2 + b^2 = c^2`を満たす正の整数の組`(a, b, c)`で、`gcd(a, b, c) = 1`を満たすものを列挙する
// 
// また、このような`a`, `b`は必ず片方が奇数でもう片方が偶数である。
// この関数の戻り値では`a`が奇数、`b`が偶数となる。
// 
// 制約：c_max >= 1
//
// 計算量：O(c_max log c_max)
// 
// # Parameters
// - `c_max`: `c`の上限（inclusive）
calc_pythagorean_triples : I64 -> Array (I64, I64, I64) = |c_max| (
    let m_max = isqrt((c_max - 1).u64).i64;
    range(1, m_max+1).fold([], |m, triples|
        let n_max = isqrt((c_max - m * m).u64).i64;
        range_step(m+1, n_max+1, 2).fold(triples, |n, triples|
            let d = calc_gcd(n, m);
            if d > 1 { triples };
            let a = n*n - m*m;
            let b = 2*n*m;
            let c = n*n + m*m;
            triples.push_back((a, b, c))
        )
    )
);

// `calc_pythagorean_triples`の別名（非推奨）
pythagorean_triples : I64 -> Array (I64, I64, I64) = calc_pythagorean_triples;
DEPRECATED[pythagorean_triples, "Use `CPLib.Arithmetic::calc_pythagorean_triples` instead."];

// ===== 一般ペル方程式 =====
// 
// 正の非平方数dに対し、w = root(d) とする。
// 
// Z[w] の単数は、符号を除いて eps^n (n は整数) という形である。epsは基本単数。
// 
// t in Q[w] が簡約であるとは、1 < t, -1 < t' < 0 であることをいう（t'は共役）。
// 
// t in Q[w] \ Q に対し、対応する格子を L(t) = Z + tZ と定義する。
// 
// t in Q[w] の連分数展開 t(0) = t, t(i) = a(i) + 1/t(i+1) （a(i) は t(i) の整数部分）は、途中から簡約になり、初めて簡約になった場所から巡回する（Lagrange, Galois）。
// 
// t を連分数展開して u になったとき、展開は t = g u (1次分数変換) となる g in GL2(Z) を与え、ここから L(t) = r L(u) となる r in Q[w] が得られる。
// 
// 定理（格子 L(t) の極小点を使って示せる）：
// t, u in Q[w] が簡約で、r in Q[w], |r| <= 1 に対し L(t) = r L(u) となっているとする。
// このとき、ある i について t(i) = u であり、r はこの連分数展開から上の方法で（符号を除いて）得られる。
// 
// ■ ペル方程式 x^2 - dy^2 = ±1
// 
// これは Z[w] の単元（ノルムが±1の元）を求める問題である。これは Z[w] = r Z[w] となる元 r に他ならない。
// Z[w] = L(s + w) (s = floor(w)) であり、s + w は簡約である。
// よって、s + w を連分数展開すると、|r| <= 1 な単数がすべて得られる。特に、r = 1 を除いて初めて得たそのような r は基本単数の逆数であり、その逆数が基本単数である。
// 
// ■ 一般ペル方程式 x^2 - dy^2 = ±m
// 
// m を m / (平方数) に取り替えることで、x, y が互いに素な解（原始解）を求める問題に帰着できる。
//
// 以下の集合の対応がある：
//   { x^2 - dy^2 = ±m の原始解の単元倍による軌道 }
// = { Z[w] のイデアル I で、原始的で、指数 |Z[w]/I| が |m| で、単項生成なもの } ※ イデアルが原始的とは、k Z[w] (k > 0 は整数) に含まれないイデアルのこと。
// ⊂ { Z[w] のイデアル I で、原始的で、指数 |Z[w]/I| が |m| なもの }
// = { 環準同型 Z[w] -> Z/m } ※ Kernelで対応
// = { z in Z/m : z^2 = d } ※ w の行き先で対応
// 
// z in Z/m : z^2 = d をとったとき、対応するイデアルは I(z) = |m|Z + (z + w)Z である。
// これが単項生成であるかどうかを判定し、生成元をひとつ求め、すべての単元を乗算すればよい。
//
// t = (z + w)/|m| とおくと、I(z) = |m| L(t) であり、I(z) が単項生成であるとは、L(t) = r Z[w] となる r in Q[w] があることに他ならない。
// よって、t を連分数展開することで L(t) = r L(u) なる r, u の組を作り、L(u) = Z[w] となることがあるか（つまり u in Z[w] となるか）を見れば良い。
// 連分数展開はいずれ簡約になり、そのあとは巡回するので、はじめて簡約になってから再訪するまでに u in Z[w] とならなければ、単項生成ではないことが言える。

// `I64`の値`x`を、`Integer`の演算（0、1、足し算、引き算）だけを使って`a`の値にする
//
// 計算量：O(log |x|)回の`a`の演算
//
// # Parameters
// - `x`: 整数
_integer_from_i64 : [a : Integer] I64 -> a = |x| (
    // -x が溢れないように、負の数は -(x + 1) - 1 として扱う
    if x < 0 { zero - one - _integer_from_i64(-(x + 1)) };
    if x == 0 { zero };
    let h = _integer_from_i64(x / 2);
    if x % 2 == 0 { h + h } else { h + h + one }
);

// PQaアルゴリズムの1ステップ
// 
// t = (p + w) / q と表示される無理数の連分数展開を1ステップ進める。
// 整数部分 a と次の無理数 u を表示する (p, q) を返す。t = a + 1/u。
// 
// # Parameters
// - `d` : 平方数でない正の自然数
// - `s` : w = root(d) の整数部分
// - `pq`: `(p, q)`。 q != 0, q | (d - p^2)
_pqa_step : I64 -> I64 -> (I64, I64) -> (I64, (I64, I64)) = |d, s, (p, q)| (
    // flooor(x / y) を計算する。y > 0 を仮定
    let floor_div : I64 -> I64 -> I64 = |x, y| (
        if x >= zero { x / y } else { (x - y + one) / y } 
    );
    let a = if q > zero { floor_div(p + s, q) } else { floor_div(-(p + s + one), -q) };
    let p = a * q - p;
    // p は |m| 程度まで大きくなりうるので、p^2 は I128 で計算する。商は I64 に収まる。
    let q = ((d.i128 - p.i128 * p.i128) / q.i128).i64;
    (a, (p, q))
);

// PQaアルゴリズムの1ステップ：行列の更新
// 
// g = (i, j, k, l) に右から (a, 1, 1, 0) を乗算する
// 
// # Parameters
// - `g` : 行列
_pqa_step_g : [a : Integer] (a, a, a, a) -> I64 -> (a, a, a, a) = |g, a| (
    let a = _integer_from_i64(a);
    let (i, j, k, l) = g; 
    (a * i + j, i, a * k + l, k)
);

// t = (p + w) / q が簡約かどうか判定する
// 
// # Parameters
// - `s` : w = root(d) の整数部分
// - `pq`: `(p, q)`。 q != 0
_pqa_reduced : I64 -> (I64, I64) -> Bool = |s, (p, q)| (
    0 < q && 0 < p && p <= s && s - p < q && q <= s + p
);

// PQaアルゴリズム
// 
// |q| = 1 となるまで t = (p + w) / q の連分数展開を行う。
// |q| = 1 とならない場合は `none()` を返す。
// |q| = 1 となったときは、以下のものを返す：
// - 止まったときの無理数 u = (p + w) / q に対応する (p, q)。|q| = 1。
// - t0 = h u （1次分数変換）となるような行列 h = g0 g。ここで g0 は引数で受け取った行列、g は t = g u となる行列。
// 
// はじめから |q| = 1 の場合は、t そのものと g0 を返す。
// 
// # Parameters
// - `d` : 平方数でない正の整数
// - `s` : w = root(d) の整数部分
// - `g0` : 展開の前に掛けておく行列 (i, j, k, l)
// - `pq`: `(p, q)`。 q != 0, q | (d - p^2)
_pqa : [a : Integer] I64 -> I64 -> (a, a, a, a) -> (I64, I64) -> Option ((I64, I64), (a, a, a, a)) = |d, s, g, t| (
    // red は最初に得られた簡約な t。
    // 簡約な2次無理数を連分数展開するといずれ自身に戻ってくるので、
    // t が red に戻ってきたら、展開が巡回し始めたとわかる。
    loop((t, g, none()), |(t, g, red)|
        let (p, q) = t;
        if q.abs == 1 { (t, g).some.break };
        if red.is_some && red.as_some == t { // 以前訪れた簡約な t に戻ったら
            none().break
        };
        let red = if red.is_none && _pqa_reduced(s, t) { t.some } else { red };
        let (a, t) = _pqa_step(d, s, t);
        let g = _pqa_step_g(g, a);
        (t, g, red).continue
    )
);

// 単位行列
_pqa_identity : [a : Integer] (a, a, a, a) = (one, zero, zero, one);

// PQa アルゴリズムを使って、Z[w] の基本単数を求める
// 
// # Parameters
// - `d` : 平方数でない正の整数
// - `s` : w = root(d) の整数部分
// 
// # Returns
// ある基本単数 a + bw に対する (a, b)
_pqa_fundamental_unit : [a : Integer] I64 -> I64 -> (a, a) = |d, s| (
    // t = s + w は簡約で、q = 1 を満たす。よって t の連分数展開は必ず t に戻る。
    // 初めて |q| = 1 となる u = (p + w) / q で終わったとき、t = gu となる g から L(t) = r L(u) <=> Z[w] = r Z[w] となり、r は単数である。
    // さらに、定理より、Z[w] = r Z[w] となるような r はすべて t = s + w の連分数展開から作られるので、
    // 「初めて|q| = 1 となる」のところで止まれば、基本単数が得られる。
    // t 自身が |q| = 1 を満たすので、1 ステップ進めてから `_pqa` に渡す。
    let (a, t) = _pqa_step(d, s, (s, 1));
    let (_, (_, _, k, l)) = _pqa(d, s, _pqa_step_g(_pqa_identity, a), t).as_some;
    // 基本単数は kt + l
    (k * _integer_from_i64(s) + l, k)
);

// `d`が正の平方数でない整数であることを検査し、`floor(root(d))`を返す
//
// # Parameters
// - `name`: エラーメッセージに書く関数名
// - `d`: 検査する整数
_check_pell_d : String -> I64 -> I64 = |name, d| (
    if d <= 0 { undefined("[CPLib.Arithmetic::" + name + "] `d` is not positive") };
    let s = d.u64.isqrt.i64;
    if s * s == d { undefined("[CPLib.Arithmetic::" + name + "] `d` is a square number") };
    s
);

// ペル方程式 x^2 - d y^2 = ±1 の基本解を求める
// 
// 戻り値を e とするとき、解の全体は、符号をのぞき、e^n （nは整数）である。
// ここで、解 (x, y) を実数 x + y root(d) と同一視している。
// 
// 型`a`には、解を表せる大きさの整数の型を指定する。`I64`では、`d`によっては基本解が収まらない（例：d = 526 の基本解は x = 84056091546952933775 で、`I64`の最大値を超える）。
//
// 制約：d > 0、dは平方数でない
//
// 計算量：O(r)回の`a`の演算。r は root(d) の連分数展開の周期の長さで、r = O(root(d) log(d))。
// 
// # Parameters
// - `d` : x^2 - d y^2 = ±1 の d
// 
// # Returns
// x > 0, y > 0 を満たす (x, y)。x + y root(d) は x^2 - d y^2 = ±1 の解のうち 1 より大きい最小のもの。
//
// # Examples
// ```fix
// assert_eq(|_|"", (calc_pell_fundamental_solution(2) : (I64, I64)), (1, 1));; // 1^2 - 2 * 1^2 = -1
// assert_eq(|_|"", (calc_pell_fundamental_solution(7) : (I64, I64)), (8, 3)) // 8^2 - 7 * 3^2 = 1
// ```
calc_pell_fundamental_solution : [a : Integer] I64 -> (a, a) = |d| (
    let s = _check_pell_d("calc_pell_fundamental_solution", d);
    _pqa_fundamental_unit(d, s)
);

// 素数`p`を法とする`a`の平方根を1つ求める（Tonelli–Shanks法）
//
// 平方根がなければ`none()`を返す。
//
// 制約：`p`は素数
//
// 計算量：O(log(p)^2)（平方非剰余を探す部分は期待値）
//
// # Parameters
// - `a`: 整数
// - `p`: 法（素数）
_calc_sqrt_mod_prime : I64 -> I64 -> Option I64 = |a, p| (
    let a = a.pmod(p);
    if a == 0 || p == 2 { a.some };
    if a.pow_mod((p - 1) / 2, p) != 1 { none() };
    if p % 4 == 3 { a.pow_mod((p + 1) / 4, p).some };
    // p - 1 = q 2^s, q は奇数
    let (q, s) = loop((p - 1, 0), |(q, s)|
        if q % 2 != 0 { break $ (q, s) };
        continue $ (q / 2, s + 1)
    );
    let z = count_up(2).filter(|z| z.pow_mod((p - 1) / 2, p) == p - 1).get_first.as_some;
    // 不変条件：r^2 = a t (mod p)、c^(2^(m-1)) = -1、t^(2^(m-1)) = 1
    loop((s, z.pow_mod(q, p), a.pow_mod(q, p), a.pow_mod((q + 1) / 2, p)), |(m, c, t, r)|
        if t == 1 { break $ r.some };
        // t^(2^i) = 1 となる最小の i（0 < i < m）
        let i = loop((1, mul_mod(t, t, p)), |(i, t2)|
            if t2 == 1 { break $ i };
            continue $ (i + 1, mul_mod(t2, t2, p))
        );
        let b = range(0, m - i - 1).fold(c, |_, b| mul_mod(b, b, p));
        let b2 = mul_mod(b, b, p);
        continue $ (i, b2, mul_mod(t, b2, p), mul_mod(r, b, p))
    )
);

// 素数`p`と互いに素な`u`について、`p^k`を法とする`u`の平方根をすべて求める
//
// 制約：`p`は素数、`u`と`p`は互いに素、`k >= 1`
//
// # Parameters
// - `u`: 整数
// - `p`: 素数
// - `k`: 指数
_calc_sqrts_mod_prime_power_unit : I64 -> I64 -> I64 -> Array I64 = |u, p, k| (
    if p == 2 {
        // 2^j を法とする平方根の集合を、j = 1 から順に 2^(j+1) を法とするものへ持ち上げる。集合の大きさは 4 以下。
        range(1, k).fold([1], |j, rs|
            let mj = 1.shift_left(j);
            let mj1 = 2 * mj;
            let u1 = u.pmod(mj1);
            rs.to_iter.flat_map(|r| [r, r + mj].to_iter).filter(|c| mul_mod(c, c, mj1) == u1).to_array
        )
    };
    match _calc_sqrt_mod_prime(u, p) {
        none() => [],
        some(r) => (
            // Hensel の補題で p^j から p^(j+1) へ持ち上げる
            let (r, pk) = range(1, k).fold((r, p), |_, (r, pj)|
                let pj1 = pj * p;
                let f = (mul_mod(r, r, pj1) - u).pmod(pj1);
                let r = (r - mul_mod(f, mul_mod(2, r, pj1).inv_mod(pj1), pj1)).pmod(pj1);
                (r, pj1)
            );
            [r, pk - r]
        )
    }
);

// 素数`p`について、`p^k`を法とする`a`の平方根をすべて求める
//
// 制約：`p`は素数、`k >= 1`
//
// # Parameters
// - `a`: 整数
// - `p`: 素数
// - `k`: 指数
_calc_sqrts_mod_prime_power : I64 -> I64 -> I64 -> Array I64 = |a, p, k| (
    let pk = p.power(k);
    let a = a.pmod(pk);
    // a = 0 なら、z = 0 (mod p^ceil(k/2)) となる z がすべて平方根
    if a == 0 {
        let h = p.power((k + 1) / 2);
        range(0, pk / h).map(|t| t * h).to_array
    };
    // a = p^v u（u と p は互いに素）。v が奇数なら平方根はない。
    let (v, u) = loop((0, a), |(v, u)|
        if u % p != 0 { break $ (v, u) };
        continue $ (v + 1, u / p)
    );
    if v % 2 != 0 { [] };
    // z = p^w y（w = v/2）とおくと y^2 = u (mod p^(k-v))。y は p^(k-w) を法として決まるので、
    // p^(k-v) を法とする根 y0 ごとに y = y0 + p^(k-v) t（0 <= t < p^w）がある。
    let w = v / 2;
    let pw = p.power(w);
    let pkv = p.power(k - v);
    _calc_sqrts_mod_prime_power_unit(u, p, k - v).to_iter.flat_map(|y0|
        range(0, pw).map(|t| pw * (y0 + pkv * t))
    ).to_array
);

// 素因数分解が`factors`である法`m`について、`m`を法とする`a`の平方根をすべて求める
//
// 平方根を`[0, m)`の範囲で返す。`factors`が空（`m = 1`）なら`[0]`を返す。
//
// # Parameters
// - `a`: 整数
// - `factors`: `m`の素因数分解。`(p, k)`の配列で、`p`は相異なる素数、`k >= 1`。
_calc_sqrts_mod_factors : I64 -> Array (I64, I64) -> Array I64 = |a, factors| (
    let (zs, _) = factors.to_iter.fold(([0], 1), |(p, k), (zs, m)|
        let pk = p.power(k);
        let ys = _calc_sqrts_mod_prime_power(a, p, k);
        let zs = zs.to_iter.flat_map(|z| ys.to_iter.map(|y| let (r, _) = lift_crt([z, y], [m, pk]); r)).to_array;
        (zs, m * pk)
    );
    zs
);

// 一般ペル方程式 x^2 - d y^2 = ±m の代表解のリストを求める
// 
// ペル方程式 x^2 - d y^2 = ±1 の基本解を e とする。
// 一般ペル方程式 x^2 - d y^2 = ±m の解は、符号をのぞき、代表解のどれか r から r e^n （nは整数）として一意に得られる。
// ここで、解 (x, y) を実数 x + y root(d) と同一視している。
// 
// 代表解のリストに、ある代表解 x + y root(d) と、その共役 x - y root(d) を単数倍したものの両方が現れることがある。
// これは無駄ではなく、e^n を乗算することですべての解を生成するためには、両方が必要である。
//
// 制約：d > 0、dは平方数でない、m != 0
//
// 計算量：O(|m|^(1/4) log(|m|)^2 + N (log(|m|) + r))回の演算（前の項は期待値）。N は、e^2 が |m| を割り切る e すべてにわたる、z^2 = d (mod |m|/e^2) の解 z の個数の和。
// r は root(d) の連分数展開の周期の長さで、r = O(root(d) log(d))。
// 
// # Parameters
// - `d` : x^2 - d y^2 = ±m の d
// - `m` : x^2 - d y^2 = ±m の m
//
// # Examples
// ```fix
// // x^2 - 2 y^2 = ±7 の解は、3 + root(2) と -3 + root(2) の単数倍
// assert_eq(|_|"", (calc_general_pell_representatives(2, 7) : Array (I64, I64)).sort, [(-3, 1), (3, 1)])
// ```
calc_general_pell_representatives : [a : Integer] I64 -> I64 -> Array (a, a) = |d, m| (
    let s = _check_pell_d("calc_general_pell_representatives", d);
    if m == 0 { undefined("[CPLib.Arithmetic::calc_general_pell_representatives] `m` is zero") };
    let m = m.abs;
    // x, y が互いに素なケースに帰着する：e | x,y なら、(x/e)^2 - d (y/e)^2 = m / (e^2) なので、m / (e^2) ごとに解いて、x, y を e 倍する。
    // m の素因数分解から、e^2 | m となる e と、m / (e^2) の素因数分解の組をすべて作る。
    let cases = m.factorize.to_iter.fold([(1, [])], |(p, k), cases|
        let k = k.i64;
        cases.to_iter.flat_map(|(e, fs)|
            range(0, k / 2 + 1).map(|f|
                let fs = if k - 2 * f > 0 { fs.push_back((p, k - 2 * f)) } else { fs };
                (e * p.power(f), fs)
            )
        ).to_array
    );
    cases.to_iter.flat_map(|(e, fs)|
        let m = fs.to_iter.fold(1, |(p, k), m| m * p.power(k));
        _calc_sqrts_mod_factors(d, fs).to_iter.filter_map(|z|
            let t = (z, m);
            match _pqa(d, s, _pqa_identity, t) {
                none() => none(),
                some((_u, (i, j, k, l))) => (
                    // t = gu, u is integral
                    let z = _integer_from_i64(z);
                    let m = _integer_from_i64(m);
                    let e = _integer_from_i64(e);
                    let x = k*z - m*i;
                    let y = k;
                    (x*e, y*e).some
                )
            }
        )
    ).to_array
);

// 一般ペル方程式 x^2 - d y^2 = ±m の非負の解をすべて列挙するイテレータを作る
//
// x >= 0, y >= 0 を満たす解 (x, y) を、重複なく、すべて列挙する。解が無限にあれば無限に続き、なければ空である。
// 解は大きさの順には並ばない。
//
// 解は指数的に大きくなる。型`a`の範囲を超える大きさの解に達すると、演算がオーバーフローする。
// `I64`では、オーバーフローした値が出るか、`--check-integer-operations`を付けてビルドしたときはプログラムが止まる。
// 範囲を超える解まで列挙したいときは、多倍長整数の型（gmp-fix の`MPZ`など）を使う。
//
// 制約：d > 0、dは平方数でない、m != 0
//
// 計算量：最初の要素を得るまでに、`calc_general_pell_representatives`と`calc_pell_fundamental_solution`の計算。
// その後は、1要素あたり、代表解の個数に比例する回数の`a`の演算（ならし）。
//
// # Parameters
// - `d` : x^2 - d y^2 = ±m の d
// - `m` : x^2 - d y^2 = ±m の m
//
// # Examples
// ```fix
// let sols : Array (I64, I64) = iterate_general_pell_solutions(2, 7).take(4).to_array;
// assert(|_|"", sols.to_iter.check_all(|(x, y)| (x * x - 2 * y * y).abs == 7))
// ```
iterate_general_pell_solutions : [?it : Iterator, Item ?it = (a, a), a : Integer] I64 -> I64 -> ?it = |d, m| (
    let d_a = _integer_from_i64(d);
    let multiply = |(x, y), (a, b)| (x*a + d_a*y*b, x*b + a*y);
    let normalize = |(x, y)| (
        let x = if x < zero { -x } else { x };
        let y = if y < zero { -y } else { y };
        (x, y)
    );

    let rs = calc_general_pell_representatives(d, m);
    if rs.is_empty { [].to_iter.to_dyn };
    let e0 = calc_pell_fundamental_solution(d);
    let e1 = let (x, y) = e0; let s = x*x - d_a*y*y; (s*x, -s*y);
    
    let es = generate((e0, e1), |(e0n, e1n)|
        let out = [e0n, e1n].to_iter;    
        let state = (e0n.multiply(e0), e1n.multiply(e1));
        (state, out).some
    ).flatten.push_front((one, zero));

    es.flat_map(|e|
        rs.to_iter.filter_map(|r|
            let xy = e.multiply(r);
            let (x, y) = xy;
            // x, y の符号が異なるものは、列挙したい解の共役なので除く（x * y は I64 で溢れうるので、符号で比べる）
            if (x < zero && y > zero) || (x > zero && y < zero) { none() };
            xy.normalize.some
        )
    ).to_dyn
);