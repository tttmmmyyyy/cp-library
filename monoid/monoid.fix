// セグメント木でよく使うモノイドと作用を提供するモジュール。
//
// 値のモノイドは`Sum`、`Product`、`Min`、`Max`、`WeightedSum`、作用は`RangeAdd`、`RangeAssign`、`RangeAffine`です。
// 値はフィールド`v`に入れ、`Max { v }`で作り`x.@v`で読みます。
//
// 作用の型は、作用を受けるモノイドの型コンストラクタを最初の型引数に取ります。たとえば`Max I64`への区間加算は`RangeAdd Max I64`です。
// 用意している組み合わせは次の通りです。
//
// | 作用 | `Min` / `Max` | `WeightedSum` |
// | --- | --- | --- |
// | `RangeAdd` | 値に足す | 和に「足す値 * 重みの和」を足す |
// | `RangeAssign` | 値を置き換える | 和を「代入する値 * 重みの和」にする |
// | `RangeAffine` | なし | 和を「`b` * 和 + `c` * 重みの和」にする |
//
// 自分の型と名前がぶつかるときは、`Monoid::Max`のように名前空間を付けて書きます。
//
// ```fix
// # module DocTest;
// import CPLib.LSegtree;
// import CPLib.Monoid;
// # main : IO () = (
// // 区間への加算と、区間の最大値の取得ができるセグメント木
// let tree = build([1, 2, 3].map(|v| Monoid::Max { v })) : LSegtree (Monoid::Max I64) (RangeAdd Monoid::Max I64);
// let tree = tree.act_range(0, 2, RangeAdd { v : 10 }); // [11, 12, 3]
// let (_, res) = tree.fold(1, 3);
// assert_eq(|_|"", res.@v, 12)
// # );
// ```
module CPLib.Monoid;

import CPLib.Trait::{Action, Inf, Monoid, NegInf, Action::{act, Set}, Inf::inf, Monoid::{op, unit}, NegInf::neg_inf};
import Std::{
    Add, LessThan, Mul, One, Option, Zero, LessThan::{max, min}, One::one, Option::{is_some, none, some},
    Zero::zero
};

// 和のモノイド
//
// 区間に作用させる和には`WeightedSum`を使います。
type Sum a = struct { v : a };

impl [a : Zero, a : Add] Sum a : Monoid {
    unit = Sum { v : zero };
    op = |x, y| Sum { v : x.@v + y.@v };
}

// 積のモノイド
type Product a = struct { v : a };

impl [a : One, a : Mul] Product a : Monoid {
    unit = Product { v : one };
    op = |x, y| Product { v : x.@v * y.@v };
}

// 最小値のモノイド
//
// 単位元は`inf`です。
type Min a = struct { v : a };

impl [a : LessThan, a : Inf] Min a : Monoid {
    unit = Min { v : inf };
    op = |x, y| Min { v : min(x.@v, y.@v) };
}

// 最大値のモノイド
//
// 単位元は`neg_inf`です。
type Max a = struct { v : a };

impl [a : LessThan, a : NegInf] Max a : Monoid {
    unit = Max { v : neg_inf };
    op = |x, y| Max { v : max(x.@v, y.@v) };
}

// 重みつきの和のモノイド
//
// 区間に作用させる`RangeAdd`、`RangeAssign`、`RangeAffine`は、和の変化を求めるのに重みの和を使います。
// 葉を`make`で作ると重みは1になり、`weight`は区間の要素数になります。
// 木は`make`で作った葉から`build`で作るか、`init`の後に`set`で葉を入れてください。`init`の要素は重みが0で、作用を受けても変わりません。
//
// 重みに1以外を使うこともできます。要素`i`の葉を`WeightedSum { v : d * w, weight : w }`（`d`は`i`桁目の数字、`w`は`10^(n-1-i)`）にすれば、`v`は数字の列を10進数として読んだ値になります。
type WeightedSum a = struct {
    // 値と重みの積の和
    v : a,
    // 重みの和
    weight : a
};

namespace WeightedSum {
    // 重みが1の葉を作る
    //
    // # Parameters
    // - `v` : 要素の値
    make : [a : One] a -> WeightedSum a;
    make = |v| WeightedSum { v, weight : one };
}

impl [a : Zero, a : Add] WeightedSum a : Monoid {
    unit = WeightedSum { v : zero, weight : zero };
    op = |x, y| WeightedSum { v : x.@v + y.@v, weight : x.@weight + y.@weight };
}

// 区間加算の作用
//
// `f`は作用を受けるモノイドの型コンストラクタ（`Min`、`Max`、`WeightedSum`）、`a`は要素の型です。
//
// 区間加算は`Min`の`inf`と`Max`の`neg_inf`にも足します。
// `init`で作った要素の値はこれらなので、区間加算をする要素には先に`set`か`build`で値を入れてください。
type [f : * -> *] RangeAdd f a = struct { v : a };

impl [f : * -> *, a : Zero, a : Add] RangeAdd f a : Monoid {
    unit = RangeAdd { v : zero };
    op = |x, y| RangeAdd { v : x.@v + y.@v };
}

impl [a : Add] RangeAdd Min a : Action {
    type Set (RangeAdd Min a) = Min a;
    act = |a, x| Min { v : x.@v + a.@v };
}

impl [a : Add] RangeAdd Max a : Action {
    type Set (RangeAdd Max a) = Max a;
    act = |a, x| Max { v : x.@v + a.@v };
}

impl [a : Add, a : Mul] RangeAdd WeightedSum a : Action {
    type Set (RangeAdd WeightedSum a) = WeightedSum a;
    act = |a, x| WeightedSum { v : x.@v + a.@v * x.@weight, weight : x.@weight };
}

// 区間代入の作用
//
// `f`は作用を受けるモノイドの型コンストラクタ（`Min`、`Max`、`WeightedSum`）、`a`は要素の型です。
// `v`が`none()`のときは何もしません。
type [f : * -> *] RangeAssign f a = struct { v : Option a };

namespace RangeAssign {
    // 値`v`を代入する作用を作る
    //
    // # Parameters
    // - `v` : 代入する値
    make : [f : * -> *] a -> RangeAssign f a;
    make = |v| RangeAssign { v : some(v) };
}

impl [f : * -> *] RangeAssign f a : Monoid {
    unit = RangeAssign { v : none() };
    op = |x, y| if y.@v.is_some { y } else { x };
}

impl RangeAssign Min a : Action {
    type Set (RangeAssign Min a) = Min a;
    act = |a, x| match a.@v { some(v) => Min { v }, none(_) => x };
}

impl RangeAssign Max a : Action {
    type Set (RangeAssign Max a) = Max a;
    act = |a, x| match a.@v { some(v) => Max { v }, none(_) => x };
}

impl [a : Mul] RangeAssign WeightedSum a : Action {
    type Set (RangeAssign WeightedSum a) = WeightedSum a;
    act = |a, x| match a.@v { some(v) => WeightedSum { v : v * x.@weight, weight : x.@weight }, none(_) => x };
}

// アフィン変換`x -> b * x + c`の作用
//
// `f`は作用を受けるモノイドの型コンストラクタ（`WeightedSum`）、`a`は要素の型です。
type [f : * -> *] RangeAffine f a = struct { b : a, c : a };

impl [f : * -> *, a : Zero, a : One, a : Add, a : Mul] RangeAffine f a : Monoid {
    unit = RangeAffine { b : one, c : zero };
    op = |x, y| RangeAffine { b : x.@b * y.@b, c : x.@c * y.@b + y.@c };
}

impl [a : Add, a : Mul] RangeAffine WeightedSum a : Action {
    type Set (RangeAffine WeightedSum a) = WeightedSum a;
    act = |a, x| WeightedSum { v : a.@b * x.@v + a.@c * x.@weight, weight : x.@weight };
}
