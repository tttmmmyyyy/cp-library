module CPLib.TwoSat.Test;

import CPLib.TwoSat::{add_clause, create, solve};
import Random::{generate_I64_nonneg, init_by_seed};
import EZS::{cd, run_o, run_wi_oec, Context::default};
import Std::{
    Array, Bool, I64, IO, Array::{push_back, to_iter, @}, Debug::{assert, assert_eq}, Functor::forget, I64::{bit_and, shift_left, shift_right},
    Iterator::{fold, fold_m, range}, Monad::pure, Option::{as_some, is_none, is_some},
    String::find, ToString::to_string
};

// https://atcoder.jp/contests/language-test-202505/submissions/68186286

test : IO ();
test = (
    test_basic;;
    test_long_chain;;
    test_random;;
    test_out_of_range;;
    pure()
);

// x_0 ならば x_1、x_1 ならば x_2、... という長い鎖。頂点数に比例する深さで再帰する実装は、既定のスタックで溢れる
test_long_chain : IO ();
test_long_chain = (
    let n = 200000;
    let sat = range(0, n - 1).fold(TwoSat::create(n), |i, sat| sat.add_clause(i, false, i + 1, true));
    let sat = sat.add_clause(0, true, 0, true); // x_0 を真にする
    let ans = sat.solve;
    assert(|_|"test_long_chain satisfiable", ans.is_some);;
    let ans = ans.as_some;
    assert(|_|"test_long_chain all true", range(0, n).fold(true, |i, ok| ok && ans.@(i)));;
    pure()
);

test_basic : IO ();
test_basic = (
    // https://drken1215.hatenablog.com/entry/2023/05/07/001800
    let problem = TwoSat::create(4);
    let problem = problem.add_clause(0, false, 1, true); // 0 -> 1
    let problem = problem.add_clause(0, true, 2, false); // -0 -> -2
    let problem = problem.add_clause(0, true, 3, false); // -0 -> -3
    let problem = problem.add_clause(1, false, 2, false); // 1 -> -2
    let problem = problem.add_clause(1, true, 0, false); // -1 -> -0
    let problem = problem.add_clause(1, true, 3, true); // -1 -> 3
    let problem = problem.add_clause(2, false, 0, true); // 2 -> 0
    let problem = problem.add_clause(2, false, 1, false); // 2 -> -1
    let problem = problem.add_clause(2, true, 3, false); // -2 -> -3
    let problem = problem.add_clause(3, false, 0, true); // 3 -> 0
    let problem = problem.add_clause(3, false, 2, true); // 3 -> 2
    let problem = problem.add_clause(3, true, 1, true); // -3 -> 1
    let sol = problem.solve;
    assert_eq(|_|"[2sat test_basic]", sol.as_some, [true, true, false, false]);;

    let problem = problem.add_clause(1, false, 3, true); // 1 -> 3
    let sol = problem.solve;
    assert(|_|"[2sat test_basic]", sol.is_none);;
    pure()
);

// 小さな乱択の問題で、充足可能かを全割り当ての総当たりと比べ、返った割り当てがすべての節を満たすことを確かめる
test_random : IO ();
test_random = (
    let rng = Random::init_by_seed(0_U64);
    range(0, 2000).fold_m(rng, |_, rng|
        let (rng, n) = rng.generate_I64_nonneg;
        let n = n % 6 + 1;
        let (rng, m) = rng.generate_I64_nonneg;
        let m = m % (3 * n + 1);
        // 節 (a = f) or (b = g) を (a, f, b, g) で表す
        let (clauses, rng) = range(0, m).fold(([], rng), |_, (clauses, rng)|
            let (rng, a) = rng.generate_I64_nonneg;
            let (rng, f) = rng.generate_I64_nonneg;
            let (rng, b) = rng.generate_I64_nonneg;
            let (rng, g) = rng.generate_I64_nonneg;
            (clauses.push_back((a % n, f % 2 == 1, b % n, g % 2 == 1)), rng)
        );
        let sat = clauses.to_iter.fold(TwoSat::create(n), |(a, f, b, g), sat| sat.add_clause(a, f, b, g));
        // 割り当てxが節をすべて満たすか
        let satisfies = |x : I64 -> Bool| clauses.to_iter.fold(true, |(a, f, b, g), ok| ok && (x(a) == f || x(b) == g));
        // ビット列sで、変数iにsのiビット目を割り当てる
        let brute = range(0, 1.shift_left(n)).fold(false, |s, found| found || satisfies(|i| s.shift_right(i).bit_and(1) == 1));
        let ans = sat.solve;
        assert_eq(|_|"test_random satisfiable", ans.is_some, brute);;
        if ans.is_some {
            let ans = ans.as_some;
            assert(|_|"test_random assignment", satisfies(|i| ans.@(i)))
        } else { pure() };;
        rng.pure
    ).forget
);

// 変数の番号が範囲外の節を足すと、n以上2n未満の番号でも負の番号でも、`add_clause`が理由を書いて止まる
test_out_of_range : IO ();
test_out_of_range = (
    let ezs = EZS::Context::default;
    ezs.cd("twosat/out-of-range");;
    ezs.run_o(["fix", "deps", "update"]);;
    range(0, 2).fold_m((), |case, _|
        let (_, err, code) = *ezs.run_wi_oec(["fix", "run", "--allow-preliminary-commands"], case.to_string);
        assert_eq(|_|"out of range " + case.to_string + ": " + err, code != 0_U8 && err.find("[CPLib.TwoSat::add_clause] `a` or `b` is out of [0, n)", 0).is_some, true)
    );;
    let (out, _, code) = *ezs.run_wi_oec(["fix", "run", "--allow-preliminary-commands"], "2");
    assert_eq(|_|"in range: " + out, code == 0_U8 && out.find("some([true, true])", 0).is_some, true);;
    // 後のテストのために、作業ディレクトリをライブラリのルートに戻す
    ezs.cd("../..")
);
